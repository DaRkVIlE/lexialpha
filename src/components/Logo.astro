---
// src/components/Logo.astro
// Monograma tipográfico técnico LexiQuest com onda sonora vetorial
interface Props {
  class?: string;
  showBadge?: boolean;
}

const { class: className = '', showBadge = true } = Astro.props;
---

<div class={`inline-flex items-center gap-3 select-none ${className}`}>
  <!-- Simbolo Vetorial + Frequencia de Voz -->
  <div class="relative flex items-center justify-center w-9 h-9 rounded-xl bg-[#271d40] border border-[#3b2c60] shadow-inner group">
    <svg class="w-5 h-5 text-[#c2ef4e] transition-transform duration-300 group-hover:scale-105" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Letra L geométrica moderna -->
      <path d="M8 8V24H24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <!-- Barras verticais da onda sonora integradas -->
      <path d="M14 14V20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <path d="M18 10V22" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
      <path d="M22 13V18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <div class="absolute -bottom-0.5 inset-x-2 h-px bg-gradient-to-r from-transparent via-[#c2ef4e]/50 to-transparent"></div>
  </div>

  <!-- Naming -->
  <div class="flex items-center gap-2.5">
    <span class="text-[#ffffff] font-bold text-lg tracking-tight hover:text-[#c2ef4e] transition-colors">
      LexiQuest
    </span>
    {showBadge && (
      <span class="text-[10px] uppercase font-mono font-semibold px-2 py-0.5 rounded-full bg-[#c2ef4e]/10 text-[#c2ef4e] border border-[#c2ef4e]/25">
        Alpha
      </span>
    )}
  </div>
</div>
