---
// src/components/Pricing.astro — Redesign Editorial Datamind Style
// Oferta Turma Alpha: Mensalidade de entrada R$ 197/mês • 10 vagas • Sem fidelidade
// Tipografia Cormorant editorial, mouse parallax sutil e layout refinado sem cards genéricos.
---

<section id="pricing" class="py-32 px-4 sm:px-8 relative border-t border-[#1a1a1a] overflow-hidden">
  <!-- Glow central -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-[#3ecf8e]/6 rounded-full blur-[200px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <!-- Header Editorial -->
    <div class="text-center mb-20 max-w-3xl mx-auto" data-anim="fade-up">
      <span class="text-xs font-mono text-[#3ecf8e] uppercase tracking-[0.2em]">Apenas 10 Vagas na Turma Alpha</span>
      <h2 class="font-editorial text-5xl sm:text-6xl md:text-7xl font-light tracking-tight leading-[1.02] mt-4 text-[#fafafa]">
        Aulas com o Professor Gabe<br />
        <span class="font-editorial italic text-gradient-emerald">+ IA diária no portal.</span>
      </h2>
      <p class="text-base sm:text-lg text-[#898989] leading-relaxed mt-6 max-w-2xl mx-auto">
        Um modelo direto e acessível para você começar a falar inglês imediatamente, sem contratos de longo prazo e sem burocracia.
      </p>
    </div>

    <!-- Card de Oferta Estilo Datamind com Micro-Parallax -->
    <div id="pricing-card-wrapper" class="max-w-2xl mx-auto" data-anim="fade-up">
      <div
        id="pricing-card"
        class="rounded-3xl bg-[#141414]/95 border border-[#2e2e2e] p-8 sm:p-12 shadow-2xl relative overflow-hidden transition-all duration-300 hover:border-[#3ecf8e]/40"
      >
        <!-- Eyebrow do Card -->
        <div class="flex items-center justify-between pb-8 border-b border-[#1f1f1f]">
          <div class="flex items-center gap-2 text-xs font-mono text-[#3ecf8e]">
            <span class="w-2 h-2 rounded-full bg-[#3ecf8e] animate-pulse"></span>
            <span class="uppercase tracking-widest font-semibold">Turma Alpha Exclusiva</span>
          </div>
          <span class="text-xs font-mono text-[#898989] uppercase tracking-wider">
            10 vagas abertas
          </span>
        </div>

        <!-- Preço Editorial Gigante -->
        <div class="py-10 text-center">
          <p class="text-xs font-mono text-[#898989] uppercase tracking-widest mb-3">Mensalidade de Entrada</p>
          <div class="flex items-baseline justify-center gap-2">
            <span class="font-editorial text-3xl sm:text-4xl text-[#fafafa] font-light">R$</span>
            <span class="font-editorial text-[90px] sm:text-[110px] font-light text-gradient-emerald leading-none select-none counter-value">197</span>
            <span class="text-[#898989] text-base font-mono">/mês</span>
          </div>
          <p class="text-xs sm:text-sm text-[#898989] mt-3">
            Sem taxa de matrícula &bull; Sem fidelidade de 1 ano &bull; Cancele quando quiser
          </p>
        </div>

        <!-- Lista de Benefícios com Separadores Editorial -->
        <div class="pt-6 border-t border-[#1f1f1f] mb-10">
          <h3 class="text-xs font-mono uppercase tracking-widest text-[#898989] mb-6">O Que Está Incluso:</h3>
          <ul class="space-y-4">
            {[
              "2 sessões semanais rápidas de alinhamento e destravamento com o Gabe (100% individuais)",
              "1 sessão semanal estendida focada em conversação plena e situações reais (100% individual)",
              "Acesso 24/7 ao Tutor de IA Lexi Alpha no Portal Web dedicado (mínimo de 15 min diários)",
              "Diagnóstico contínuo das suas travas reais para guiar os encontros",
              "Acompanhamento direto e suporte pelo WhatsApp pessoal do professor",
              "Garantia incondicional de 30 dias: devolução integral via Pix se o método não for para você"
            ].map((item) => (
              <li class="flex items-start gap-3.5 border-t border-[#1a1a1a] pt-3.5 text-sm sm:text-base text-[#d4d4d8]">
                <div class="w-5 h-5 rounded-full bg-[#3ecf8e]/10 text-[#3ecf8e] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- CTA Principal Slide Button -->
        <a
          href="https://wa.me/5511967239791?text=Oi%20Gabe!%20Quero%20garantir%20minha%20vaga%20na%20Turma%20Alpha%20por%20R$%20197/m%C3%AAs"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-slide block w-full py-4 text-center rounded-full bg-[#3ecf8e] text-[#0f0f0f] font-bold text-base hover:bg-[#34b27b] active:scale-98 transition-all shadow-xl shadow-[#3ecf8e]/20"
        >
          <span class="btn-text-top">Garantir Minha Vaga no WhatsApp &rarr;</span>
          <span class="btn-text-bottom">Conversar Diretamente com o Gabe &rarr;</span>
        </a>

        <!-- Garantia Micro-copy -->
        <div class="mt-6 flex items-center justify-center gap-2.5 text-[#898989] text-xs text-center">
          <svg class="w-4 h-4 text-[#3ecf8e] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Garantia de 30 dias. Se sentir que o método não é para você, devolvo 100% via Pix.</span>
        </div>
      </div>
    </div>

    <!-- Limite de Vagas -->
    <div class="mt-12 text-center" data-anim="fade-up">
      <p class="text-xs font-mono text-[#898989]">
        <span class="text-[#3ecf8e] font-bold">10 vagas estritas</span> para assegurar acompanhamento pessoal 1 a 1.
      </p>
    </div>
  </div>
</section>

<!-- Micro-interação 3D tilt no card -->
<script is:inline>
  (function initPricingTilt() {
    const card = document.getElementById('pricing-card');
    if (!card) return;

    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -3;
      const rotateY = ((x - centerX) / centerX) * 3;

      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-2px)`;
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
    });
  })();
</script>
