---
// src/components/Pricing.astro — Seção 6: A Oferta da Turma Alpha (03.6)
// Transparência Total: 15 Vagas Fundadoras · R$ 197/mês vs Regular R$ 297/mês · Pix Manual
---

<section id="pricing" class="py-24 sm:py-28 px-4 sm:px-8 relative border-t border-[#2e224d] overflow-hidden">
  <!-- Glow central Lime + Purple -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-[#c2ef4e]/5 rounded-full blur-[200px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto relative z-10 w-full">
    <!-- Header Oficial (03.6) -->
    <div class="text-center mb-16 max-w-3xl mx-auto" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e] micro-pulse"></span>
        <span class="text-xs font-mono text-[#c2ef4e] uppercase tracking-[0.2em]">Escassez Real · Apenas 15 Vagas Fundadoras</span>
      </div>
      <h2 class="font-sans font-extrabold text-3xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05] mt-2 text-[#ffffff]">
        Condição Exclusiva de Lançamento:<br />
        <span class="text-gradient-lime">A Oferta da Turma Alpha.</span>
      </h2>
      <p class="text-base sm:text-lg text-[#cfcfdb] leading-relaxed mt-4 max-w-2xl mx-auto">
        Tudo o que você precisa para parar de traduzir e destravar sua fala em inglês em 30 dias. Sem contratos longos ou taxa de matrícula.
      </p>
    </div>

    <!-- Card de Oferta Aether Luxury -->
    <div id="pricing-card-wrapper" class="max-w-2xl mx-auto" data-anim="fade-up">

      <!-- Timeline Visual de Evolução -->
      <div class="mb-6 rounded-2xl bg-[#1f1633] border border-[#3b2c60] p-5" aria-hidden="true">
        <div class="text-[10px] font-mono text-[#cfcfdb] uppercase tracking-[0.18em] mb-4 text-center">Progressão típica nos primeiros 30 a 90 dias</div>
        <div class="relative">
          <div class="absolute top-5 left-0 right-0 h-0.5 bg-[#3b2c60]"></div>
          <div class="flex justify-between relative z-10">
            <!-- Sem 1 -->
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-10 h-10 rounded-full border border-[#c2ef4e] bg-[#271d40] flex items-center justify-center text-[#c2ef4e] font-mono text-xs font-bold">
                01
              </div>
              <span class="text-[10px] font-mono text-[#cfcfdb]">Semana 1</span>
              <span class="text-[10px] font-mono font-bold text-[#c2ef4e]">Descongela</span>
            </div>
            <!-- Sem 3 -->
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-10 h-10 rounded-full border border-[#6a5fc1] bg-[#271d40] flex items-center justify-center text-[#6a5fc1] font-mono text-xs font-bold">
                03
              </div>
              <span class="text-[10px] font-mono text-[#cfcfdb]">Semana 3</span>
              <span class="text-[10px] font-mono font-bold text-[#6a5fc1]">Flui</span>
            </div>
            <!-- Sem 6 -->
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-10 h-10 rounded-full border border-[#fa7faa] bg-[#271d40] flex items-center justify-center text-[#fa7faa] font-mono text-xs font-bold">
                06
              </div>
              <span class="text-[10px] font-mono text-[#cfcfdb]">Semana 6</span>
              <span class="text-[10px] font-mono font-bold text-[#fa7faa]">Acelera</span>
            </div>
            <!-- Sem 12 -->
            <div class="flex flex-col items-center gap-1.5">
              <div class="w-10 h-10 rounded-full border border-[#c2ef4e] bg-[#271d40] flex items-center justify-center text-[#c2ef4e] font-mono text-xs font-bold shadow-md shadow-[#c2ef4e]/20">
                12
              </div>
              <span class="text-[10px] font-mono text-[#cfcfdb]">Semana 12</span>
              <span class="text-[10px] font-mono font-bold text-[#c2ef4e]">B2 Real</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Central de Preço -->
      <div
        id="pricing-card"
        class="rounded-3xl bg-[#271d40] border border-[#3b2c60] p-8 sm:p-12 shadow-2xl relative overflow-hidden"
