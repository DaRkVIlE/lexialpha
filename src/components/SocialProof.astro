---
// src/components/SocialProof.astro — Metricas + Pilares com SVG do ciclo SPARK
---

<section class="py-32 px-4 sm:px-8 relative border-t border-[#1a1a1a] overflow-hidden">
  <!-- Linha decorativa topo -->
  <div class="absolute top-0 left-0 right-0 h-px overflow-hidden">
    <div id="sp-line" class="line-decor h-full w-full"></div>
  </div>

  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-20" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e] micro-pulse"></span>
        <span class="text-xs font-mono text-[#898989] uppercase tracking-[0.2em]">A Logica da Aquisicao Natural</span>
      </div>
      <h2 class="font-sans font-extrabold text-4xl sm:text-5xl md:text-6xl tracking-tight mt-2 text-[#fafafa] leading-[1.08]">
        Por que voce finalmente destrava<br class="hidden sm:block" />
        <span class="text-gradient-emerald">com este metodo</span>
      </h2>
    </div>

    <!-- 4 Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-16" data-anim="fade-up">
      <!-- Stat 1 -->
      <div class="topic-card text-center p-6 sm:p-8 rounded-2xl bg-[#121212] border border-[#242424] flex flex-col justify-between">
        <div>
          <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl leading-none text-gradient-emerald counter-value mb-2 tracking-tight">
            <span class="sp-counter" data-target="15">0</span><span class="text-2xl sm:text-3xl font-extrabold">min</span>
          </div>
          <div class="w-12 h-1 bg-[#3ecf8e]/20 rounded-full mx-auto my-3 overflow-hidden">
            <div class="h-full bg-[#3ecf8e] w-full rounded-full"></div>
          </div>
          <p class="text-xs font-mono text-[#fafafa] uppercase tracking-wider font-semibold mb-1">Minimo Diario</p>
        </div>
        <p class="text-[#71717a] text-xs leading-relaxed hidden sm:block mt-2">O chao para criar consistencia. Pratique mais quando quiser.</p>
      </div>

      <!-- Stat 2 -->
      <div class="topic-card text-center p-6 sm:p-8 rounded-2xl bg-[#121212] border border-[#242424] flex flex-col justify-between">
        <div>
          <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl leading-none text-gradient-emerald counter-value mb-2 tracking-tight">
            <span class="sp-counter" data-target="3">0</span><span class="text-2xl sm:text-3xl font-extrabold">x</span>
          </div>
          <div class="w-12 h-1 bg-[#3ecf8e]/20 rounded-full mx-auto my-3 overflow-hidden">
            <div class="h-full bg-[#3ecf8e] w-full rounded-full"></div>
          </div>
          <p class="text-xs font-mono text-[#fafafa] uppercase tracking-wider font-semibold mb-1">Encontros / Sem.</p>
        </div>
        <p class="text-[#71717a] text-xs leading-relaxed hidden sm:block mt-2">2 rapidas de ajuste + 1 estendida de conversacao individual.</p>
      </div>

      <!-- Stat 3 -->
      <div class="topic-card text-center p-6 sm:p-8 rounded-2xl bg-[#121212] border border-[#242424] flex flex-col justify-between">
        <div>
          <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl leading-none text-gradient-emerald counter-value mb-2 tracking-tight">
            <span class="sp-counter" data-target="24">0</span><span class="text-2xl sm:text-3xl font-extrabold">/7</span>
          </div>
          <div class="w-12 h-1 bg-[#3ecf8e]/20 rounded-full mx-auto my-3 overflow-hidden">
            <div class="h-full bg-[#3ecf8e] w-full rounded-full"></div>
          </div>
          <p class="text-xs font-mono text-[#fafafa] uppercase tracking-wider font-semibold mb-1">SPARK Alpha</p>
        </div>
        <p class="text-[#71717a] text-xs leading-relaxed hidden sm:block mt-2">Seu tutor dedicado para praticar a qualquer hora do dia.</p>
      </div>

      <!-- Stat 4 -->
      <div class="topic-card text-center p-6 sm:p-8 rounded-2xl bg-[#121212] border border-[#242424] flex flex-col justify-between">
        <div>
          <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl leading-none text-gradient-emerald counter-value mb-2 tracking-tight">
            <span class="sp-counter" data-target="100">0</span><span class="text-2xl sm:text-3xl font-extrabold">%</span>
          </div>
          <div class="w-12 h-1 bg-[#3ecf8e]/20 rounded-full mx-auto my-3 overflow-hidden">
            <div class="h-full bg-[#3ecf8e] w-full rounded-full"></div>
          </div>
          <p class="text-xs font-mono text-[#fafafa] uppercase tracking-wider font-semibold mb-1">Individual</p>
        </div>
        <p class="text-[#71717a] text-xs leading-relaxed hidden sm:block mt-2">Zero alunos dividindo atencao. O tempo todo e focado em voce.</p>
      </div>
    </div>

    <!-- SVG: Ciclo SPARK -->
    <div class="mb-16" data-anim="fade-up" aria-hidden="true">
      <svg viewBox="0 0 680 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-2xl mx-auto opacity-70">
        <!-- Node circles -->
        <circle cx="80" cy="50" r="22" fill="#3ecf8e" fill-opacity="0.08" stroke="#3ecf8e" stroke-opacity="0.5" stroke-width="1.5"/>
        <circle cx="216" cy="50" r="22" fill="#3ecf8e" fill-opacity="0.08" stroke="#3ecf8e" stroke-opacity="0.5" stroke-width="1.5"/>
        <circle cx="340" cy="50" r="22" fill="#3ecf8e" fill-opacity="0.08" stroke="#3ecf8e" stroke-opacity="0.5" stroke-width="1.5"/>
        <circle cx="464" cy="50" r="22" fill="#3ecf8e" fill-opacity="0.08" stroke="#3ecf8e" stroke-opacity="0.5" stroke-width="1.5"/>
        <circle cx="600" cy="50" r="22" fill="#3ecf8e" fill-opacity="0.1" stroke="#3ecf8e" stroke-opacity="0.7" stroke-width="1.5"/>

        <!-- Node letters -->
        <text x="80" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#3ecf8e" font-weight="600">S</text>
        <text x="216" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#3ecf8e" font-weight="600">P</text>
        <text x="340" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#3ecf8e" font-weight="600">A</text>
        <text x="464" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#3ecf8e" font-weight="600">R</text>
        <text x="600" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#3ecf8e" font-weight="700">K</text>

        <!-- Arrows between nodes -->
        <path d="M103 50 L191 50" stroke="#3ecf8e" stroke-opacity="0.35" stroke-width="1.2" marker-end="url(#sp-arr)"/>
        <path d="M239 50 L315 50" stroke="#3ecf8e" stroke-opacity="0.35" stroke-width="1.2" marker-end="url(#sp-arr)"/>
        <path d="M363 50 L439 50" stroke="#3ecf8e" stroke-opacity="0.35" stroke-width="1.2" marker-end="url(#sp-arr)"/>
        <path d="M487 50 L575 50" stroke="#3ecf8e" stroke-opacity="0.35" stroke-width="1.2" marker-end="url(#sp-arr)"/>
        <!-- Return arc from K back to S -->
        <path d="M600 28 Q340 -18 80 28" stroke="#3ecf8e" stroke-opacity="0.2" stroke-width="1" fill="none" stroke-dasharray="4 3"/>

        <!-- Labels below -->
        <text x="80" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#828294">Pratica</text>
        <text x="216" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#828294">Producao</text>
        <text x="340" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#828294">Feedback IA</text>
        <text x="464" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#828294">Simulacao</text>
        <text x="600" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#3ecf8e" fill-opacity="0.7">Turma Alpha</text>

        <defs>
          <marker id="sp-arr" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto">
            <path d="M0,0 L0,6 L6,3 z" fill="#3ecf8e" fill-opacity="0.4"/>
          </marker>
        </defs>
      </svg>
    </div>

    <!-- 4 Pilares de Aquisicao -->
    <div class="grid md:grid-cols-2 gap-6" data-anim="fade-up">
      {[
        {
          n: '01',
          badge: 'Reflexo Motor',
          title: 'O Fim do Vicio da Traducao Mental',
          text: 'No metodo tradicional, voce monta a frase em portugues antes de falar. Com o SPARK, voce treina blocos de fala prontos em situacoes reais ate que a resposta saia sem pensar, como acontece na sua lingua materna.'
        },
        {
          n: '02',
          badge: 'Zero Julgamento',
          title: 'Ambiente Seguro para Errar Sem Vergonha',
          text: 'A vergonha de errar em publico e o principal motivo de travamento. No PlayApp SPARK Alpha, voce pratica sozinho, sem julgamento, ate ganhar confianca para as sessoes ao vivo.'
        },
        {
          n: '03',
          badge: 'Aquisicao Natural',
          title: 'Correcao Natural sem Interrupcoes Bloqueantes',
          text: 'Correcao gramatical explicita ativa bloqueio. Tanto a IA quanto o Gabe devolvem sua frase refeita de forma natural, dentro da conversa, sem interromper e sem caneta vermelha.'
        },
        {
          n: '04',
          badge: 'Improviso Real',
          title: 'Aplicacao Real e Improviso com o Professor',
          text: 'O treino diario cria o repertorio. Os encontros semanais com o Gabe colocam esse repertorio a prova em situacoes que a IA nao replica: improviso real, pressao, nuances de tom.'
        }
      ].map((item) => (
        <div class="topic-card p-6 sm:p-7 rounded-2xl bg-[#121212] border border-[#242424] flex items-start gap-5">
          <span class="font-sans font-black text-3xl sm:text-4xl text-gradient-emerald select-none leading-none shrink-0 tracking-tight">{item.n}</span>
          <div class="space-y-2 flex-1">
            <div class="flex items-center justify-between gap-2">
              <h4 class="font-bold text-[#fafafa] text-base tracking-tight">{item.title}</h4>
              <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/20 bg-[#3ecf8e]/10 text-[10px]">{item.badge}</span>
            </div>
            <p class="text-[#898989] text-sm leading-relaxed">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ready(fn) {
    if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn);
  }
  ready(function () {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap || !ST) return;

    gsap.to('#sp-line', {
      scaleX: 1, duration: 1.5, ease: 'power2.inOut',
      scrollTrigger: { trigger: 'section', start: 'top 85%' }
    });

    if (!reduced) {
      gsap.from('[data-anim="fade-up"]', {
        y: 40, opacity: 0, duration: 0.85, stagger: 0.1, ease: 'power3.out',
        scrollTrigger: { trigger: '.sp-counter', start: 'top 80%' }
      });
    }

    var counters = document.querySelectorAll('.sp-counter');
    var done = false;
    ST.create({
      trigger: '.sp-counter',
      start: 'top 75%',
      onEnter: function () {
        if (done) return;
        done = true;
        counters.forEach(function (el) {
          var target = parseInt(el.dataset.target || '0', 10);
          var obj = { val: 0 };
          gsap.to(obj, {
            val: target, duration: 1.8, ease: 'power2.out',
            onUpdate: function () { el.textContent = Math.round(obj.val); }
          });
        });
      }
    });
  });
})();
</script>
