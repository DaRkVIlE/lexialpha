---
// src/components/SocialProof.astro — Métricas + Pilares com SVG do Ciclo SPARK
// S (Situational) · P (Persona-driven) · A (Acquisition) · R (Recasting) · K (Knowledge-mapped)
---

<section id="ciencia" class="py-28 px-4 sm:px-8 relative border-t border-[#2e224d] overflow-hidden">
  <!-- Linha decorativa topo -->
  <div class="absolute top-0 left-0 right-0 h-px overflow-hidden">
    <div id="sp-line" class="line-decor h-full w-full"></div>
  </div>

  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e] micro-pulse"></span>
        <span class="text-xs font-mono text-[#c2ef4e] uppercase tracking-[0.2em]">A Lógica da Aquisição Natural</span>
      </div>
      <h2 class="font-sans font-extrabold text-3xl sm:text-5xl md:text-6xl tracking-tight mt-2 text-[#ffffff] leading-[1.08]">
        Por que você finalmente destrava<br class="hidden sm:block" />
        <span class="text-gradient-lime">com o Método SPARK</span>
      </h2>
    </div>

    <!-- 4 Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 mb-16" data-anim="fade-up">
      <!-- Stat 1 -->
      <div class="topic-card text-center p-6 sm:p-8 rounded-2xl bg-[#271d40] border border-[#3b2c60] flex flex-col justify-between">
        <div>
          <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl leading-none text-gradient-lime counter-value mb-2 tracking-tight">
            <span class="sp-counter" data-target="15">0</span><span class="text-2xl sm:text-3xl font-extrabold">min</span>
          </div>
          <div class="w-12 h-1 bg-[#c2ef4e]/20 rounded-full mx-auto my-3 overflow-hidden">
            <div class="h-full bg-[#c2ef4e] w-full rounded-full"></div>
          </div>
          <p class="text-xs font-mono text-[#ffffff] uppercase tracking-wider font-semibold mb-1">Mínimo Diário</p>
        </div>
        <p class="text-[#cfcfdb] text-xs leading-relaxed hidden sm:block mt-2">Prática de 15 min no LibreChat para criar mielinização e hábito.</p>
      </div>

      <!-- Stat 2 -->
      <div class="topic-card text-center p-6 sm:p-8 rounded-2xl bg-[#271d40] border border-[#3b2c60] flex flex-col justify-between">
        <div>
          <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl leading-none text-gradient-lime counter-value mb-2 tracking-tight">
            <span class="sp-counter" data-target="3">0</span><span class="text-2xl sm:text-3xl font-extrabold">x</span>
          </div>
          <div class="w-12 h-1 bg-[#c2ef4e]/20 rounded-full mx-auto my-3 overflow-hidden">
            <div class="h-full bg-[#c2ef4e] w-full rounded-full"></div>
          </div>
          <p class="text-xs font-mono text-[#ffffff] uppercase tracking-wider font-semibold mb-1">Sessões / Sem.</p>
        </div>
        <p class="text-[#cfcfdb] text-xs leading-relaxed hidden sm:block mt-2">2 de 15 min (agilidade) + 1 de 30 min (Boss Raids reais com Gabe).</p>
      </div>

      <!-- Stat 3 -->
      <div class="topic-card text-center p-6 sm:p-8 rounded-2xl bg-[#271d40] border border-[#3b2c60] flex flex-col justify-between">
        <div>
          <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl leading-none text-gradient-lime counter-value mb-2 tracking-tight">
            <span class="sp-counter" data-target="24">0</span><span class="text-2xl sm:text-3xl font-extrabold">/7</span>
          </div>
          <div class="w-12 h-1 bg-[#c2ef4e]/20 rounded-full mx-auto my-3 overflow-hidden">
            <div class="h-full bg-[#c2ef4e] w-full rounded-full"></div>
          </div>
          <p class="text-xs font-mono text-[#ffffff] uppercase tracking-wider font-semibold mb-1">Acesso 24/7</p>
        </div>
        <p class="text-[#cfcfdb] text-xs leading-relaxed hidden sm:block mt-2">Companion IA e Portal de Atividades disponíveis na sua rotina.</p>
      </div>

      <!-- Stat 4 -->
      <div class="topic-card text-center p-6 sm:p-8 rounded-2xl bg-[#271d40] border border-[#3b2c60] flex flex-col justify-between">
        <div>
          <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl leading-none text-gradient-lime counter-value mb-2 tracking-tight">
            <span class="sp-counter" data-target="100">0</span><span class="text-2xl sm:text-3xl font-extrabold">%</span>
          </div>
          <div class="w-12 h-1 bg-[#c2ef4e]/20 rounded-full mx-auto my-3 overflow-hidden">
            <div class="h-full bg-[#c2ef4e] w-full rounded-full"></div>
          </div>
          <p class="text-xs font-mono text-[#ffffff] uppercase tracking-wider font-semibold mb-1">Individual</p>
        </div>
        <p class="text-[#cfcfdb] text-xs leading-relaxed hidden sm:block mt-2">Zero salas com outros alunos. Atenção 100% individualizada.</p>
      </div>
    </div>

    <!-- SVG: Ciclo SPARK com nós interativos -->
    <div class="mb-16" data-anim="fade-up" aria-hidden="true">
      <svg viewBox="0 0 680 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-2xl mx-auto opacity-80">
        <!-- Node circles -->
        <circle id="spark-node-s" cx="80" cy="50" r="22" fill="#c2ef4e" fill-opacity="0.1" stroke="#c2ef4e" stroke-opacity="0.6" stroke-width="1.5"/>
        <circle id="spark-node-p" cx="216" cy="50" r="22" fill="#c2ef4e" fill-opacity="0.1" stroke="#c2ef4e" stroke-opacity="0.6" stroke-width="1.5"/>
        <circle id="spark-node-a" cx="340" cy="50" r="22" fill="#c2ef4e" fill-opacity="0.1" stroke="#c2ef4e" stroke-opacity="0.6" stroke-width="1.5"/>
        <circle id="spark-node-r" cx="464" cy="50" r="22" fill="#c2ef4e" fill-opacity="0.1" stroke="#c2ef4e" stroke-opacity="0.6" stroke-width="1.5"/>
        <circle id="spark-node-k" cx="600" cy="50" r="22" fill="#c2ef4e" fill-opacity="0.15" stroke="#c2ef4e" stroke-opacity="0.8" stroke-width="1.8"/>

        <!-- Node letters -->
        <text x="80" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="bold">S</text>
        <text x="216" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="bold">P</text>
        <text x="340" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="bold">A</text>
        <text x="464" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="bold">R</text>
        <text x="600" y="55" text-anchor="middle" font-size="13" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="bold">K</text>

        <!-- Arrows between nodes -->
        <path id="spark-arc-sp" d="M103 50 L191 50" stroke="#c2ef4e" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#sp-arr)"/>
        <path id="spark-arc-pa" d="M239 50 L315 50" stroke="#c2ef4e" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#sp-arr)"/>
        <path id="spark-arc-ar" d="M363 50 L439 50" stroke="#c2ef4e" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#sp-arr)"/>
        <path id="spark-arc-rk" d="M487 50 L575 50" stroke="#c2ef4e" stroke-opacity="0.4" stroke-width="1.5" marker-end="url(#sp-arr)"/>
        <!-- Return arc from K back to S -->
        <path d="M600 28 Q340 -18 80 28" stroke="#c2ef4e" stroke-opacity="0.25" stroke-width="1" fill="none" stroke-dasharray="4 3"/>

        <!-- Labels below -->
        <text x="80" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#cfcfdb">Situational</text>
        <text x="216" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#cfcfdb">Persona-driven</text>
        <text x="340" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#cfcfdb">Acquisition</text>
        <text x="464" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#cfcfdb">Recasting</text>
        <text x="600" y="82" text-anchor="middle" font-size="8" font-family="monospace" fill="#c2ef4e" font-weight="bold">Knowledge-map</text>

        <defs>
          <marker id="sp-arr" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto">
            <path d="M0,0 L0,6 L6,3 z" fill="#c2ef4e" fill-opacity="0.5"/>
          </marker>
        </defs>
      </svg>
    </div>

    <!-- 4 Pilares de Aquisição -->
    <div class="grid md:grid-cols-2 gap-6" data-anim="fade-up">
      {[
        {
          n: '01',
          badge: 'Reflexo Motor',
          title: 'O Fim do Vício da Tradução Mental',
          text: 'No método tradicional, você monta a frase em português antes de falar. Com o SPARK, você treina blocos sonoros prontos (chunks) até que a resposta saia no reflexo, como na sua língua materna.'
        },
        {
          n: '02',
          badge: 'Zero Julgamento',
          title: 'Ambiente Seguro para Praticar Sem Medo',
          text: 'A vergonha de errar é o principal motivo de travamento. No LibreChat, você pratica 15 min por dia com seu companion de IA sem julgamento, ganhando musculatura para as sessões ao vivo.'
        },
        {
          n: '03',
          badge: 'Aquisição Natural',
          title: 'Spaced Recasting (Zero Caneta Vermelha)',
          text: 'Interrupções com correções gramaticais explícitas bloqueiam o cérebro. Tanto a IA quanto Gabe devolvem sua frase reformulada naturalmente na conversa, modelando a estrutura certa sem humilhação.'
        },
        {
          n: '04',
          badge: 'Improviso Real',
          title: 'Boss Raids e Situações Reais com Gabe',
          text: 'A prática diária cria o vocabulário em blocos. As 3 sessões semanais individuais colocam esse repertório em ação em conversas e negociações reais sob pressão controlada.'
        }
      ].map((item) => (
        <div class="topic-card p-6 sm:p-7 rounded-2xl bg-[#271d40] border border-[#3b2c60] flex items-start gap-5">
          <span class="font-sans font-black text-3xl sm:text-4xl text-gradient-lime select-none leading-none shrink-0 tracking-tight">{item.n}</span>
          <div class="space-y-2 flex-1">
            <div class="flex items-center justify-between gap-2">
              <h4 class="font-bold text-[#ffffff] text-base tracking-tight">{item.title}</h4>
              <span class="topic-badge text-[#c2ef4e] border-[#c2ef4e]/25 bg-[#c2ef4e]/10 text-[10px]">{item.badge}</span>
            </div>
            <p class="text-[#cfcfdb] text-sm leading-relaxed">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ready(fn) {
    if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn);
  }
  ready(function () {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap || !ST) return;

    gsap.to('#sp-line', {
      scaleX: 1, duration: 1.5, ease: 'power2.inOut',
      scrollTrigger: { trigger: '#ciencia', start: 'top 85%' }
    });

    if (!reduced) {
      gsap.from('#ciencia [data-anim="fade-up"]', {
        y: 40, opacity: 0, duration: 0.85, stagger: 0.1, ease: 'power3.out',
        scrollTrigger: { trigger: '#ciencia', start: 'top 80%' }
      });
    }

    var counters = document.querySelectorAll('.sp-counter');
    var done = false;
    ST.create({
      trigger: '#ciencia',
      start: 'top 75%',
      onEnter: function () {
        if (done) return;
        done = true;
        counters.forEach(function (el) {
          var target = parseInt(el.dataset.target || '0', 10);
          var obj = { val: 0 };
          gsap.to(obj, {
            val: target, duration: 1.8, ease: 'power2.out',
            onUpdate: function () { el.textContent = Math.round(obj.val); }
          });
        });
      }
    });

    if (reduced) return;

    var nodeIds = ['spark-node-s', 'spark-node-p', 'spark-node-a', 'spark-node-r', 'spark-node-k'];
    var arcIds  = ['spark-arc-sp', 'spark-arc-pa', 'spark-arc-ar', 'spark-arc-rk'];

    var stepDur = 0.5;
    var arcDur  = 0.4;
    var cyclePause = 0.3;

    var sparkTL = gsap.timeline({ repeat: -1, repeatDelay: cyclePause });

    nodeIds.forEach(function (nodeId, i) {
      var nodeEl = document.getElementById(nodeId);
      var arcEl  = arcIds[i] ? document.getElementById(arcIds[i]) : null;
      var t = i * (stepDur + arcDur * 0.5);

      if (nodeEl) {
        sparkTL.to(nodeEl, { fillOpacity: 0.25, duration: stepDur * 0.4, ease: 'sine.inOut' }, t);
        sparkTL.to(nodeEl, { fillOpacity: 0.1, duration: stepDur * 0.6, ease: 'sine.inOut' }, t + stepDur * 0.4);
      }

      if (arcEl) {
        var arcStart = t + stepDur * 0.3;
        sparkTL.to(arcEl, { strokeOpacity: 0.8, duration: arcDur * 0.4, ease: 'sine.inOut' }, arcStart);
        sparkTL.to(arcEl, { strokeOpacity: 0.4, duration: arcDur * 0.6, ease: 'sine.inOut' }, arcStart + arcDur * 0.4);
      }
    });

    sparkTL.pause();
    ST.create({
      trigger: '#ciencia',
      start: 'top 80%',
      once: true,
      onEnter: function () { sparkTL.play(); }
    });
  });
})();
</script>
