---
// src/components/EstagiosFala.astro — Jornada em 3 Fases da Fala
// Progressão Visual Gamificada com CTAs Contextualizados por Estágio

const estagios = [
  {
    id: 'fase-1',
    level: 'Fase 01 · A1/A2',
    name: 'Sobrevivência & Descongelamento',
    subtitle: 'Destrave a voz e quebre o pânico inicial',
    color: '#c2ef4e',
    colorDim: 'rgba(194, 239, 78, 0.1)',
    colorBorder: 'rgba(194, 239, 78, 0.3)',
    milestone: '650 Chunks Nucleares',
    hours: '15 min/dia IA + 3x Gabe',
    trap: 'Traduz mentalmente cada palavra do português e paralisa pelo medo do julgamento alheio.',
    solution: 'Automatização de blocos conversacionais fixos no LibreChat. Na primeira semana você pede, responde e expressa necessidades sem tradução mental.',
    waMessage: encodeURIComponent('Olá Gabe! Quero entrar na Turma Alpha no Estágio 1 (Sobrevivência A1/A2) para destravar minha fala e perder o medo!'),
    btnText: 'Garantir Vaga no Estágio 1',
    xpPercent: 30,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`
  },
  {
    id: 'fase-2',
    level: 'Fase 02 · B1',
    name: 'Autonomia & Tração',
    subtitle: 'Sustente diálogos contínuos sem branco mental',
    color: '#6a5fc1',
    colorDim: 'rgba(106, 95, 193, 0.12)',
    colorBorder: 'rgba(106, 95, 193, 0.35)',
    milestone: '1.400 Chunks Acumulados',
    hours: '2x15m agilidade + 1x30m debate',
    trap: 'Entende filmes e gringos falando, mas na hora de responder a mente congela no platô intermediário.',
    solution: 'Treino de conectores vivos, storytelling e Spaced Recasting com Gabe. Você aprende a contornar palavras esquecidas e manter o ritmo natural da conversa.',
    waMessage: encodeURIComponent('Olá Gabe! Quero entrar na Turma Alpha no Estágio 2 (Autonomia B1) para superar o platô intermediário e falar com fluidez!'),
    btnText: 'Garantir Vaga no Estágio 2',
    xpPercent: 65,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />`
  },
  {
    id: 'fase-3',
    level: 'Fase 03 · B2 (Meta Alpha)',
    name: 'Domínio Executivo & Autoridade',
    subtitle: 'Lidere reuniões internacionais com segurança',
    color: '#fa7faa',
    colorDim: 'rgba(250, 127, 170, 0.12)',
    colorBorder: 'rgba(250, 127, 170, 0.35)',
    milestone: '2.500 Chunks Executivos',
    hours: 'Boss Raids semanais de 30 min',
    trap: 'Hesitação e postura tímida em reuniões globais, pedindo desculpas pelo nível de inglês perante colegas nativos.',
    solution: 'Simulações reais de pitch corporativo, negociações difíceis e Boss Raids intensivos com Gabriel. Postura de autoridade e argumentação persuasiva.',
    waMessage: encodeURIComponent('Olá Gabe! Quero entrar na Turma Alpha no Estágio 3 (Executivo B2) para destravar meu inglês em reuniões corporativas!'),
    btnText: 'Garantir Vaga no Estágio 3',
    xpPercent: 95,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  }
];

const RING_R = 18;
const RING_CIRCUMFERENCE = 2 * Math.PI * RING_R; // ~113.1
---

<section id="estagios" class="py-24 sm:py-28 px-4 sm:px-8 relative border-t border-[#2e224d] overflow-hidden">
  <div class="absolute inset-0 dot-grid-bg opacity-30 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10 w-full">

    <!-- Header -->
    <div class="mb-14 max-w-3xl" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e] micro-pulse"></span>
        <span class="text-xs font-sans font-semibold text-[#c2ef4e] uppercase tracking-[0.2em]">Trilha de Evolução</span>
      </div>
      <h2 class="font-sans font-extrabold text-3xl sm:text-5xl md:text-6xl tracking-tight text-[#ffffff] leading-[1.05]">
        Sua jornada tem<br />
        <span class="text-gradient-lime">três fases de maestria.</span>
      </h2>
      <p class="text-[#cfcfdb] text-base sm:text-lg mt-4 leading-relaxed">
        Cada fase ataca uma trava neurológica específica e entrega um marco mensurável de autonomia comunicativa.
      </p>
    </div>

    <!-- Organograma Visual de Progressão (Timeline Rail) -->
    <div class="hidden lg:flex items-center justify-between mb-8 px-6 py-4 rounded-2xl bg-[#271d40]/60 border border-[#3b2c60]">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#c2ef4e]"></span>
        <span class="text-xs font-sans text-[#c2ef4e] font-semibold uppercase">Fase 1: Descongelamento</span>
      </div>
      <div class="flex-1 mx-4 h-0.5 bg-gradient-to-r from-[#c2ef4e]/40 via-[#6a5fc1]/40 to-[#fa7faa]/40"></div>
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#6a5fc1]"></span>
        <span class="text-xs font-sans text-[#6a5fc1] font-semibold uppercase">Fase 2: Tração Contínua</span>
      </div>
      <div class="flex-1 mx-4 h-0.5 bg-gradient-to-r from-[#6a5fc1]/40 to-[#fa7faa]/40"></div>
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#fa7faa]"></span>
        <span class="text-xs font-sans text-[#fa7faa] font-semibold uppercase">Fase 3: Autonomia Executiva B2</span>
      </div>
    </div>

    <!-- 3 Cards de Fases com CTAs Independentes -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {estagios.map((e) => (
        <div
          class="aether-card p-6 sm:p-8 rounded-3xl bg-[#271d40] border border-[#3b2c60] flex flex-col justify-between relative overflow-hidden transition-all duration-300 hover:border-[#c2ef4e]/40 shadow-xl"
          data-anim="fade-up"
        >
          <!-- Top Row: Badge + XP Ring + Icon -->
          <div>
            <div class="flex items-start justify-between gap-4 mb-5">
              <div>
                <span class="text-xs font-sans uppercase tracking-[0.2em] font-semibold block mb-1" style={`color: ${e.color};`}>
                  {e.level}
                </span>
                <h3 class="text-xl sm:text-2xl font-extrabold text-[#ffffff] tracking-tight leading-snug">
                  {e.name}
                </h3>
                <p class="text-xs text-[#cfcfdb] mt-1">{e.subtitle}</p>
              </div>

              <!-- XP Ring + Icon -->
              <div class="shrink-0 flex items-center gap-2">
                <div
                  class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
                  style={`background: ${e.colorDim}; border: 1px solid ${e.colorBorder}; color: ${e.color};`}
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={e.icon} />
                </div>
              </div>
            </div>

            <!-- Metas Quantitativas do Estágio -->
            <div class="grid grid-cols-2 gap-2 mb-6 p-3 rounded-xl bg-[#1f1633] border border-[#3b2c60]/60 text-xs font-sans">
              <div>
                <span class="text-[#79628c] block text-xs uppercase">Meta Lexical</span>
                <span class="text-[#ffffff] font-semibold">{e.milestone}</span>
              </div>
              <div>
                <span class="text-[#79628c] block text-xs uppercase">Rotina Guiada</span>
                <span class="text-[#c2ef4e] font-semibold">{e.hours}</span>
              </div>
            </div>

            <!-- Trava vs Solução -->
            <div class="space-y-3.5 mb-8">
              <!-- Trava -->
              <div class="p-4 rounded-xl bg-[#281a28]/80 border border-[#4a2432]">
                <div class="flex items-center gap-2 text-xs font-sans text-[#ffb287] uppercase tracking-wider font-semibold mb-1">
                  <svg class="w-3.5 h-3.5 text-[#ffb287]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span>A Trava Deste Nível</span>
                </div>
                <p class="text-xs text-[#cfcfdb] leading-relaxed">{e.trap}</p>
              </div>

              <!-- Solução SPARK -->
              <div class="p-4 rounded-xl bg-[#1f1633] border border-[#3b2c60]">
                <div class="flex items-center gap-2 text-xs font-sans text-[#c2ef4e] uppercase tracking-wider font-semibold mb-1">
                  <svg class="w-3.5 h-3.5 text-[#c2ef4e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>A Aceleração SPARK</span>
                </div>
                <p class="text-xs text-[#cfcfdb] leading-relaxed">{e.solution}</p>
              </div>
            </div>
          </div>

          <!-- CTA Específico por Estágio (Leva direto ao WhatsApp de Gabe com a mensagem da respectiva fase) -->
          <div class="pt-4 border-t border-[#3b2c60]">
            <a
              href={`https://wa.me/5511967239791?text=${e.waMessage}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-xs font-sans font-bold transition-all duration-200 group cursor-pointer"
              style={`background: ${e.colorDim}; border: 1px solid ${e.colorBorder}; color: ${e.color};`}
            >
              <span>{e.btnText}</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
