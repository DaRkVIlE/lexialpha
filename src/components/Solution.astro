---
// src/components/Solution.astro — Bento Grid com copy humana
---

<section id="metodo" class="py-32 px-4 sm:px-8 relative border-t border-[#1a1a1a]">
  <div class="max-w-6xl mx-auto">

    <!-- Header -->
    <div class="mb-16" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e] micro-pulse"></span>
        <span class="text-xs font-mono text-[#3ecf8e] uppercase tracking-[0.2em]">Como Funciona</span>
      </div>
      <h2 class="font-sans font-extrabold text-4xl sm:text-5xl md:text-6xl tracking-tight mt-2 text-[#fafafa] leading-[1.05] max-w-2xl">
        Dois pilares.<br />
        <span class="text-gradient-emerald">Uma transformacao real.</span>
      </h2>
      <p class="text-[#898989] text-base mt-4 max-w-xl leading-relaxed">
        Mentoria individual ao vivo com o Gabe, toda semana. Mais o PlayApp SPARK Alpha para praticar nos outros dias. Os dois juntos.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid md:grid-cols-2 gap-5">

      <!-- Card 1: Mentor Humano ao Vivo -->
      <div
        class="topic-card rounded-3xl bg-[#111111] border border-[#222222] p-8 sm:p-10 flex flex-col justify-between min-h-[480px] relative overflow-hidden group"
        data-anim="fade-up"
      >
        <!-- Glow corner -->
        <div class="absolute -top-20 -left-20 w-56 h-56 bg-[#3ecf8e]/8 rounded-full blur-3xl pointer-events-none group-hover:bg-[#3ecf8e]/12 transition-all duration-700"></div>

        <!-- SVG Waveform Visual -->
        <div class="relative mb-8 flex items-end gap-[3px] h-16">
          <svg viewBox="0 0 320 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" preserveAspectRatio="none">
            {[14,22,38,30,18,48,34,16,42,26,52,38,20,46,32,56,24,44,30,52,26,40,34,48,22,42,36,18,28,14,20,34,46,28,38,52,24,44,30,20].map((h, i) => (
              <rect
                x={i * 8 + 1}
                y={(60 - h) / 2}
                width="5"
                height={h}
                rx="2.5"
                fill="#3ecf8e"
                opacity={0.3 + (i % 6) * 0.11}
                class="wave-bar"
                style={`animation-delay: ${i * 0.04}s;`}
              />
            ))}
          </svg>
        </div>

        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/25 bg-[#3ecf8e]/10">Pilar 01 &bull; Acompanhamento Humano</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-[#fafafa] mb-3 tracking-tight">Mentor Humano ao Vivo</h3>
          <p class="text-[#898989] text-sm leading-relaxed mb-6">
            Toda semana, encontros ao vivo exclusivamente com voce. Dois alinhamentos rapidos de 15 minutos e uma sessao longa de conversacao. Sem agenda compartilhada, sem grupo, sem revezamento.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="topic-badge text-[#d4d4d8] border-[#2e2e2e]">2x Sessoes Rapidas</span>
            <span class="topic-badge text-[#d4d4d8] border-[#2e2e2e]">1x Sessao Estendida</span>
            <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/30 bg-[#3ecf8e]/10">100% Individual</span>
          </div>
        </div>
      </div>

      <!-- Coluna direita: 2 cards empilhados -->
      <div class="flex flex-col gap-5">

        <!-- Card 2: PlayApp SPARK Alpha -->
        <div
          class="topic-card rounded-3xl bg-[#111111] border border-[#222222] p-7 sm:p-8 relative overflow-hidden group flex-1"
          data-anim="fade-up"
        >
          <!-- Chat Mock Visual -->
          <div class="mb-6 space-y-2.5">
            <!-- Bolha IA -->
            <div class="flex items-end gap-2.5">
              <div class="w-6 h-6 rounded-full bg-[#3ecf8e]/20 border border-[#3ecf8e]/30 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-[#3ecf8e]" fill="currentColor" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="5"/>
                </svg>
              </div>
              <div class="max-w-[78%] bg-[#1a1a1a] border border-[#242424] rounded-2xl rounded-bl-none px-3.5 py-2.5">
                <p class="text-xs text-[#d4d4d8] leading-relaxed">Hey! Ready to practice? Tell me about your day at work.</p>
              </div>
            </div>
            <!-- Bolha User -->
            <div class="flex justify-end">
              <div class="max-w-[72%] bg-[#1a2820] border border-[#3ecf8e]/25 rounded-2xl rounded-br-none px-3.5 py-2.5">
                <p class="text-xs text-[#a7f3d0] leading-relaxed">I had two meetings and finished the project report.</p>
              </div>
            </div>
            <!-- Bolha IA resposta -->
            <div class="flex items-end gap-2.5">
              <div class="w-6 h-6 rounded-full bg-[#3ecf8e]/20 border border-[#3ecf8e]/30 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3 text-[#3ecf8e]" fill="currentColor" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="5"/>
                </svg>
              </div>
              <div class="max-w-[78%] bg-[#1a1a1a] border border-[#242424] rounded-2xl rounded-bl-none px-3.5 py-2.5">
                <p class="text-xs text-[#d4d4d8] leading-relaxed">Solid! <span class="text-[#3ecf8e]">How did your team react to the report?</span> <span class="typing-cursor text-[#3ecf8e]">|</span></p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 mb-2">
            <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/25 bg-[#3ecf8e]/10">Pilar 02 &bull; Pratica Diaria</span>
            <span class="text-[10px] font-mono text-[#71717a]">Disponivel 24/7</span>
          </div>
          <h3 class="text-xl font-bold text-[#fafafa] mb-2">PlayApp SPARK Alpha</h3>
          <p class="text-[#898989] text-sm leading-relaxed">
            Sete dias de missoes guiadas, chunks reais e prompts prontos para colar no ChatGPT ou Claude. Voce pratica, registra e acompanha sua evolucao.
          </p>
        </div>

        <!-- Card 3: Aviso Honesto -->
        <div
          class="topic-card rounded-3xl bg-gradient-to-br from-[#121c16] via-[#121212] to-[#0f0f0f] border border-[#3ecf8e]/25 p-7 sm:p-8 relative overflow-hidden"
          data-anim="fade-up"
        >
          <div class="flex items-start gap-4">
            <div class="icon-box text-[#3ecf8e] bg-[#3ecf8e]/15 border-[#3ecf8e]/30">
              <svg class="w-5 h-5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/30 bg-[#3ecf8e]/15">Aviso Honesto</span>
              </div>
              <h3 class="text-lg font-bold text-[#fafafa] mb-1.5">Sem Promessas de Fluencia Rapida</h3>
              <p class="text-[#898989] text-sm leading-relaxed">
                Voce pode progredir em semanas. Mas fluencia solida leva meses de pratica consistente. Garantimos que voce comeca a falar de verdade desde a primeira semana, ou devolvemos o valor integral.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ready(fn) {
    if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn);
  }
  ready(function () {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap || !ST || reduced) return;

    gsap.from('#metodo [data-anim="fade-up"]', {
      y: 45,
      opacity: 0,
      duration: 0.85,
      stagger: 0.1,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#metodo', start: 'top 75%' }
    });
  });
})();
</script>
