---
// src/components/FinalCTA.astro — Atmospheric Full-Width
// Glow enorme, dot grid, headline em Cormorant, sem cards pesados
---

<section class="py-40 px-4 sm:px-8 relative overflow-hidden border-t border-[#1a1a1a]">
  <!-- Dot grid fundo -->
  <div class="absolute inset-0 dot-grid-bg opacity-100 pointer-events-none"></div>

  <!-- Glow central -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[450px] bg-[#3ecf8e]/6 rounded-full blur-[180px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto text-center relative z-10">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full badge-glow mb-8" data-anim="fade-up">
      <span class="w-2 h-2 rounded-full bg-[#3ecf8e] animate-pulse"></span>
      <span class="text-xs font-mono text-[#3ecf8e] tracking-wide">Apenas 10 Vagas &bull; Turma Alpha</span>
    </div>

    <!-- Headline Editorial -->
    <h2 class="font-editorial text-5xl sm:text-6xl md:text-7xl font-light tracking-tight leading-[1.02] mb-6 text-[#fafafa]" data-anim="fade-up">
      Pronto para começar<br />a falar de verdade?
    </h2>

    <p class="text-[#898989] text-base sm:text-lg mb-12 max-w-xl mx-auto leading-relaxed" data-anim="fade-up">
      Como conduzo pessoalmente as sessões individuais de cada aluno, a Turma Alpha é estritamente limitada a 10 pessoas. Sem promessas vazias de fluência instantânea: apenas método, consistência diária e dedicação real.
    </p>

    <!-- Comparação: dois blocos sem cards pesados -->
    <div class="grid sm:grid-cols-2 gap-0 sm:divide-x sm:divide-[#1e1e1e] mb-14 max-w-2xl mx-auto text-left" data-anim="fade-up">
      <!-- Modelo Tradicional -->
      <div class="sm:pr-10 pb-8 sm:pb-0">
        <p class="text-xs font-mono text-red-400/70 uppercase tracking-wider mb-4">Modelo Tradicional</p>
        <ul class="space-y-3 text-sm text-[#898989]">
          {[
            'Travar quando alguém fala com você em inglês',
            'Anos pagando mensalidade sem falar uma conversa fluida',
            'Exercícios mecânicos sem contexto real',
            'Prometer todo início de ano que desta vez vai'
          ].map(item => (
            <li class="flex items-start gap-2.5">
              <span class="text-red-400/60 shrink-0 mt-0.5">&times;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <!-- Método Gabe -->
      <div class="sm:pl-10 pt-8 sm:pt-0">
        <p class="text-xs font-mono text-[#3ecf8e] uppercase tracking-wider mb-4">Método Gabe + Lexi Alpha</p>
        <ul class="space-y-3 text-sm text-[#d4d4d8]">
          {[
            'Encontros individuais semanais ao vivo com o Gabe',
            'Tutor dedicado no Portal Lexi Alpha 24/7',
            'R$ 197/mês sem fidelidade ou contratos anuais',
            'Garantia incondicional de 30 dias com devolução via Pix'
          ].map(item => (
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-[#3ecf8e] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- CTA -->
    <div class="max-w-sm mx-auto" data-anim="fade-up">
      <a
        href="https://wa.me/5511967239791?text=Oi%20Gabe!%20Quero%20garantir%20minha%20vaga%20na%20Turma%20Alpha%20por%20R%24%20197%2Fm%C3%AAs"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-full py-4 px-8 rounded-2xl bg-[#3ecf8e] text-[#0f0f0f] font-bold text-base hover:bg-[#34b27b] active:scale-95 transition-all shadow-xl shadow-[#3ecf8e]/20 group"
      >
        <span>Garantir Minha Vaga no WhatsApp</span>
        <svg class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <p class="text-[#71717a] text-xs mt-4 font-mono">
        Apenas 10 vagas &bull; Início imediato &bull; R$ 197/mês
      </p>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ready(fn) {
    if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn);
  }
  ready(function () {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap || !ST || reduced) return;
    var els = document.querySelectorAll('section:last-of-type [data-anim="fade-up"]');
    gsap.from(els, {
      y: 40, opacity: 0, duration: 0.9, stagger: 0.1, ease: 'power3.out',
      scrollTrigger: { trigger: els[0], start: 'top 80%' }
    });
  });
})();
</script>
