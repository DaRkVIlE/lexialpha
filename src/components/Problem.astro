---
// src/components/Problem.astro — Layout Moderno & Intuitivo: Números de Alto Impacto + Cards Temáticos
// Inspirado em Datamind: tipografia moderna sem serifa, micro-animações nos cards e divisores limpos.
---

<section id="problema" class="py-32 px-4 sm:px-8 relative overflow-hidden border-t border-[#1a1a1a]">
  <!-- Linha decorativa topo -->
  <div class="absolute top-0 left-0 right-0 overflow-hidden h-px">
    <div id="prob-line" class="line-decor h-full w-full"></div>
  </div>

  <div class="max-w-6xl mx-auto">
    <!-- Header Moderno -->
    <div class="mb-20 max-w-3xl" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-red-400 micro-pulse"></span>
        <span class="text-xs font-mono text-[#898989] uppercase tracking-[0.2em]">Transparência Radical</span>
      </div>
      <h2 class="font-sans font-extrabold text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05] mt-2 text-[#fafafa]">
        Por que você estuda há anos<br />
        <span class="text-gradient-emerald">e ainda trava na hora de falar?</span>
      </h2>
    </div>

    <!-- Split: dois lados separados por linha vertical -->
    <div class="grid md:grid-cols-2 md:divide-x md:divide-[#1e1e1e]">

      <!-- Lado Esquerdo: Modelo Quebrado -->
      <div class="md:pr-14 pb-16 md:pb-0" data-anim="fade-up">
        <!-- Numeral enorme decorativo -->
        <div class="font-sans font-black text-[clamp(72px,12vw,140px)] leading-none text-[#222222] select-none mb-2 counter-value tracking-tighter" aria-hidden="true">
          <span id="prob-pct">0</span>%
        </div>
        <p class="text-xs font-mono text-red-400 uppercase tracking-[0.15em] mb-8 font-semibold">dos alunos nunca alcançam o nível B2</p>

        <div class="w-10 h-0.5 bg-red-500/40 mb-6"></div>

        <div class="flex items-center gap-3 mb-6">
          <div class="icon-box text-red-400 bg-red-500/10 border-red-500/25">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-mono text-red-400 uppercase tracking-wider font-semibold">O Modelo do Aluno Eterno</span>
            <h3 class="text-lg font-bold text-[#fafafa]">Método Tradicional de Cursinho</h3>
          </div>
        </div>

        <p class="text-[#898989] text-sm leading-relaxed mb-6">
          Grandes redes lucram com a sua permanência lenta. Elas te colocam para preencher livros de gramática, decorar regras de tempos verbais e traduzir mentalmente no caderno.
        </p>

        <!-- Tópicos com Representação Visual Intuitiva -->
        <div class="space-y-3.5">
          <div class="topic-card-danger topic-card p-4 rounded-xl bg-[#121212] border border-[#242424] flex items-start gap-3.5">
            <div class="icon-box text-red-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div class="space-y-1">
              <span class="topic-badge text-red-400 border-red-500/20 bg-red-500/10">Foco Teórico de Prova</span>
              <p class="text-xs sm:text-sm text-[#898989] leading-relaxed">
                Você aprende a analisar a língua como disciplina escolar, não como reflexo motor imediato.
              </p>
            </div>
          </div>

          <div class="topic-card-danger topic-card p-4 rounded-xl bg-[#121212] border border-[#242424] flex items-start gap-3.5">
            <div class="icon-box text-red-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
            </div>
            <div class="space-y-1">
              <span class="topic-badge text-red-400 border-red-500/20 bg-red-500/10">Tradução Mental Travada</span>
              <p class="text-xs sm:text-sm text-[#898989] leading-relaxed">
                Cria o vício da tradução interna: o cérebro tenta montar a frase em português antes de emitir a fala.
              </p>
            </div>
          </div>

          <div class="topic-card-danger topic-card p-4 rounded-xl bg-[#121212] border border-[#242424] flex items-start gap-3.5">
            <div class="icon-box text-red-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="space-y-1">
              <span class="topic-badge text-red-400 border-red-500/20 bg-red-500/10">Falsas Promessas de 3 Meses</span>
              <p class="text-xs sm:text-sm text-[#898989] leading-relaxed">
                Promessas irreais de fluência mágica que só geram frustração, sensação de fracasso e culpa pessoal.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 p-4 rounded-xl bg-[#161010] border border-red-500/20 flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-red-400 micro-pulse"></div>
          <p class="text-xs font-mono text-red-400/90">Resultado: Anos pagando mensalidades altas e o mesmo bloqueio na primeira reunião.</p>
        </div>
      </div>

      <!-- Lado Direito: Método Gabe -->
      <div class="md:pl-14 pt-16 md:pt-0" data-anim="fade-up">
        <!-- Numeral enorme decorativo -->
        <div class="font-sans font-black text-[clamp(72px,12vw,140px)] leading-none text-gradient-emerald select-none mb-2 counter-value tracking-tighter" aria-hidden="true">
          <span id="prob-days">0</span>
        </div>
        <p class="text-xs font-mono text-[#3ecf8e] uppercase tracking-[0.15em] mb-8 font-semibold">dias para destravar a primeira conversa real</p>

        <div class="w-10 h-0.5 bg-[#3ecf8e]/50 mb-6"></div>

        <div class="flex items-center gap-3 mb-6">
          <div class="icon-box text-[#3ecf8e] bg-[#3ecf8e]/10 border-[#3ecf8e]/25">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-mono text-[#3ecf8e] uppercase tracking-wider font-semibold">Aquisição Natural de Fala</span>
            <h3 class="text-lg font-bold text-[#fafafa]">Método Gabriel Lima + IA Lexi</h3>
          </div>
        </div>

        <p class="text-[#898989] text-sm leading-relaxed mb-6">
          Você não aprendeu português decorando sujeito e predicado antes de começar a falar. Você absorveu blocos completos, praticou sem medo e refinou com o uso diário guiado.
        </p>

        <!-- Tópicos com Representação Visual Intuitiva -->
        <div class="space-y-3.5">
          <div class="topic-card p-4 rounded-xl bg-[#121212] border border-[#242424] flex items-start gap-3.5">
            <div class="icon-box text-[#3ecf8e]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="space-y-1">
              <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/20 bg-[#3ecf8e]/10">Chunks Automáticos</span>
              <p class="text-xs sm:text-sm text-[#898989] leading-relaxed">
                Absorção direta de expressões completas que saem de forma automática e natural da sua boca.
              </p>
            </div>
          </div>

          <div class="topic-card p-4 rounded-xl bg-[#121212] border border-[#242424] flex items-start gap-3.5">
            <div class="icon-box text-[#3ecf8e]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="space-y-1">
              <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/20 bg-[#3ecf8e]/10">Micro-dose Diária 15min</span>
              <p class="text-xs sm:text-sm text-[#898989] leading-relaxed">
                Treino diário de 15 minutos no Portal Lexi Alpha para errar sem vergonha e destravar a musculatura.
              </p>
            </div>
          </div>

          <div class="topic-card p-4 rounded-xl bg-[#121212] border border-[#242424] flex items-start gap-3.5">
            <div class="icon-box text-[#3ecf8e]">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div class="space-y-1">
              <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/20 bg-[#3ecf8e]/10">Mentoria 1 a 1 Exclusiva</span>
              <p class="text-xs sm:text-sm text-[#898989] leading-relaxed">
                Sessões individuais semanais comigo para lapidar conversações reais, simular trabalho e destravar o improviso.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-8 p-4 rounded-xl bg-[#0c1812] border border-[#3ecf8e]/20 flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-[#3ecf8e] micro-pulse"></div>
          <p class="text-xs font-mono text-[#3ecf8e]">Resultado: Você pensa em inglês e fala com naturalidade, sem traduzir internamente.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ready(fn) {
    if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn);
  }

  ready(function () {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap || !ST) return;

    // Linha decorativa
    gsap.to('#prob-line', {
      scaleX: 1,
      duration: 1.5,
      ease: 'power2.inOut',
      scrollTrigger: { trigger: '#problema', start: 'top 85%' }
    });

    // Fade-up elements
    if (!reduced) {
      gsap.from('[data-anim="fade-up"]', {
        y: 50,
        opacity: 0,
        duration: 0.85,
        stagger: 0.12,
        ease: 'power3.out',
        scrollTrigger: { trigger: '#problema', start: 'top 75%' }
      });
    }

    // CountUp: 95% e 21 dias
    var pctEl = document.getElementById('prob-pct');
    var daysEl = document.getElementById('prob-days');
    var triggered = false;

    ST.create({
      trigger: '#problema',
      start: 'top 70%',
      onEnter: function () {
        if (triggered) return;
        triggered = true;

        if (pctEl) {
          var objPct = { val: 0 };
          gsap.to(objPct, {
            val: 95,
            duration: 1.8,
            ease: 'power2.out',
            onUpdate: function () {
              pctEl.textContent = Math.round(objPct.val);
            }
          });
        }

        if (daysEl) {
          var objDays = { val: 0 };
          gsap.to(objDays, {
            val: 21,
            duration: 1.8,
            ease: 'power2.out',
            onUpdate: function () {
              daysEl.textContent = Math.round(objDays.val);
            }
          });
        }
      }
    });
  });
})();
</script>
