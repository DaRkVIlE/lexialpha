---
// src/components/Problem.astro — Seção 2: Identificação Imediata de Dor (03.6)
// O Lag dos 3 Segundos · A Ilusão do Duolingo · O Medo Paralisante de Errar
---

<section id="problema" class="py-24 sm:py-28 px-4 sm:px-8 relative overflow-hidden border-t border-[#2e224d]">
  <!-- Linha decorativa topo -->
  <div class="absolute top-0 left-0 right-0 overflow-hidden h-px">
    <div id="prob-line" class="line-decor h-full w-full"></div>
  </div>

  <div class="max-w-6xl mx-auto">
    <!-- Header Problem -->
    <div class="mb-14 max-w-3xl" data-anim="fade-up">
      <p class="text-xs font-sans font-bold text-[#ffb287] uppercase tracking-[0.25em] mb-3">O Ciclo do Cursinho Tradicional</p>
      <h2 class="font-sans font-extrabold text-3xl sm:text-5xl md:text-6xl tracking-tight leading-[1.08] text-[#ffffff]">
        Você estudou por anos,<br />
        mas na hora de falar... a mente <span class="text-[#ffb287] underline decoration-[#ffb287]/40 underline-offset-8">trava</span>.
      </h2>
    </div>

    <!-- Infográfico SVG Animado: O Ciclo de Bloqueio vs Reflexo Direto SPARK -->
    <div class="mb-16 p-6 sm:p-8 rounded-3xl bg-[#271d40]/60 border border-[#3b2c60] shadow-xl" data-anim="fade-up" aria-hidden="true">
      <div class="text-center mb-6">
        <span class="text-xs font-sans font-semibold text-[#cfcfdb] uppercase tracking-wider">O Ciclo do Travamento Mental vs. O Reflexo SPARK</span>
      </div>

      <svg viewBox="0 0 760 110" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-3xl mx-auto opacity-95">
        <!-- Lado Esquerdo: Método Tradicional (Tradução Mental) -->
        <ellipse cx="60" cy="55" rx="22" ry="18" stroke="#ef4444" stroke-opacity="0.6" stroke-width="1.5" fill="#ef4444" fill-opacity="0.1"/>
        <text x="60" y="59" text-anchor="middle" font-size="10" font-family="'Source Code Pro', monospace" fill="#ef4444" font-weight="bold">PT-BR</text>

        <!-- Arcos conectando as etapas -->
        <path id="trad-arc-1" d="M 85 45 Q 115 25 145 45" stroke="#ef4444" stroke-opacity="0.5" stroke-width="1.5" fill="none" marker-end="url(#arr-red)"/>
        <path id="trad-arc-2" d="M 155 45 Q 185 25 215 45" stroke="#ef4444" stroke-opacity="0.5" stroke-width="1.5" fill="none" marker-end="url(#arr-red)"/>
        <path id="trad-arc-3" d="M 225 45 Q 255 25 285 45" stroke="#ef4444" stroke-opacity="0.5" stroke-width="1.5" fill="none" marker-end="url(#arr-red)"/>

        <!-- Nós do Loop Tradicional -->
        <circle id="trad-node-ouvir" cx="150" cy="50" r="14" fill="#1f1633" stroke="#ef4444" stroke-opacity="0.6" stroke-width="1.5"/>
        <text x="150" y="54" text-anchor="middle" font-size="8" font-family="'Source Code Pro', monospace" fill="#ef4444">ouvir</text>

        <circle id="trad-node-traduzir" cx="220" cy="50" r="14" fill="#1f1633" stroke="#ef4444" stroke-opacity="0.6" stroke-width="1.5"/>
        <text x="220" y="54" text-anchor="middle" font-size="7.5" font-family="'Source Code Pro', monospace" fill="#ef4444">traduzir</text>

        <circle id="trad-node-montar" cx="290" cy="50" r="14" fill="#1f1633" stroke="#ef4444" stroke-opacity="0.6" stroke-width="1.5"/>
        <text x="290" y="54" text-anchor="middle" font-size="8" font-family="'Source Code Pro', monospace" fill="#ef4444">montar</text>

        <text x="290" y="82" text-anchor="middle" font-size="9" font-family="'Source Code Pro', monospace" fill="#ef4444" font-weight="bold">Lag dos 3s (Trava)</text>

        <text x="175" y="100" text-anchor="middle" font-size="9" font-family="'Source Code Pro', monospace" fill="#ffb287" font-weight="600">MÉTODO TRADICIONAL</text>

        <!-- Divisor central -->
        <line x1="380" y1="10" x2="380" y2="100" stroke="#3b2c60" stroke-width="1.5" stroke-dasharray="4 4"/>

        <!-- Lado Direito: SPARK (Aquisição Direta) -->
        <ellipse cx="470" cy="55" rx="22" ry="18" stroke="#c2ef4e" stroke-opacity="0.7" stroke-width="1.5" fill="#c2ef4e" fill-opacity="0.12"/>
        <text x="470" y="59" text-anchor="middle" font-size="10" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="bold">SPARK</text>

        <!-- Seta direta sem tradução -->
        <path id="spark-direct-arrow" d="M 496 50 Q 540 20 580 50" stroke="#c2ef4e" stroke-opacity="0.9" stroke-width="2" fill="none" marker-end="url(#arr-lime)"/>

        <!-- Nó de fala direta -->
        <circle id="spark-speak-node" cx="600" cy="50" r="22" fill="#1f1633" stroke="#c2ef4e" stroke-width="2"/>
        <text x="600" y="46" text-anchor="middle" font-size="9" font-family="'Source Code Pro', monospace" fill="#ffffff" font-weight="bold">falar</text>
        <text x="600" y="58" text-anchor="middle" font-size="7.5" font-family="'Source Code Pro', monospace" fill="#c2ef4e">no reflexo</text>

        <text x="540" y="24" text-anchor="middle" font-size="8.5" font-family="'Source Code Pro', monospace" fill="#c2ef4e">0.3s · sem traduzir</text>
        <text x="600" y="86" text-anchor="middle" font-size="8" font-family="'Source Code Pro', monospace" fill="#c2ef4e">Chunks Nucleares</text>

        <text x="540" y="100" text-anchor="middle" font-size="9" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="bold">MÉTODO SPARK (DIRETO)</text>

        <!-- Marcadores -->
        <defs>
          <marker id="arr-red" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto">
            <path d="M0,0 L0,6 L6,3 z" fill="#ef4444" fill-opacity="0.8"/>
          </marker>
          <marker id="arr-lime" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto">
            <path d="M0,0 L0,6 L6,3 z" fill="#c2ef4e" fill-opacity="0.9"/>
          </marker>
        </defs>
      </svg>
    </div>

    <!-- Grid dos 3 Sintomas Reais (03.6) vs Solução SPARK -->
    <div class="grid md:grid-cols-2 md:divide-x md:divide-[#3b2c60]">

      <!-- Lado Esquerdo: Os 3 Sintomas Reais de Dor -->
      <div class="md:pr-12 pb-14 md:pb-0" data-anim="fade-up">
        <div class="font-sans font-black text-6xl sm:text-7xl lg:text-8xl leading-none text-[#ffb287] select-none mb-2 counter-value tracking-tighter" aria-hidden="true">
          95%
        </div>
        <p class="text-xs font-sans font-semibold text-[#ffb287] uppercase tracking-[0.15em] mb-8 font-semibold">não atingem a fala fluida com o método de cursinho</p>

        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-[#ffb287]/15 flex items-center justify-center text-[#ffb287] shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-sans font-semibold text-[#ffb287] uppercase tracking-wider">O Modelo do Aluno Eterno</span>
            <h3 class="text-lg font-bold text-[#ffffff]">Os 3 Sintomas Que Te Bloqueiam</h3>
          </div>
        </div>

        <!-- 3 Sintomas Canônicos Literais (03.6) -->
        <div class="space-y-4">
          <!-- Sintoma 1 -->
          <div class="p-4 rounded-xl bg-[#281a28] border border-[#4a2432] flex items-start gap-3.5">
            <div class="w-6 h-6 rounded-md bg-[#ffb287]/20 text-[#ffb287] flex items-center justify-center shrink-0 text-xs font-sans font-bold mt-0.5">1</div>
            <div class="space-y-1">
              <span class="text-xs font-sans font-semibold text-[#ffb287] block">O Lag dos 3 Segundos</span>
              <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed">
                Você ouve em inglês, traduz para o português, formula a resposta em português, traduz de volta para o inglês... e quando vai falar, a conversa já acabou.
              </p>
            </div>
          </div>

          <!-- Sintoma 2 -->
          <div class="p-4 rounded-xl bg-[#281a28] border border-[#4a2432] flex items-start gap-3.5">
            <div class="w-6 h-6 rounded-md bg-[#ffb287]/20 text-[#ffb287] flex items-center justify-center shrink-0 text-xs font-sans font-bold mt-0.5">2</div>
            <div class="space-y-1">
              <span class="text-xs font-sans font-semibold text-[#ffb287] block">A Ilusão do Duolingo</span>
              <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed">
                Tem streak de 500 dias combinando pecinhas na tela do celular, mas entra em pânico na hora de pedir um café ou tirar dúvidas em um aeroporto gringo.
              </p>
            </div>
          </div>

          <!-- Sintoma 3 -->
          <div class="p-4 rounded-xl bg-[#281a28] border border-[#4a2432] flex items-start gap-3.5">
            <div class="w-6 h-6 rounded-md bg-[#ffb287]/20 text-[#ffb287] flex items-center justify-center shrink-0 text-xs font-sans font-bold mt-0.5">3</div>
            <div class="space-y-1">
              <span class="text-xs font-sans font-semibold text-[#ffb287] block">O Medo Paralisante de Errar</span>
              <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed">
                A escola tradicional te ensinou que errar é vergonhoso. Hoje você prefere ficar mudo em reuniões da empresa a arriscar falar uma palavra fora do lugar.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-6 p-3.5 rounded-xl bg-[#281a28]/60 border border-[#ffb287]/30 flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-[#ffb287] micro-pulse"></div>
          <p class="text-xs font-sans text-[#ffb287]">Resultado: anos de mensalidade e o mesmo bloqueio na hora de falar.</p>
        </div>
      </div>

      <!-- Lado Direito: A Solução com o Método SPARK -->
      <div class="md:pl-12 pt-14 md:pt-0" data-anim="fade-up">
        <div class="font-sans font-black text-6xl sm:text-7xl lg:text-8xl leading-none text-gradient-lime select-none mb-2 counter-value tracking-tighter" aria-hidden="true">
          30
        </div>
        <p class="text-xs font-sans font-semibold text-[#c2ef4e] uppercase tracking-[0.15em] mb-8 font-semibold">dias para destravar sua primeira fala sem traduzir</p>

        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-lg bg-[#c2ef4e]/15 flex items-center justify-center text-[#c2ef4e] shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-sans font-semibold text-[#c2ef4e] uppercase tracking-wider">Aquisição Natural Acelerada</span>
            <h3 class="text-lg font-bold text-[#ffffff]">Como o Método SPARK Resolve</h3>
          </div>
        </div>

        <p class="text-[#cfcfdb] text-xs sm:text-sm leading-relaxed mb-6">
          Você não aprendeu português decorando tabelas gramaticais. Você absorveu blocos completos (<em>chunks</em>), praticou sem medo e refinou com o uso. O inglês no SPARK funciona exatamente assim.
        </p>

        <div class="space-y-4">
          <div class="p-4 rounded-xl bg-[#1f1633] border border-[#3b2c60] flex items-start gap-3.5">
            <div class="w-6 h-6 rounded-md bg-[#c2ef4e]/20 text-[#c2ef4e] flex items-center justify-center shrink-0 text-xs font-sans font-bold mt-0.5">✓</div>
            <div class="space-y-1">
              <span class="text-xs font-sans font-semibold text-[#c2ef4e] block">Chunks Automáticos</span>
              <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed">
                Expressões e blocos formulaicos prontos que saem da sua boca no reflexo imediato, sem necessidade de tradução mental prévia.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#1f1633] border border-[#3b2c60] flex items-start gap-3.5">
            <div class="w-6 h-6 rounded-md bg-[#c2ef4e]/20 text-[#c2ef4e] flex items-center justify-center shrink-0 text-xs font-sans font-bold mt-0.5">✓</div>
            <div class="space-y-1">
              <span class="text-xs font-sans font-semibold text-[#c2ef4e] block">Spaced Recasting Sem Caneta Vermelha</span>
              <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed">
                Correção orgânica durante o fluxo da conversa no LibreChat e com Gabe. A frase certa é devolvida modelada sem interrupções constrangedoras.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#1f1633] border border-[#3b2c60] flex items-start gap-3.5">
            <div class="w-6 h-6 rounded-md bg-[#c2ef4e]/20 text-[#c2ef4e] flex items-center justify-center shrink-0 text-xs font-sans font-bold mt-0.5">✓</div>
            <div class="space-y-1">
              <span class="text-xs font-sans font-semibold text-[#c2ef4e] block">Sessões Individuais de Alto Impacto</span>
              <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed">
                3 sessões curtas por semana (2x 15m + 1x 30m Boss Raids) focadas no seu improviso sob pressão e autoridade executiva.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-6 p-3.5 rounded-xl bg-[#1f1633] border border-[#c2ef4e]/30 flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-[#c2ef4e] micro-pulse"></div>
          <p class="text-xs font-sans text-[#c2ef4e]">Garantia 30 Dias: sua fala destrava ou devolvemos 100% via Pix.</p>
        </div>
      </div>

    </div>
  </div>
</section>
