---
// src/components/StickyMobileCTA.astro — Barra de Ação Fixa para Dispositivos Móveis
// Aparece suavemente após o Hero e some quando a seção de Preço/Oferta entra na tela
---

<div
  id="sticky-mobile-cta"
  class="md:hidden fixed bottom-0 inset-x-0 z-40 p-3 bg-[#1f1633]/95 backdrop-blur-xl border-t border-[#3b2c60] transition-all duration-300 translate-y-full opacity-0 pointer-events-none shadow-2xl"
  aria-hidden="true"
>
  <div class="flex items-center justify-between gap-3 max-w-md mx-auto">
    <div class="flex flex-col">
      <span class="text-xs font-sans text-[#c2ef4e] font-bold uppercase tracking-wider">Turma Alpha · 15 Vagas</span>
      <span class="text-xs text-[#cfcfdb]">Destrave em 30 dias</span>
    </div>

    <a
      href="#quiz"
      class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[#c2ef4e] text-[#1f1633] text-xs font-sans font-extrabold hover:bg-[#b0dc41] active:scale-95 transition-all shadow-md shadow-[#c2ef4e]/20"
    >
      <span>Fazer o Teste (Grátis)</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</div>

<script is:inline>
  (function initStickyCTA() {
    function setup() {
      const bar = document.getElementById('sticky-mobile-cta');
      const hero = document.getElementById('hero');
      const pricing = document.getElementById('pricing');

      if (!bar || !hero) return;

      let isHeroVisible = true;
      let isPricingVisible = false;

      function updateBar() {
        if (!isHeroVisible && !isPricingVisible) {
          bar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
          bar.setAttribute('aria-hidden', 'false');
        } else {
          bar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
          bar.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          bar.setAttribute('aria-hidden', 'true');
        }
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.target === hero) {
            isHeroVisible = entry.isIntersecting;
          }
          if (entry.target === pricing) {
            isPricingVisible = entry.isIntersecting;
          }
        });
        updateBar();
      }, { threshold: 0.1 });

      observer.observe(hero);
      if (pricing) observer.observe(pricing);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
