---
// src/components/Footer.astro — Seção 8: Rodapé Jurídico & Confiança (03.6)
import Logo from './Logo.astro';
---

<footer class="py-14 px-4 sm:px-6 lg:px-8 bg-[#1f1633] border-t border-[#2e224d] text-[#cfcfdb] text-xs relative overflow-hidden">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
      <Logo showBadge={false} />
      <span class="hidden sm:inline text-[#3b2c60]">|</span>
      <span class="text-[#cfcfdb] font-medium">LexiQuest Idiomas · Gabriel Ferreira Lima (Professor Responsável)</span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-6 text-[#cfcfdb] text-xs font-medium">
      <a href="#metodo" class="hover:text-[#c2ef4e] transition-colors">Como Funciona</a>
      <a href="#quiz" class="hover:text-[#c2ef4e] transition-colors">Teste de Nivelamento</a>
      <a href="#estagios" class="hover:text-[#c2ef4e] transition-colors">Estágios da Fala</a>
      <a href="#montanha-cefr" class="hover:text-[#c2ef4e] transition-colors">Escala CEFR</a>
      <a href="#ecossistema" class="hover:text-[#c2ef4e] transition-colors">Ecossistema</a>
      <a href="#pricing" class="hover:text-[#c2ef4e] transition-colors">Turma Alpha (15 Vagas)</a>
      <a href="#faq" class="hover:text-[#c2ef4e] transition-colors">Dúvidas</a>
      <a href="https://wa.me/5511967239791" target="_blank" rel="noopener noreferrer" class="hover:text-[#c2ef4e] transition-colors">WhatsApp</a>
    </div>

    <div class="text-[#79628c] text-center sm:text-right font-mono">
      &copy; 2026 LexiQuest. Todos os direitos reservados.
    </div>
  </div>
</footer>
