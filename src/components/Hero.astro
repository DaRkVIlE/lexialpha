---
// src/components/Hero.astro — LexiQuest Hero Section
// Aether Luxury Aesthetic: Presença do Mentor Gabriel Lima + HUD de Latência Oral
---

<section id="hero" class="relative min-h-[92vh] flex flex-col justify-center overflow-hidden border-b border-[#2e224d]">
  <!-- Background Glows Sentry Purple & Neon Lime -->
  <div class="absolute inset-0 dot-grid-bg opacity-30 pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-[#6a5fc1]/15 rounded-full blur-[180px] pointer-events-none"></div>
  <div class="absolute top-1/2 right-1/4 w-[500px] h-[400px] bg-[#c2ef4e]/10 rounded-full blur-[160px] pointer-events-none"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8 pt-32 pb-20 w-full">
    <div class="flex flex-col lg:flex-row lg:items-center gap-12 lg:gap-16">

      <!-- Left: Copy Oficial (03.6) -->
      <div class="flex-1 min-w-0">
        <!-- Eyebrow Badge (15 Vagas) -->
        <div id="hero-badge" class="mb-6">
          <span class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[#271d40] border border-[#c2ef4e]/30 text-xs font-sans font-semibold text-[#ffffff] uppercase tracking-[0.18em] shadow-sm">
            <span class="w-2 h-2 rounded-full bg-[#c2ef4e] micro-pulse"></span>
            Turma Alpha · Apenas 15 Vagas para Alunos Fundadores
          </span>
        </div>

        <!-- Headline Canônica 03.6 -->
        <h1 class="mb-6 max-w-3xl">
          <span class="reveal-line block font-sans font-extrabold text-4xl sm:text-6xl md:text-7xl leading-[1.04] tracking-[-0.03em] text-[#ffffff]">
            Pare de traduzir
          </span>
          <span class="reveal-line block font-sans font-extrabold text-4xl sm:text-6xl md:text-7xl leading-[1.04] tracking-[-0.03em] text-[#ffffff]">
            na sua cabeça.
          </span>
          <span class="reveal-line block font-sans font-extrabold text-4xl sm:text-6xl md:text-7xl leading-[1.04] tracking-[-0.03em] text-gradient-lime mt-1">
            Destrave sua fala em 30 dias.
          </span>
        </h1>

        <!-- Subheadline Canônica -->
        <div id="hero-sub" class="max-w-xl mb-8">
          <p class="text-base sm:text-lg text-[#cfcfdb] leading-relaxed">
            Método de aquisição acelerada que combina <strong class="text-[#ffffff]">15 minutos diários de prática com IA sem julgamento</strong> e <strong class="text-[#c2ef4e]">3 sessões individuais por semana com o professor Gabriel</strong>.
          </p>

          <!-- Bullet points com ícones SVG minimalistas -->
          <div class="mt-6 space-y-3 text-xs sm:text-sm text-[#cfcfdb]">
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full bg-[#c2ef4e]/15 flex items-center justify-center shrink-0 text-[#c2ef4e]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span><strong class="text-[#ffffff]">Zero caneta vermelha:</strong> o cérebro aprende por blocos sonoros (<em>chunks</em>), sem humilhação gramatical.</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full bg-[#c2ef4e]/15 flex items-center justify-center shrink-0 text-[#c2ef4e]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span><strong class="text-[#ffffff]">3 encontros rápidos por semana:</strong> 2 de 15 min (agilidade) + 1 de 30 min (Boss Raid com Gabe).</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full bg-[#c2ef4e]/15 flex items-center justify-center shrink-0 text-[#c2ef4e]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span><strong class="text-[#ffffff]">Portal do Aluno + Garantia 30 dias:</strong> sua fala destrava ou devolvemos 100% via Pix.</span>
            </div>
          </div>
        </div>

        <!-- CTAs Primário & Secundário -->
        <div id="hero-ctas" class="flex flex-col sm:flex-row sm:items-center gap-4">
          <a
            href="#quiz"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-[#c2ef4e] text-[#1f1633] font-sans font-extrabold text-sm sm:text-base hover:bg-[#b0dc41] active:scale-95 transition-all shadow-xl shadow-[#c2ef4e]/20 group"
          >
            <span>Fazer Teste de Nivelamento (Grátis)</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#sobre"
            class="inline-flex items-center justify-center px-7 py-4 rounded-full border border-[#3b2c60] text-[#cfcfdb] text-sm font-medium hover:border-[#c2ef4e]/50 hover:text-[#ffffff] transition-all bg-[#271d40]/60"
          >
            Conhecer o Professor Gabriel
          </a>
        </div>
        <p class="text-xs text-[#79628c] mt-3 font-sans">
          Sem cadastro prévio. Diagnóstico do seu nível de fala em 2 minutos.
        </p>

        <!-- Trust Badges Limpos com Ícones SVG Monocromáticos -->
        <div id="hero-trust" class="mt-8 flex flex-wrap items-center gap-4 sm:gap-6 text-[#cfcfdb] text-xs font-sans">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#c2ef4e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            <span>Sparring IA 24/7 no LibreChat</span>
          </span>
          <span class="w-px h-3 bg-[#3b2c60]"></span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#fa7faa]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <span>3 Sessões Semanais Gabe</span>
          </span>
          <span class="w-px h-3 bg-[#3b2c60]"></span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#c2ef4e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Garantia 30 Dias</span>
          </span>
        </div>
      </div>

      <!-- Right: Card do Mentor Gabriel + Terminal de Latência -->
      <div class="hidden lg:block shrink-0 w-[420px] relative select-none" data-anim="fade-up">
        <div class="rounded-3xl bg-[#271d40]/90 border border-[#3b2c60] p-6 shadow-2xl backdrop-blur-xl relative overflow-hidden">
          
          <!-- Bloco do Mentor Gabriel Lima (Mock Fotográfico + Credenciais) -->
          <div class="flex items-center gap-4 pb-5 border-b border-[#3b2c60] mb-5">
            <div class="relative w-16 h-16 rounded-2xl bg-gradient-to-br from-[#6a5fc1]/30 to-[#c2ef4e]/20 border border-[#c2ef4e]/40 flex items-center justify-center text-[#c2ef4e] shrink-0 shadow-lg overflow-hidden">
              <svg class="w-8 h-8 text-[#c2ef4e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <div class="absolute bottom-0 inset-x-0 bg-[#c2ef4e]/20 text-xs font-sans font-bold text-center text-[#c2ef4e] py-0.5">MOCK</div>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <h3 class="font-sans font-bold text-base text-[#ffffff] truncate">Gabriel Ferreira Lima</h3>
                <span class="text-xs font-sans font-bold px-2 py-0.5 rounded bg-[#c2ef4e]/10 text-[#c2ef4e] border border-[#c2ef4e]/30">ONLINE</span>
              </div>
              <p class="text-xs font-sans font-semibold text-[#c2ef4e] mt-0.5">Professor & Criador do SPARK</p>
              <p class="text-xs text-[#cfcfdb] mt-1">5 anos de sala de aula · All Net & Mentoria</p>
            </div>
          </div>

          <!-- Demonstrador de Áudio do Gabriel (15s Mock Player) -->
          <div class="mb-5 p-4 rounded-2xl bg-[#1f1633] border border-[#3b2c60] relative overflow-hidden">
            <div class="flex items-center justify-between text-xs font-sans font-semibold mb-3">
              <span class="text-[#cfcfdb] flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#c2ef4e] micro-pulse"></span>
                <span>Demonstração de Fala Real (15s)</span>
              </span>
              <span class="text-xs text-[#fa7faa] font-bold">Áudio do Gabe</span>
            </div>

            <!-- Waveform Animation -->
            <div class="flex items-center justify-center gap-1.5 h-8 py-1 bg-[#271d40]/40 rounded-xl px-4 border border-[#3b2c60]/50">
              <span class="w-1 bg-[#c2ef4e] rounded-full wave-bar" style="height: 40%; animation-delay: 0.1s;"></span>
              <span class="w-1 bg-[#c2ef4e] rounded-full wave-bar" style="height: 80%; animation-delay: 0.2s;"></span>
              <span class="w-1 bg-[#c2ef4e] rounded-full wave-bar" style="height: 100%; animation-delay: 0.3s;"></span>
              <span class="w-1 bg-[#c2ef4e] rounded-full wave-bar" style="height: 60%; animation-delay: 0.4s;"></span>
              <span class="w-1 bg-[#c2ef4e] rounded-full wave-bar" style="height: 90%; animation-delay: 0.2s;"></span>
              <span class="w-1 bg-[#c2ef4e] rounded-full wave-bar" style="height: 50%; animation-delay: 0.5s;"></span>
              <span class="w-1 bg-[#c2ef4e] rounded-full wave-bar" style="height: 75%; animation-delay: 0.15s;"></span>
              <span class="w-1 bg-[#c2ef4e] rounded-full wave-bar" style="height: 35%; animation-delay: 0.35s;"></span>
            </div>
            
            <p class="text-xs font-sans text-center text-[#cfcfdb] mt-2.5">
              "Hey! Let's get straight to the point without translating."
            </p>
          </div>

          <!-- Latency Gauge: 3.2s Tradução vs 0.3s SPARK Reflex — ANIMATED -->
          <div class="p-4 rounded-2xl bg-[#1f1633] border border-[#3b2c60]" id="hero-latency-gauge">
            <div class="flex items-center justify-between text-xs font-sans font-semibold mb-3">
              <span class="text-[#cfcfdb]">Latência da Resposta Oral</span>
              <span class="text-[#c2ef4e] font-bold">10x Mais Rápido</span>
            </div>
            
            <!-- Tradução Mental -->
            <div class="mb-3">
              <div class="flex justify-between text-xs font-sans mb-1 text-[#ffb287]">
                <span>Método Tradicional</span>
                <span id="hero-trad-counter">0.0s</span>
              </div>
              <div class="w-full h-2 rounded-full bg-[#271d40] overflow-hidden">
                <div id="hero-trad-bar" class="h-full bg-[#ffb287] rounded-full transition-none" style="width: 0%"></div>
              </div>
            </div>

            <!-- Método SPARK -->
            <div>
              <div class="flex justify-between text-xs font-sans mb-1 text-[#c2ef4e]">
                <span>Método SPARK (Reflexo)</span>
                <span id="hero-spark-counter">0.0s</span>
              </div>
              <div class="w-full h-2 rounded-full bg-[#271d40] overflow-hidden">
                <div id="hero-spark-bar" class="h-full bg-[#c2ef4e] rounded-full transition-none" style="width: 0%"></div>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
