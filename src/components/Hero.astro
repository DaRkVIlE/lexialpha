---
// Hero.astro — Hero Section Gabe's English
// Design System: Gabe's English (Sentry-inspired Dark Purple DS)
// Story: Turma Alpha Launch — Professor Gabe + IA Complementar Lexi Alpha
import Button from './Button.astro';
---

<section class="relative min-h-[90vh] flex flex-col items-center justify-center pt-28 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden bg-background text-foreground">
  <!-- Gradient Pattern -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#2563EB15_1px,transparent_1px),linear-gradient(to_bottom,#EC489915_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <!-- Spotlight -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-primary/10 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-5xl mx-auto text-center relative z-10">
    <!-- Turma Alpha Badge -->
    <div class="hero-badge inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-primary/20 bg-background-elevated/80 text-xs font-semibold text-primary mb-8 backdrop-blur shadow-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
      </span>
      <span>Turma Alpha &bull; Apenas 10 Vagas &bull; Aulas com Gabe + IA Lexi Alpha</span>
    </div>

    <!-- Headline -->
    <h1 class="hero-headline text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground leading-[1.15] mb-8 max-w-4xl mx-auto">
      Você não estuda para falar.<br class="hidden sm:inline" />
      Você fala para aprender.
    </h1>

    <!-- Subheadline -->
    <p class="hero-sub text-base sm:text-lg text-foreground-muted max-w-2xl mx-auto leading-relaxed mb-10 font-normal">
      Acompanhamento direto com o professor <strong class="text-foreground">Gabriel Lima (Gabe)</strong> em encontros focados no seu destravamento real, somado à <strong class="text-foreground">Lexi Alpha</strong> — nossa IA de conversação autoral para você praticar todos os dias. Sem mentiras de "fique fluente em meses". Apenas método sério, consistência e respeito.
    </p>

    <!-- CTAs -->
    <div class="hero-cta flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto mb-6">
      <Button variant="accent" size="lg" href="#quiz">
        Fazer Diagnóstico de Fala (3 min)
      </Button>
      <Button variant="secondary" size="lg" href="#metodo">
        Como Funciona o Método
      </Button>
    </div>

    <!-- Micro-copy -->
    <p class="text-xs text-foreground-muted font-medium">
      R$&nbsp;197/mês &bull; 10 Vagas na Turma Alpha &bull; 2x Sessões Rápidas + 1x Sessão Estendida &bull; IA Diária 24/7
    </p>
  </div>
</section>
