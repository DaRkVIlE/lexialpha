---
// src/components/Hero.astro
// Hero Section Premium: Autoridade do Professor + Metodologia Anti-Ilusão
// Zero preços no topo, zero travessões
import Button from './Button.astro';
---

<section class="relative pt-36 pb-24 md:pt-44 md:pb-32 px-4 sm:px-8 max-w-6xl mx-auto overflow-hidden">
  <!-- Subtle Gradient Background Orbs (Linear/Supabase Style) -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-[#3ecf8e]/8 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[300px] h-[250px] bg-[#242424]/40 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="text-center max-w-4xl mx-auto space-y-8">
    <!-- Tag de Posicionamento -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#171717] border border-[#242424] text-xs font-mono text-[#898989] shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[#3ecf8e] animate-pulse"></span>
      Mentoria Individual 1 a 1 com Gabriel Lima + Tutor Autoral de IA
    </div>

    <!-- Headline Principal: Forte, Direta, Sem Ilusão -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-[#fafafa] leading-[1.08] text-balance">
      Você não estuda para falar.<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#fafafa] via-[#3ecf8e] to-[#2ebd7a]">
        Você fala para aprender.
      </span>
    </h1>

    <!-- Subheadline: Convincente, Realista e Focada no Problema Real -->
    <p class="text-lg sm:text-xl text-[#898989] max-w-2xl mx-auto leading-relaxed text-pretty">
      Destrave sua fala em inglês sem decoreba gramatical de cursinho tradicional. 
      Acompanhamento individual comigo toda semana somado ao treino diário no seu ritmo com uma inteligência artificial criada sob medida para suas necessidades.
    </p>

    <!-- CTAs da Hero: Foco em Exploração e Conhecimento do Método (Zero Preço Aqui) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a href="#metodo">
        <Button variant="primary" size="lg" class="w-full sm:w-auto shadow-lg shadow-[#3ecf8e]/10">
          Conhecer o método na prática &rarr;
        </Button>
      </a>
      <a href="#estagios">
        <Button variant="secondary" size="lg" class="w-full sm:w-auto">
          Ver estágios de evolução
        </Button>
      </a>
    </div>

    <!-- Destaques de Confiança Sem Caras de IA -->
    <div class="pt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto text-left">
      <div class="p-4 rounded-2xl bg-[#141414] border border-[#242424] flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-[#3ecf8e]/10 text-[#3ecf8e] flex items-center justify-center shrink-0 font-bold text-sm">
          1:1
        </div>
        <div>
          <h2 class="text-sm font-semibold text-[#fafafa]">Alinhamento Individual</h2>
          <p class="text-xs text-[#898989] mt-0.5">Encontros individuais dedicados às suas travas reais de pronúncia e vocabulário.</p>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-[#141414] border border-[#242424] flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-[#3ecf8e]/10 text-[#3ecf8e] flex items-center justify-center shrink-0 font-bold text-sm">
          IA
        </div>
        <div>
          <h2 class="text-sm font-semibold text-[#fafafa]">Tutor Personalizado</h2>
          <p class="text-xs text-[#898989] mt-0.5">Treino conversacional diário no LibreChat, moldado para os temas do seu dia a dia.</p>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-[#141414] border border-[#242424] flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-[#3ecf8e]/10 text-[#3ecf8e] flex items-center justify-center shrink-0 font-bold text-sm">
          0x
        </div>
        <div>
          <h2 class="text-sm font-semibold text-[#fafafa]">Sem Falsas Promessas</h2>
          <p class="text-xs text-[#898989] mt-0.5">Sem mentiras de fluência mágica em 3 meses. Evolução prática e consistente.</p>
        </div>
      </div>
    </div>
  </div>
</section>
