---
// src/components/Hero.astro
// Hero Section Premium: Autoridade do Professor + Metodologia Anti-Ilusão
// Zero preços no topo, zero travessões
import Button from './Button.astro';
---

<section class="relative pt-36 pb-24 md:pt-44 md:pb-32 px-4 sm:px-8 max-w-6xl mx-auto overflow-hidden">
  <!-- Subtle Gradient Background Orbs (Linear/Supabase Style) -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-[#3ecf8e]/8 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[300px] h-[250px] bg-[#242424]/40 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="text-center max-w-4xl mx-auto space-y-8">
    <!-- Tag de Posicionamento -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#171717] border border-[#242424] text-xs font-mono text-[#898989] shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[#3ecf8e] animate-pulse"></span>
      Mentoria Individual 1 a 1 com Gabriel Lima + Tutor Autoral de IA
    </div>

    <!-- Headline Principal: Forte, Direta, Sem Ilusão -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-[#fafafa] leading-[1.08] text-balance">
      Destrave sua fala em inglês com <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#fafafa] via-[#3ecf8e] to-[#2ebd7a]">
        aulas individuais e IA diária.
      </span>
    </h1>

    <!-- Subheadline: Convincente, Realista e Focada no Problema Real -->
    <p class="text-lg sm:text-xl text-[#898989] max-w-2xl mx-auto leading-relaxed text-pretty">
      Aprenda do mesmo jeito que você aprendeu português: falando no contexto real.
      Acompanhamento individual 1 a 1 comigo toda semana somado a um parceiro de IA autoral disponível 24h para você destravar no seu ritmo.
    </p>

    <!-- CTAs da Hero: Foco em Exploração e Conhecimento do Método (Zero Preço Aqui) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a href="#metodo">
        <Button variant="primary" size="lg" class="w-full sm:w-auto shadow-lg shadow-[#3ecf8e]/10">
          Conhecer o método na prática &rarr;
        </Button>
      </a>
      <a href="#estagios">
        <Button variant="secondary" size="lg" class="w-full sm:w-auto">
          Ver estágios de evolução
        </Button>
      </a>
    </div>

    <!-- Destaques Rápidos Compactos (Estilo Pílulas Minimalistas) -->
    <div class="pt-10 flex flex-wrap items-center justify-center gap-3 max-w-2xl mx-auto text-xs font-medium text-[#898989]">
      <div class="px-3.5 py-2 rounded-full bg-[#141414] border border-[#242424] flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="text-[#fafafa]">Encontros 1 a 1</span> toda semana com Gabe
      </div>

      <div class="px-3.5 py-2 rounded-full bg-[#141414] border border-[#242424] flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span class="text-[#fafafa]">Portal Lexi Alpha</span> 24/7 sem julgamento
      </div>

      <div class="px-3.5 py-2 rounded-full bg-[#141414] border border-[#242424] flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span class="text-[#fafafa]">Sem promessas falsas</span> de 3 meses
      </div>
    </div>
  </div>
</section>
