---
// src/components/Hero.astro — LexiQuest Hero
// Aether Luxury + Gamificação: Floating RPG Badges orbital + headline atualizado
---

<!-- RPG Badges data -->
<section id="hero" class="relative min-h-screen flex flex-col justify-center overflow-hidden noise-overlay">
  <!-- Background Parallax -->
  <div id="hero-bg" class="absolute inset-0 z-0">
    <img
      src="/assets/feature-sky.webp"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover opacity-20"
      style="filter: hue-rotate(80deg) saturate(1.3);"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0f0f0f]/70 to-[#0f0f0f]"></div>
    <!-- Emerald radial glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px] bg-[#3ecf8e]/8 rounded-full blur-[180px] pointer-events-none"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8 pt-28 pb-32 w-full">
    <div class="flex flex-col lg:flex-row lg:items-center gap-12 lg:gap-16">

      <!-- Left: Copy -->
      <div class="flex-1 min-w-0">
        <!-- Eyebrow -->
        <div id="hero-badge" class="mb-8">
          <span class="inline-flex items-center gap-2.5 text-xs font-mono text-[#898989] uppercase tracking-[0.2em]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e] animate-pulse"></span>
            LexiQuest &nbsp;&bull;&nbsp; Turma Alpha 2026 &nbsp;&bull;&nbsp; 10 Vagas
          </span>
        </div>

        <!-- Headline gamificada -->
        <h1 class="mb-8 max-w-2xl">
          <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl leading-[1.0] tracking-[-0.03em] text-[#fafafa]">
            Destrave sua fala
          </span>
          <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl leading-[1.0] tracking-[-0.03em] text-[#fafafa]">
            em inglês
          </span>
          <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl leading-[1.0] tracking-[-0.03em] text-gradient-emerald mt-2">
            jogando 15 min por dia.
          </span>
        </h1>

        <!-- Sub + CTAs -->
        <div class="flex flex-col sm:flex-row sm:items-end gap-8 max-w-xl">
          <div id="hero-sub">
            <p class="text-base sm:text-lg text-[#898989] leading-relaxed">
              Missões diárias, revisão espaçada FSRS e mentoria 1 a 1 com Gabriel Lima. O método SPARK transforma sua prática em progressão real — como subir de nível.
            </p>
          </div>

          <div id="hero-ctas" class="flex flex-col gap-3 shrink-0">
            <a
              href="#pricing"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-[#3ecf8e] text-[#0f0f0f] font-bold text-sm hover:bg-[#34b27b] active:scale-95 transition-all shadow-lg shadow-[#3ecf8e]/20 group"
            >
              <span>Garantir Vaga Alpha</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/playapp"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-full border border-[#363636] text-[#d4d4d8] text-sm font-medium hover:border-[#3ecf8e]/40 hover:text-[#fafafa] transition-all"
            >
              Testar o PlayApp grátis
            </a>
          </div>
        </div>

        <!-- Trust line -->
        <div id="hero-trust" class="mt-10 flex flex-wrap items-center gap-6 text-[#71717a] text-xs font-mono">
          <span>🎮 Missões Diárias &nbsp;&bull;&nbsp; 15 min</span>
          <span class="w-px h-3 bg-[#363636]"></span>
          <span>🧠 FSRS Science-based</span>
          <span class="w-px h-3 bg-[#363636]"></span>
          <span>🛡️ Garantia 30 dias</span>
        </div>
      </div>

      <!-- Right: Floating RPG Badges Orbital -->
      <div
        id="hero-orbital"
        class="hidden lg:flex flex-shrink-0 items-center justify-center"
        aria-hidden="true"
        style="width: 320px; height: 400px; position: relative;"
      >
        <!-- Central glow -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="w-32 h-32 rounded-full bg-[#3ecf8e]/10 blur-3xl"></div>
        </div>

        <!-- Center: LexiQuest orb -->
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10">
          <div class="w-16 h-16 rounded-full border border-[#3ecf8e]/40 bg-[#0f0f0f] flex items-center justify-center shadow-[0_0_30px_rgba(62,207,142,0.25)]">
            <span class="text-2xl" aria-hidden="true">⚔️</span>
          </div>
        </div>

        <!-- Badge 1: XP Streak — top -->
        <div class="float-badge absolute" style="top: 10px; left: 50%; transform: translateX(-50%);" id="hb-1">
          <span class="badge-icon text-[#f59e0b]">🔥</span>
          <span style="color: #f59e0b;">14 dias streak</span>
        </div>

        <!-- Badge 2: Level — top-right -->
        <div class="float-badge absolute" style="top: 70px; right: 0px;" id="hb-2">
          <span class="badge-icon">⭐</span>
          <span>Nível B1 · 2.400 XP</span>
        </div>

        <!-- Badge 3: Boss — right -->
        <div class="float-badge absolute" style="top: 50%; right: -20px; transform: translateY(-50%);" id="hb-3">
          <span class="badge-icon" style="color: #c084fc;">👹</span>
          <span style="color: #c084fc;">Boss desbloqueado</span>
        </div>

        <!-- Badge 4: Mission done — bottom-right -->
        <div class="float-badge absolute" style="bottom: 70px; right: 0px;" id="hb-4">
          <span class="badge-icon text-[#3ecf8e]">✅</span>
          <span style="color: #3ecf8e;">Missão completa</span>
        </div>

        <!-- Badge 5: Review — bottom -->
        <div class="float-badge absolute" style="bottom: 10px; left: 50%; transform: translateX(-50%);" id="hb-5">
          <span class="badge-icon">🧠</span>
          <span>FSRS: 8 cards revisados</span>
        </div>

        <!-- Badge 6: Speed — bottom-left -->
        <div class="float-badge absolute" style="bottom: 70px; left: 0px;" id="hb-6">
          <span class="badge-icon" style="color: #818cf8;">⚡</span>
          <span style="color: #818cf8;">Fala +40% mais rápido</span>
        </div>

        <!-- Badge 7: Session — left -->
        <div class="float-badge absolute" style="top: 50%; left: -20px; transform: translateY(-50%);" id="hb-7">
          <span class="badge-icon text-[#3ecf8e]">🎯</span>
          <span>Sessão 1 a 1 · hoje</span>
        </div>

        <!-- Badge 8: Vocabulary — top-left -->
        <div class="float-badge absolute" style="top: 70px; left: 0px;" id="hb-8">
          <span class="badge-icon">📖</span>
          <span>+320 chunks ativos</span>
        </div>
      </div>

    </div>

    <!-- Mobile: Badges marquee horizontal -->
    <div id="hero-marquee-wrap" class="lg:hidden mt-8 overflow-hidden relative" aria-hidden="true">
      <div id="hero-marquee" class="flex gap-3 w-max">
        <!-- duplicated for seamless loop -->
        <span class="float-badge"><span class="badge-icon text-[#f59e0b]">🔥</span> 14 dias streak</span>
        <span class="float-badge"><span class="badge-icon">⭐</span> Nível B1</span>
        <span class="float-badge"><span class="badge-icon" style="color:#c084fc">👹</span> Boss desbloqueado</span>
        <span class="float-badge"><span class="badge-icon text-[#3ecf8e]">✅</span> Missão completa</span>
        <span class="float-badge"><span class="badge-icon">🧠</span> FSRS ativo</span>
        <span class="float-badge"><span class="badge-icon" style="color:#818cf8">⚡</span> +40% mais rápido</span>
        <span class="float-badge"><span class="badge-icon">📖</span> +320 chunks</span>
        <span class="float-badge"><span class="badge-icon text-[#3ecf8e]">🎯</span> 1 a 1 · hoje</span>
        <!-- repeat -->
        <span class="float-badge"><span class="badge-icon text-[#f59e0b]">🔥</span> 14 dias streak</span>
        <span class="float-badge"><span class="badge-icon">⭐</span> Nível B1</span>
        <span class="float-badge"><span class="badge-icon" style="color:#c084fc">👹</span> Boss desbloqueado</span>
        <span class="float-badge"><span class="badge-icon text-[#3ecf8e]">✅</span> Missão completa</span>
        <span class="float-badge"><span class="badge-icon">🧠</span> FSRS ativo</span>
        <span class="float-badge"><span class="badge-icon" style="color:#818cf8">⚡</span> +40% mais rápido</span>
        <span class="float-badge"><span class="badge-icon">📖</span> +320 chunks</span>
        <span class="float-badge"><span class="badge-icon text-[#3ecf8e]">🎯</span> 1 a 1 · hoje</span>
      </div>
    </div>

  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function ready(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  ready(function () {
    if (reduced) return;

    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap) return;

    if (ST) gsap.registerPlugin(ST);

    // Reveal headline lines
    var lines = document.querySelectorAll('#hero .reveal-line');
    gsap.set(lines, { overflow: 'hidden' });
    gsap.from(lines, {
      yPercent: 110,
      duration: 1.1,
      stagger: 0.1,
      ease: 'power4.out',
      delay: 0.2
    });

    // Entrance animations
    gsap.from('#hero-badge',  { opacity: 0, y: -16, duration: 0.7, delay: 0.1, ease: 'power3.out' });
    gsap.from('#hero-sub',    { opacity: 0, y: 24,  duration: 0.9, delay: 0.55, ease: 'power3.out' });
    gsap.from('#hero-ctas',   { opacity: 0, y: 20,  duration: 0.9, delay: 0.65, ease: 'power3.out' });
    gsap.from('#hero-trust',  { opacity: 0, y: 16,  duration: 0.8, delay: 0.8,  ease: 'power2.out' });

    // Floating Badges — entrance + independent float
    var badges = document.querySelectorAll('#hero-orbital [id^="hb-"]');
    if (badges.length) {
      // Staggered entrance
      gsap.from(badges, {
        opacity: 0,
        scale: 0.75,
        duration: 0.7,
        stagger: 0.08,
        delay: 0.5,
        ease: 'back.out(1.5)'
      });

      // Independent float per badge (different durations + delays for organic feel)
      badges.forEach(function(badge, i) {
        gsap.to(badge, {
          y: (i % 2 === 0) ? -10 : 10,
          duration: 2.4 + (i * 0.25),
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
          delay: i * 0.18
        });
      });
    }

    // Mobile marquee
    var marquee = document.getElementById('hero-marquee');
    if (marquee) {
      var totalWidth = marquee.scrollWidth / 2;
      gsap.to(marquee, {
        x: '-' + totalWidth + 'px',
        duration: 22,
        ease: 'none',
        repeat: -1
      });
    }

    // Parallax BG on scroll
    if (ST) {
      gsap.to('#hero-bg', {
        yPercent: 30,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      });
    }
  });
})();
</script>
