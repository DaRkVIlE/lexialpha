---
// src/components/Hero.astro
// Hero Section Premium: Autoridade do Professor + Metodologia Anti-Ilusão
// Zero preços no topo, zero travessões
import Button from './Button.astro';
---

<section class="relative pt-36 pb-20 md:pt-44 md:pb-28 px-4 sm:px-8 max-w-6xl mx-auto overflow-hidden">
  <!-- Glow Texture & Orbs (Inspirados em Datamind & Crysiam) -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-[700px] h-[450px] opacity-25 pointer-events-none -z-10 bg-no-repeat bg-contain bg-center" style="background-image: url('/assets/feature-sky.webp'); filter: hue-rotate(90deg) saturate(1.4);"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-[#3ecf8e]/12 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[350px] h-[250px] bg-[#3ecf8e]/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

  <div class="text-center max-w-4xl mx-auto space-y-8 relative z-10">
    <!-- Tag de Posicionamento com Badge Glow -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full badge-glow text-xs font-mono text-[#fafafa] shadow-lg shadow-black/40">
      <span class="w-2 h-2 rounded-full bg-[#3ecf8e] animate-pulse"></span>
      <span class="text-[#898989]">Mentoria 1 a 1</span>
      <span class="text-[#363636]">&bull;</span>
      <span class="text-[#3ecf8e]">Gabriel Lima</span>
      <span class="text-[#363636]">&bull;</span>
      <span class="text-[#b4b4b4]">Portal Lexi Alpha</span>
    </div>

    <!-- Headline Principal: Tipografia de Alto Contraste -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[1.08] text-balance">
      <span class="text-gradient-title">Destrave sua fala em inglês com</span><br />
      <span class="text-gradient-emerald">
        aulas individuais e IA diária.
      </span>
    </h1>

    <!-- Subheadline: Convincente, Fluida e Escaneável -->
    <p class="text-lg sm:text-xl text-[#898989] max-w-2xl mx-auto leading-relaxed text-pretty">
      Aprenda do mesmo jeito que você aprendeu português: falando no contexto real.
      Acompanhamento individual comigo toda semana somado a um parceiro de IA autoral disponível 24h para você destravar no seu ritmo.
    </p>

    <!-- CTAs da Hero -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
      <a href="#metodo" class="w-full sm:w-auto">
        <Button variant="primary" size="lg" class="w-full sm:w-auto shadow-xl shadow-[#3ecf8e]/15 hover:shadow-[#3ecf8e]/25">
          Conhecer o método na prática &rarr;
        </Button>
      </a>
      <a href="#estagios" class="w-full sm:w-auto">
        <Button variant="secondary" size="lg" class="w-full sm:w-auto glass-panel hover:bg-[#1a1a1a]">
          Ver estágios de evolução
        </Button>
      </a>
    </div>

    <!-- Pílulas de Confiança Glassmorphism -->
    <div class="pt-6 flex flex-wrap items-center justify-center gap-3 max-w-2xl mx-auto text-xs font-medium">
      <div class="px-4 py-2 rounded-full glass-panel flex items-center gap-2 text-[#898989]">
        <svg class="w-4 h-4 text-[#3ecf8e] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span><strong class="text-[#fafafa]">Encontros 1 a 1</strong> semanais com Gabe</span>
      </div>

      <div class="px-4 py-2 rounded-full glass-panel flex items-center gap-2 text-[#898989]">
        <svg class="w-4 h-4 text-[#3ecf8e] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span><strong class="text-[#fafafa]">Portal Lexi Alpha</strong> 24/7 sem julgamento</span>
      </div>

      <div class="px-4 py-2 rounded-full glass-panel flex items-center gap-2 text-[#898989]">
        <svg class="w-4 h-4 text-[#3ecf8e] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span><strong class="text-[#fafafa]">Sem mentiras</strong> de fluência em 3 meses</span>
      </div>
    </div>
  </div>
</section>
