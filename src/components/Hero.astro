---
// src/components/Hero.astro — Redesign Cinematic Premium
// Inspirado em Datamind: sticky parallax bg, Cormorant editorial, split-text reveal, scroll indicator
---

<section id="hero" class="relative min-h-screen flex flex-col justify-center overflow-hidden noise-overlay">
  <!-- Background Parallax -->
  <div id="hero-bg" class="absolute inset-0 z-0">
    <img
      src="/assets/feature-sky.webp"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover opacity-20"
      style="filter: hue-rotate(80deg) saturate(1.3);"
    />
    <!-- Gradient overlay: transparent top → solid bottom -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0f0f0f]/70 to-[#0f0f0f]"></div>
    <!-- Radial glow center -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px] bg-[#3ecf8e]/8 rounded-full blur-[180px] pointer-events-none"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8 pt-28 pb-32 w-full">

    <!-- Eyebrow -->
    <div id="hero-badge" class="mb-8">
      <span class="inline-flex items-center gap-2.5 text-xs font-mono text-[#898989] uppercase tracking-[0.2em]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e] animate-pulse"></span>
        Gabe's English &nbsp;&bull;&nbsp; Turma Alpha 2026 &nbsp;&bull;&nbsp; 10 Vagas
      </span>
    </div>

    <!-- Headline Moderna e Direta -->
    <h1 class="mb-8 max-w-4xl">
      <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[1.0] tracking-[-0.03em] text-[#fafafa]">
        Você não estuda
      </span>
      <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[1.0] tracking-[-0.03em] text-[#fafafa]">
        para falar.
      </span>
      <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[1.0] tracking-[-0.03em] text-gradient-emerald mt-2">
        Você fala para aprender.
      </span>
    </h1>

    <!-- Sub + CTAs lado a lado no desktop -->
    <div class="flex flex-col md:flex-row md:items-end gap-10 md:gap-16 max-w-5xl">
      <!-- Subtítulo -->
      <div id="hero-sub" class="md:max-w-sm">
        <p class="text-base sm:text-lg text-[#898989] leading-relaxed">
          Acompanhamento individual comigo toda semana, somado a um tutor de IA exclusivo disponível 24h para você destravar no seu ritmo.
        </p>
      </div>

      <!-- CTAs -->
      <div id="hero-ctas" class="flex flex-col sm:flex-row gap-3 md:flex-col lg:flex-row shrink-0">
        <a
          href="#metodo"
          class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-[#3ecf8e] text-[#0f0f0f] font-bold text-sm hover:bg-[#34b27b] active:scale-95 transition-all shadow-lg shadow-[#3ecf8e]/20 group"
        >
          <span>Ver o método</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="#estagios"
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-full border border-[#363636] text-[#d4d4d8] text-sm font-medium hover:border-[#3ecf8e]/40 hover:text-[#fafafa] transition-all"
        >
          Estágios de evolução
        </a>
      </div>
    </div>

    <!-- Trust line -->
    <div id="hero-trust" class="mt-12 flex flex-wrap items-center gap-6 text-[#71717a] text-xs font-mono">
      <span>Encontros 1 a 1 &nbsp;&bull;&nbsp; Sem grupos</span>
      <span class="w-px h-3 bg-[#363636]"></span>
      <span>Portal Lexi Alpha 24/7</span>
      <span class="w-px h-3 bg-[#363636]"></span>
      <span>Garantia 30 dias via Pix</span>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 z-10">
    <span class="text-[10px] font-mono text-[#71717a] uppercase tracking-[0.25em]">scroll</span>
    <div class="w-px h-10 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full bg-gradient-to-b from-[#3ecf8e] to-transparent scroll-dot" style="height: 100%;"></div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function ready(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  ready(function () {
    if (reduced) return;

    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap) return;

    if (ST) gsap.registerPlugin(ST);

    // Reveal lines
    var lines = document.querySelectorAll('#hero .reveal-line');
    gsap.set(lines, { overflow: 'hidden' });
    gsap.from(lines, {
      yPercent: 110,
      duration: 1.1,
      stagger: 0.1,
      ease: 'power4.out',
      delay: 0.2
    });

    // Badge
    gsap.from('#hero-badge', { opacity: 0, y: -16, duration: 0.7, delay: 0.1, ease: 'power3.out' });

    // Sub + CTAs
    gsap.from('#hero-sub', { opacity: 0, y: 24, duration: 0.9, delay: 0.55, ease: 'power3.out' });
    gsap.from('#hero-ctas', { opacity: 0, y: 20, duration: 0.9, delay: 0.65, ease: 'power3.out' });
    gsap.from('#hero-trust', { opacity: 0, y: 16, duration: 0.8, delay: 0.8, ease: 'power2.out' });

    // Parallax BG on scroll
    if (ST) {
      gsap.to('#hero-bg', {
        yPercent: 30,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      });
    }
  });
})();
</script>
