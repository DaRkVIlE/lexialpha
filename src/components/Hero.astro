---
// src/components/Hero.astro — LexiQuest Hero
// Split layout: left=copy, right=phone mockup SVG
---

<section id="hero" class="relative min-h-screen flex flex-col justify-center overflow-hidden noise-overlay">
  <!-- Background Parallax -->
  <div id="hero-bg" class="absolute inset-0 z-0">
    <img
      src="/assets/feature-sky.webp"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover opacity-20"
      style="filter: hue-rotate(80deg) saturate(1.3);"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0f0f0f]/70 to-[#0f0f0f]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px] bg-[#3ecf8e]/8 rounded-full blur-[180px] pointer-events-none"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-8 pt-28 pb-32 w-full">
    <div class="flex flex-col lg:flex-row lg:items-center gap-12 lg:gap-16">

      <!-- Left: Copy -->
      <div class="flex-1 min-w-0">
        <!-- Eyebrow -->
        <div id="hero-badge" class="mb-8">
          <span class="inline-flex items-center gap-2.5 text-xs font-mono text-[#898989] uppercase tracking-[0.2em]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e] animate-pulse"></span>
            LexiQuest &nbsp;&bull;&nbsp; Turma Alpha 2026 &nbsp;&bull;&nbsp; 10 Vagas
          </span>
        </div>

        <!-- Headline -->
        <h1 class="mb-8 max-w-2xl">
          <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl leading-[1.0] tracking-[-0.03em] text-[#fafafa]">
            Você não estuda
          </span>
          <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl leading-[1.0] tracking-[-0.03em] text-[#fafafa]">
            para falar.
          </span>
          <span class="reveal-line block font-sans font-extrabold text-5xl sm:text-6xl md:text-7xl leading-[1.0] tracking-[-0.03em] text-gradient-emerald mt-2">
            Você fala para aprender.
          </span>
        </h1>

        <!-- Sub + CTAs -->
        <div class="flex flex-col sm:flex-row sm:items-end gap-8 max-w-xl">
          <div id="hero-sub">
            <p class="text-base sm:text-lg text-[#898989] leading-relaxed">
              Sessões individuais ao vivo com Gabriel Lima, toda semana. Mais o PlayApp SPARK Alpha para praticar nos outros dias, quando quiser.
            </p>
          </div>

          <div id="hero-ctas" class="flex flex-col gap-3 shrink-0">
            <a
              href="#metodo"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-[#3ecf8e] text-[#0f0f0f] font-bold text-sm hover:bg-[#34b27b] active:scale-95 transition-all shadow-lg shadow-[#3ecf8e]/20 group"
            >
              <span>Ver o método</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="#estagios"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-full border border-[#363636] text-[#d4d4d8] text-sm font-medium hover:border-[#3ecf8e]/40 hover:text-[#fafafa] transition-all"
            >
              Estágios de evolução
            </a>
          </div>
        </div>

        <!-- Trust line -->
        <div id="hero-trust" class="mt-10 flex flex-wrap items-center gap-6 text-[#71717a] text-xs font-mono">
          <span>Encontros 1 a 1 &nbsp;&bull;&nbsp; Sem grupos</span>
          <span class="w-px h-3 bg-[#363636]"></span>
          <span>PlayApp SPARK Alpha</span>
          <span class="w-px h-3 bg-[#363636]"></span>
          <span>Garantia 30 dias via Pix</span>
        </div>
      </div>

      <!-- Right: Phone Mockup SVG -->
      <div id="hero-phone" class="hidden lg:flex flex-shrink-0 items-center justify-center" aria-hidden="true">
        <div class="relative w-[260px]">
          <!-- Glow behind phone -->
          <div class="absolute inset-0 bg-[#3ecf8e]/10 rounded-[2.5rem] blur-3xl scale-110 pointer-events-none"></div>
          <!-- Phone frame -->
          <div class="relative rounded-[2.5rem] bg-[#0a0a0a] border border-[#2a2a2a] shadow-2xl overflow-hidden" style="aspect-ratio: 9/19.5;">
            <!-- Notch -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-20 h-5 bg-[#0a0a0a] rounded-b-2xl z-10 border-b border-x border-[#2a2a2a]"></div>
            <!-- Screen content -->
            <div class="h-full flex flex-col pt-7 pb-4 px-4 bg-[#0e0e11]">
              <!-- App label -->
              <div class="flex items-center justify-between mb-3 mt-1">
                <span class="text-[9px] font-mono text-[#3ecf8e] uppercase tracking-[0.15em]">SPARK ALPHA</span>
                <div class="flex items-center gap-1">
                  <div class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e]"></div>
                  <span class="text-[8px] font-mono text-[#71717a]">Online</span>
                </div>
              </div>

              <!-- Day band -->
              <div class="rounded-xl bg-[#151519] border border-[#26262f] p-3 mb-3 relative overflow-hidden">
                <div class="absolute top-2 right-3 font-mono font-bold text-[22px] text-[#3ecf8e]/20 leading-none select-none">01</div>
                <div class="text-[8px] font-mono text-[#3ecf8e] uppercase tracking-[0.12em] mb-1">Dia 1 de 7 &middot; 15-20 min</div>
                <div class="text-[11px] font-bold text-[#fafafa] leading-tight">Descobrir onde você trava</div>
                <div class="text-[9px] text-[#828294] mt-0.5">Medir o ponto de partida</div>
                <!-- Pillars -->
                <div class="flex gap-1 mt-2">
                  <span class="text-[7px] font-mono px-1.5 py-0.5 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/30 text-[#3ecf8e]">P</span>
                  <span class="text-[7px] font-mono px-1.5 py-0.5 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/30 text-[#3ecf8e]">R</span>
                </div>
              </div>

              <!-- Checklist -->
              <div class="space-y-1.5 mb-3">
                <div class="flex items-center gap-2 p-2 rounded-lg bg-[#151519] border border-[#26262f]">
                  <div class="w-4 h-4 rounded-md bg-[#3ecf8e] flex items-center justify-center shrink-0">
                    <svg class="w-2.5 h-2.5 text-[#0f0f0f]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span class="text-[9px] text-[#b8b8c6] leading-tight">Cole o prompt base na conversa</span>
                </div>
                <div class="flex items-center gap-2 p-2 rounded-lg bg-[#151519] border border-[#26262f]">
                  <div class="w-4 h-4 rounded-md bg-[#3ecf8e] flex items-center justify-center shrink-0">
                    <svg class="w-2.5 h-2.5 text-[#0f0f0f]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span class="text-[9px] text-[#b8b8c6] leading-tight">Tarefa 1: apresente-se por 2 min</span>
                </div>
                <div class="flex items-center gap-2 p-2 rounded-lg bg-[#151519] border border-[#26262f]">
                  <div class="w-4 h-4 rounded-md border border-[#3d3d4b] shrink-0"></div>
                  <span class="text-[9px] text-[#56566a] leading-tight">Tarefa 2: imprevisto com a IA</span>
                </div>
              </div>

              <!-- Progress ring area -->
              <div class="flex items-center gap-2 mt-auto">
                <div class="relative w-8 h-8 shrink-0">
                  <svg viewBox="0 0 36 36" class="w-full h-full -rotate-90">
                    <circle cx="18" cy="18" r="14" fill="none" stroke="#26262f" stroke-width="3"/>
                    <circle cx="18" cy="18" r="14" fill="none" stroke="#3ecf8e" stroke-width="3" stroke-dasharray="44 88" stroke-linecap="round"/>
                  </svg>
                </div>
                <div>
                  <div class="text-[8px] font-mono text-[#3ecf8e]">2 de 5 itens</div>
                  <div class="text-[7px] text-[#56566a]">Continue a missão</div>
                </div>
                <div class="ml-auto flex items-center gap-1 px-2 py-1 rounded-lg bg-[#3ecf8e] cursor-default">
                  <span class="text-[8px] font-bold text-[#06120c]">Copiar prompt</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function ready(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  ready(function () {
    if (reduced) return;

    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap) return;

    if (ST) gsap.registerPlugin(ST);

    // Reveal lines
    var lines = document.querySelectorAll('#hero .reveal-line');
    gsap.set(lines, { overflow: 'hidden' });
    gsap.from(lines, {
      yPercent: 110,
      duration: 1.1,
      stagger: 0.1,
      ease: 'power4.out',
      delay: 0.2
    });

    // Badge
    gsap.from('#hero-badge', { opacity: 0, y: -16, duration: 0.7, delay: 0.1, ease: 'power3.out' });

    // Sub + CTAs
    gsap.from('#hero-sub', { opacity: 0, y: 24, duration: 0.9, delay: 0.55, ease: 'power3.out' });
    gsap.from('#hero-ctas', { opacity: 0, y: 20, duration: 0.9, delay: 0.65, ease: 'power3.out' });
    gsap.from('#hero-trust', { opacity: 0, y: 16, duration: 0.8, delay: 0.8, ease: 'power2.out' });
    gsap.from('#hero-phone', { opacity: 0, x: 40, duration: 1.1, delay: 0.4, ease: 'power3.out' });

    // Parallax BG on scroll
    if (ST) {
      gsap.to('#hero-bg', {
        yPercent: 30,
        ease: 'none',
        scrollTrigger: {
          trigger: '#hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      });
    }
  });
})();
</script>
