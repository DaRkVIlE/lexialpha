---
// src/components/MontanhaB2.astro
// Abas Interativas dos 5 Estágios da Fala: CEFR + Cambridge Guided Learning Hours
// Como o método de Gabe atua em cada nível. Zero travessões.
import Card from './Card.astro';

const stages = [
  {
    id: 'stage-a1',
    level: 'A1',
    name: 'Descongelamento Inicial',
    hours: '90 a 100 horas guiadas (Estudo Cambridge)',
    trap: 'Tenta traduzir palavra por palavra do português e paralisa por medo de errar a regra gramatical.',
    solution: 'Injeção de Chunks Fixos de Sobrevivência. Você não conjuga verbos; memoriza blocos sonoros prontos e já produz fala real no primeiro dia com a Lexi.',
    outcome: 'Consegue se apresentar, pedir informações básicas e entender instruções simples sem pânico.'
  },
  {
    id: 'stage-a2',
    level: 'A2',
    name: 'Autonomia Cotidiana',
    hours: '180 a 200 horas guiadas (Estudo Cambridge)',
    trap: 'Vocabulário solto sem conexão estrutural. Pausas longas e desconfortáveis entre as palavras.',
    solution: 'Imersão Diária Guiada de 15 minutos no Portal Lexi Alpha. O tutor alimenta situações de rotina com input ligeiramente acima do seu nível (i+1), expandindo seu repertório sem caneta vermelha.',
    outcome: 'Descreve tarefas do trabalho, fala sobre acontecimentos do seu dia e entende o contexto de áudios comuns.'
  },
  {
    id: 'stage-b1',
    level: 'B1',
    name: 'Conversação Fluida',
    hours: '350 a 400 horas guiadas (Estudo Cambridge)',
    trap: 'O famoso platô intermediário: você entende quase tudo o que ouve e lê, mas na hora de falar sob pressão a mente dá um branco.',
    solution: 'Encontros Individuais 1 a 1 com Gabriel Lima. Trabalhamos diretamente nas suas travas emocionais de improviso, forçando raciocínio direto em inglês com feedback natural em camadas.',
    outcome: 'Participa de reuniões sem roteiro prévio, expressa opiniões pessoais e lida com imprevistos sem recorrer ao português.'
  },
  {
    id: 'stage-b2',
    level: 'B2',
    name: 'Domínio Executivo',
    hours: '500 a 600 horas guiadas (Estudo Cambridge)',
    trap: 'Dificuldade em lidar com jargões profissionais, argumentos técnicos complexos ou conversas rápidas com múltiplos nativos.',
    solution: 'Tutor de IA Hiper-Personalizado para a Sua Carreira. Calibramos a Lexi Alpha para simular negociações, entrevistas e cenários reais da sua área de atuação profissional.',
    outcome: 'Fluência profissional sólida, capacidade de persuasão, liderança de discussões e compreensão de nuances culturais.'
  },
  {
    id: 'stage-c1',
    level: 'C1',
    name: 'Autonomia Plena',
    hours: '700 a 800 horas guiadas (Estudo Cambridge)',
    trap: 'Falta de naturalidade em expressões idiomáticas sutis e metáforas avançadas da língua.',
    solution: 'Consolidação de Pensamento Instintivo. O inglês passa a ser um segundo canal primário de pensamento no seu cérebro, com esforço cognitivo próximo de zero.',
    outcome: 'Comunicação precisa, flexível e totalmente espontânea em qualquer esfera profissional ou social.'
  },
  {
    id: 'stage-c2',
    level: 'C2',
    name: 'Maestria Nativa Plena',
    hours: '1.000 a 1.200 horas guiadas (Estudo Cambridge)',
    trap: 'Sensação de estagnação após anos de estudo, com dificuldade em nuances diplomáticas e oratória de alto impacto.',
    solution: 'Imersão Dialética e Refinamento Executivo. Treino avançado de debates de alto calibre, oratória e liderança global sem qualquer atrito linguístico.',
    outcome: 'Comunicação indistinguível de um falante nativo culto, com domínio absoluto de tom, sutileza e persuasão.'
  }
];
---

<section id="estagios" class="py-24 px-4 sm:px-8 max-w-6xl mx-auto border-t border-[#242424] relative">
  <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full badge-glow text-xs font-mono text-[#3ecf8e]">
      Mapeamento Quantitativo
    </div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-balance text-gradient-title">
      Os 6 estágios práticos da fala (A1 a C2)
    </h2>
    <p class="text-base sm:text-lg text-[#898989] leading-relaxed">
      A escala internacional de proficiência (CEFR) cruzada com a média de horas de estudo guiado de Cambridge English, e a forma exata como atuamos para acelerar cada etapa.
    </p>
  </div>

  <!-- Componente Interativo com Tabs (Estilo Datamind) -->
  <div class="max-w-4xl mx-auto space-y-8" id="cefr-tab-container">
    <!-- Barra de Navegação das Abas Flutuante -->
    <div class="flex items-center justify-start sm:justify-center gap-2 p-2 rounded-full glass-panel overflow-x-auto pb-2 sm:pb-2 scrollbar-none" id="cefr-tab-buttons-bar">
      {stages.map((stage, index) => (
        <button
          type="button"
          data-stage-target={stage.id}
          class={`stage-tab-btn px-4 py-2 rounded-full text-xs font-mono font-semibold transition-all duration-200 cursor-pointer whitespace-nowrap border ${
            index === 0
              ? 'bg-[#3ecf8e] text-[#0f0f0f] border-[#3ecf8e] shadow-md shadow-[#3ecf8e]/25 active-tab font-bold'
              : 'bg-transparent text-[#898989] border-transparent hover:text-[#fafafa] hover:bg-[#1a1a1a]'
          }`}
        >
          <span class="font-bold mr-1.5">{stage.level}</span> {stage.name}
        </button>
      ))}
    </div>

    <!-- Conteúdo dos Estágios -->
    <div class="relative">
      {stages.map((stage, index) => (
        <div
          id={stage.id}
          class={`stage-pane transition-all duration-300 ${index === 0 ? 'block' : 'hidden'}`}
        >
          <div class="p-8 sm:p-10 space-y-8 rounded-3xl glass-panel border-[#3ecf8e]/25 shadow-2xl relative overflow-hidden">
            <!-- Glow Interior -->
            <div class="absolute -top-24 -right-24 w-52 h-52 bg-[#3ecf8e]/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Cabeçalho do Estágio -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#242424] relative z-10">
              <div class="flex items-center gap-3.5">
                <span class="w-12 h-12 rounded-2xl bg-[#3ecf8e]/10 text-[#3ecf8e] font-black text-xl flex items-center justify-center font-mono border border-[#3ecf8e]/30 shadow-sm shadow-[#3ecf8e]/10">
                  {stage.level}
                </span>
                <div>
                  <h3 class="text-2xl font-bold text-[#fafafa]">{stage.name}</h3>
                  <p class="text-xs font-mono text-[#898989] mt-0.5">{stage.hours}</p>
                </div>
              </div>
              <span class="inline-flex self-start sm:self-auto text-xs font-mono px-3.5 py-1.5 rounded-full badge-glow text-[#898989]">
                Referência Cambridge English
              </span>
            </div>

            <!-- Grade de Diagnóstico vs Solução -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
              <!-- Onde o Aluno Trava -->
              <div class="p-6 rounded-2xl bg-[#0f0f0f] border border-red-500/15 space-y-3">
                <div class="flex items-center gap-2 text-red-400 text-xs font-mono font-bold uppercase tracking-wider">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
                  Onde você trava no método comum
                </div>
                <p class="text-sm text-[#898989] leading-relaxed">
                  {stage.trap}
                </p>
              </div>

              <!-- Como o Método de Gabe Atua -->
              <div class="p-6 rounded-2xl bg-[#0f0f0f] border border-[#3ecf8e]/25 space-y-3">
                <div class="flex items-center gap-2 text-[#3ecf8e] text-xs font-mono font-bold uppercase tracking-wider">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e]"></span>
                  Como nosso método acelera
                </div>
                <p class="text-sm text-[#fafafa] leading-relaxed">
                  {stage.solution}
                </p>
              </div>
            </div>

            <!-- Conquista do Nível -->
            <div class="p-4 rounded-xl bg-[#0f0f0f] border border-[#242424] flex items-start sm:items-center gap-3 text-xs text-[#898989] relative z-10">
              <svg class="w-4 h-4 text-[#3ecf8e] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>
                <strong class="text-[#fafafa]">Habilidade consolidada:</strong> {stage.outcome}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Script Inline Imediato e Resiliente para Troca de Abas -->
<script is:inline>
  (function initCefrTabs() {
    function setup() {
      const buttons = document.querySelectorAll('.stage-tab-btn');
      const panes = document.querySelectorAll('.stage-pane');
      if (!buttons.length || !panes.length) return;

      buttons.forEach((btn) => {
        btn.onclick = function (e) {
          if (e) e.preventDefault();
          const targetId = btn.getAttribute('data-stage-target');

          // Reset all buttons
          buttons.forEach((b) => {
            b.classList.remove('bg-[#3ecf8e]', 'text-[#0f0f0f]', 'border-[#3ecf8e]', 'shadow-md', 'shadow-[#3ecf8e]/20', 'active-tab');
            b.classList.add('bg-[#141414]', 'text-[#898989]', 'border-[#242424]');
          });

          // Activate clicked button
          btn.classList.remove('bg-[#141414]', 'text-[#898989]', 'border-[#242424]');
          btn.classList.add('bg-[#3ecf8e]', 'text-[#0f0f0f]', 'border-[#3ecf8e]', 'shadow-md', 'shadow-[#3ecf8e]/20', 'active-tab');

          // Show targeted pane
          panes.forEach((pane) => {
            if (pane.id === targetId) {
              pane.classList.remove('hidden');
              pane.classList.add('block');
            } else {
              pane.classList.remove('block');
              pane.classList.add('hidden');
            }
          });
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
