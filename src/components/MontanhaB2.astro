---
// src/components/MontanhaB2.astro — Estágios da Fala com SVG Mountain Visual
// Montanha SVG animada com 6 zonas interativas CEFR + tabs de conteúdo

const stages = [
  {
    id: 'stage-a1',
    level: 'A1',
    name: 'Descongelamento Inicial',
    hours: '90 a 100 horas guiadas (Cambridge)',
    cy: 371,
    trapBadge: 'Tradução Palavra por Palavra',
    trap: 'Tenta traduzir mentalmente palavra por palavra do português e paralisa por medo de errar regras gramaticais.',
    solutionBadge: 'Chunks de Sobrevivência',
    solution: 'Treino de blocos de fala prontos (chunks formulaicos) que saem no reflexo. Produção oral desde a primeira semana com Companion IA no LibreChat + sessões com Gabe.',
    outcome: 'Consegue se apresentar, pedir informações básicas e entender instruções simples sem pânico.'
  },
  {
    id: 'stage-a2',
    level: 'A2',
    name: 'Autonomia Cotidiana (BICS)',
    hours: '180 a 200 horas guiadas (Cambridge)',
    cy: 310,
    trapBadge: 'Pausas Longas e Hesitação',
    trap: 'Vocabulário solto sem conexão estrutural. Pausas longas e desconfortáveis entre as palavras.',
    solutionBadge: 'Microdose Diária 15min',
    solution: '15 minutos por dia de sparring no LibreChat com Spaced Recasting + trilha guiada no Portal do Aluno. Situações reais de aeroporto, hotel e rotina.',
    outcome: 'Descreve tarefas do trabalho, relata viagens e lida com imprevistos cotidianos sem recorrer ao português.'
  },
  {
    id: 'stage-b1',
    level: 'B1',
    name: 'Conversação Fluida',
    hours: '350 a 400 horas guiadas (Cambridge)',
    cy: 244,
    trapBadge: 'Platô Intermediário',
    trap: 'O famoso platô intermediário: entende quase tudo que ouve e lê, mas na hora de falar sob pressão a mente dá um branco.',
    solutionBadge: '3 Sessões Semanais com Gabe',
    solution: 'Encontros individuais (2x15m + 1x30m) com Gabriel Lima. Destravamento das travas emocionais de improviso, forçando raciocínio direto em inglês sem caneta vermelha.',
    outcome: 'Participa de reuniões sem roteiro prévio, expressa opiniões pessoais e sustenta conversas sem hesitação.'
  },
  {
    id: 'stage-b2',
    level: 'B2',
    name: 'Domínio Executivo (Meta Alpha)',
    hours: '500 a 600 horas guiadas (Cambridge)',
    cy: 180,
    trapBadge: 'Jargões e Negociações',
    trap: 'Insegurança em negociações rápidas sob pressão, termos corporativos ou reuniões com clientes internacionais nativos.',
    solutionBadge: '2.500 Chunks + Boss Raids',
    solution: 'Consolidação de 2.500 chunks executivos acumulados (Cume da Autonomia Total). Simulações de negociações, entrevistas e Boss Raids semanais de 30 minutos com Gabriel.',
    outcome: 'Autonomia profissional completa. Lidera reuniões internacionais com autoridade e sem pedir desculpas pelo seu inglês.'
  },
  {
    id: 'stage-c1',
    level: 'C1',
    name: 'Autonomia Plena & Diplomacia',
    hours: '700 a 800 horas guiadas (Cambridge)',
    cy: 120,
    trapBadge: 'Nuances e Metáforas',
    trap: 'Falta de naturalidade em expressões idiomáticas sutis, ironia fina e metáforas avançadas da língua.',
    solutionBadge: 'Pensamento Instintivo',
    solution: 'Consolidação do pensamento direto em inglês. A língua passa a ser um segundo canal natural de raciocínio, com esforço cognitivo próximo de zero.',
    outcome: 'Comunicação precisa, flexível e totalmente espontânea em qualquer esfera profissional ou social.'
  },
  {
    id: 'stage-c2',
    level: 'C2',
    name: 'Maestria Nativa & Soberania',
    hours: '1.000 a 1.200 horas guiadas (Cambridge)',
    cy: 56,
    trapBadge: 'Estagnação Avançada',
    trap: 'Sensação de estagnação após anos de estudo, com dificuldade em nuances diplomáticas e oratória de alto impacto.',
    solutionBadge: 'Domínio e Oratória (3.500 Chunks)',
    solution: 'Treino avançado de debates, oratória e liderança global. O acervo total de 3.500 chunks consolida o domínio de tom, sutileza e persuasão.',
    outcome: 'Comunicação indistinguível de um falante nativo culto, com domínio absoluto de retórica e liderança global.'
  }
];
---

<section id="montanha-cefr" class="py-24 sm:py-28 px-4 sm:px-8 relative border-t border-[#2e224d] overflow-hidden">
  <!-- Glow atmosférico Sentry Purple + Lime -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-[#6a5fc1]/10 rounded-full blur-[180px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10 w-full">
    <!-- Header -->
    <div class="mb-14 max-w-3xl" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e] micro-pulse"></span>
        <span class="text-xs font-mono text-[#c2ef4e] uppercase tracking-[0.2em]">Mapeamento Quantitativo CEFR</span>
      </div>
      <h2 class="font-sans font-extrabold text-3xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05] mt-2 text-[#ffffff]">
        A jornada da fala em 6 etapas.<br />
        <span class="text-gradient-lime">De onde você está ao C2 nativo.</span>
      </h2>
      <p class="text-base sm:text-lg text-[#cfcfdb] leading-relaxed mt-4">
        A escala internacional de proficiência (CEFR) cruzada com a média de horas de Cambridge English, e a forma exata como aceleramos cada etapa com blocos sonoros (chunks).
      </p>
    </div>

    <!-- Layout: Mountain + Tabs -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start w-full">

      <!-- Mountain SVG Visual (visível em lg+) -->
      <div id="mountain-visual" class="hidden lg:block shrink-0 w-[280px] relative select-none rounded-3xl p-4 bg-[#271d40]/40 border border-[#3b2c60]" aria-hidden="true">
        <div class="text-[11px] font-mono text-[#cfcfdb] uppercase tracking-wider mb-2 text-center">Escalada da Fluência</div>
        
        <svg viewBox="0 0 300 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
          <defs>
            <linearGradient id="mt-grad" x1="150" y1="20" x2="150" y2="400" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#c2ef4e" stop-opacity="0.25"/>
              <stop offset="50%" stop-color="#6a5fc1" stop-opacity="0.15"/>
              <stop offset="100%" stop-color="#1f1633" stop-opacity="0.05"/>
            </linearGradient>
            <linearGradient id="mt-line-grad" x1="150" y1="20" x2="150" y2="400" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#c2ef4e" stop-opacity="0.9"/>
              <stop offset="60%" stop-color="#6a5fc1" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="#3b2c60" stop-opacity="0.3"/>
            </linearGradient>
          </defs>

          <!-- Montanha Base Contour -->
          <polygon points="150,24 280,395 20,395" fill="url(#mt-grad)" stroke="url(#mt-line-grad)" stroke-width="1.5" stroke-linejoin="round"/>

          <!-- Linhas Horizontais de Níveis -->
          <!-- C2 (Topo) -->
          <line x1="130" y1="56" x2="170" y2="56" stroke="#c2ef4e" stroke-opacity="0.4" stroke-dasharray="3 3"/>
          <!-- C1 -->
          <line x1="110" y1="120" x2="190" y2="120" stroke="#c2ef4e" stroke-opacity="0.35" stroke-dasharray="3 3"/>
          <!-- B2 (Meta Alpha) -->
          <line x1="90" y1="180" x2="210" y2="180" stroke="#c2ef4e" stroke-opacity="0.7" stroke-width="1.5"/>
          <!-- B1 -->
          <line x1="70" y1="244" x2="230" y2="244" stroke="#6a5fc1" stroke-opacity="0.4" stroke-dasharray="3 3"/>
          <!-- A2 -->
          <line x1="50" y1="310" x2="250" y2="310" stroke="#6a5fc1" stroke-opacity="0.35" stroke-dasharray="3 3"/>
          <!-- A1 -->
          <line x1="30" y1="371" x2="270" y2="371" stroke="#3b2c60" stroke-opacity="0.5"/>

          <!-- Labels dos Níveis CEFR -->
          <text x="35" y="367" font-size="11" font-family="'Source Code Pro', monospace" fill="#cfcfdb" font-weight="600">A1</text>
          <text x="55" y="306" font-size="11" font-family="'Source Code Pro', monospace" fill="#cfcfdb" font-weight="600">A2</text>
          <text x="75" y="240" font-size="11" font-family="'Source Code Pro', monospace" fill="#cfcfdb" font-weight="600">B1</text>
          <text x="95" y="176" font-size="11" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="700">B2 (Alpha)</text>
          <text x="115" y="116" font-size="11" font-family="'Source Code Pro', monospace" fill="#cfcfdb" font-weight="600">C1</text>
          <text x="135" y="52" font-size="11" font-family="'Source Code Pro', monospace" fill="#cfcfdb" font-weight="600">C2</text>

          <!-- Active indicator dot (animated by JS) -->
          <circle id="mt-indicator" cx="150" cy="371" r="5" fill="#c2ef4e" stroke="#1f1633" stroke-width="2" class="pointer-events-none transition-all duration-300" />
          <circle id="mt-indicator-ring" cx="150" cy="371" r="9" fill="none" stroke="#c2ef4e" stroke-opacity="0.5" stroke-width="1.5" class="pointer-events-none transition-all duration-300" />

          <!-- Peak star marker -->
          <circle cx="150" cy="24" r="3" fill="#c2ef4e" />
          <circle cx="150" cy="24" r="6" fill="none" stroke="#c2ef4e" stroke-opacity="0.6" stroke-width="1"/>
        </svg>
      </div>

      <!-- Tabs + Content (direita / full width com contenção segura de overflow) -->
      <div class="flex-1 min-w-0 w-full space-y-6" id="cefr-container" data-anim="fade-up">
        
        <!-- Barra de Abas (com scroll horizontal limpo no mobile e sem transpassar) -->
        <div class="w-full overflow-x-auto pb-1 scrollbar-none">
          <div class="inline-flex items-center gap-1.5 sm:gap-2 p-1.5 rounded-2xl bg-[#271d40] border border-[#3b2c60] shadow-lg">
            {stages.map((stage, index) => (
              <button
                type="button"
                data-stage-target={stage.id}
                data-stage-cy={stage.cy}
                class={`stage-tab-btn px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-xs font-mono transition-all duration-200 cursor-pointer whitespace-nowrap flex items-center gap-2 group ${
                  index === 0
                    ? 'bg-[#c2ef4e] text-[#1f1633] font-bold shadow-md shadow-[#c2ef4e]/20 active-tab'
                    : 'text-[#cfcfdb] hover:text-[#ffffff] hover:bg-[#3b2c60]'
                }`}
              >
                <span class="font-bold tracking-wider px-1.5 py-0.5 rounded bg-black/20 text-inherit">{stage.level}</span>
                <span class="hidden md:inline font-sans font-medium">{stage.name}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Conteúdo das Abas -->
        <div class="relative w-full">
          {stages.map((stage, index) => (
            <div
              id={stage.id}
              class={`stage-pane ${index === 0 ? 'block' : 'hidden'} transition-all`}
            >
              <div class="rounded-3xl bg-[#271d40] border border-[#3b2c60] p-6 sm:p-8 md:p-10 relative overflow-hidden backdrop-blur-sm shadow-2xl">
                <!-- Topo do Estágio -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 sm:gap-6 pb-6 sm:pb-8 border-b border-[#3b2c60]">
                  <div class="flex items-center gap-4 sm:gap-6">
                    <div class="font-sans font-black text-5xl sm:text-6xl md:text-7xl tracking-tighter text-gradient-lime leading-none select-none">
                      {stage.level}
                    </div>
                    <div>
                      <h3 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-[#ffffff] tracking-tight">{stage.name}</h3>
                      <p class="text-xs font-mono text-[#cfcfdb] uppercase tracking-wider mt-1">{stage.hours}</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 text-xs font-mono text-[#c2ef4e] px-3.5 py-1.5 rounded-full bg-[#c2ef4e]/10 border border-[#c2ef4e]/30 self-start md:self-auto shrink-0">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e] micro-pulse"></span>
                    <span>Referência Oficial Cambridge</span>
                  </div>
                </div>

                <!-- Split Grid: Fricção vs Aceleração -->
                <div class="grid md:grid-cols-2 gap-5 sm:gap-6 pt-6 sm:pt-8">
                  <!-- Card 1: Ponto de Fricção -->
                  <div class="p-5 sm:p-6 rounded-2xl bg-[#281a28] border border-[#4a2432]">
                    <div class="flex items-center justify-between gap-3 mb-3 sm:mb-4">
                      <div class="flex items-center gap-2 sm:gap-3">
                        <div class="w-7 h-7 rounded-lg bg-[#ffb287]/15 flex items-center justify-center text-[#ffb287] shrink-0">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                          </svg>
                        </div>
                        <span class="text-xs font-mono text-[#ffb287] uppercase tracking-wider font-semibold">Ponto de Fricção</span>
                      </div>
                      <span class="text-[10px] sm:text-xs font-mono px-2 py-0.5 rounded-md text-[#ffb287] border border-[#ffb287]/25 bg-[#ffb287]/10">{stage.trapBadge}</span>
                    </div>
                    <h4 class="text-xs sm:text-sm font-semibold text-[#ffffff] mb-2">Onde você trava no método comum:</h4>
                    <p class="text-[#cfcfdb] text-xs sm:text-sm leading-relaxed">
                      {stage.trap}
                    </p>
                  </div>

                  <!-- Card 2: Aceleração Ativa -->
                  <div class="p-5 sm:p-6 rounded-2xl bg-[#1f1633] border border-[#3b2c60]">
                    <div class="flex items-center justify-between gap-3 mb-3 sm:mb-4">
                      <div class="flex items-center gap-2 sm:gap-3">
                        <div class="w-7 h-7 rounded-lg bg-[#c2ef4e]/15 flex items-center justify-center text-[#c2ef4e] shrink-0">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                          </svg>
                        </div>
                        <span class="text-xs font-mono text-[#c2ef4e] uppercase tracking-wider font-semibold">Aceleração Ativa</span>
                      </div>
                      <span class="text-[10px] sm:text-xs font-mono px-2 py-0.5 rounded-md text-[#c2ef4e] border border-[#c2ef4e]/25 bg-[#c2ef4e]/10">{stage.solutionBadge}</span>
                    </div>
                    <h4 class="text-xs sm:text-sm font-semibold text-[#ffffff] mb-2">Como o método acelera:</h4>
                    <p class="text-[#cfcfdb] text-xs sm:text-sm leading-relaxed font-medium">
                      {stage.solution}
                    </p>
                  </div>
                </div>

                <!-- Barra Inferior: Habilidade Consolidada -->
                <div class="mt-6 pt-5 border-t border-[#3b2c60] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs sm:text-sm text-[#cfcfdb]">
                  <div class="flex items-center gap-3">
                    <div class="w-6 h-6 rounded-lg bg-[#c2ef4e]/15 flex items-center justify-center shrink-0 text-[#c2ef4e]">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <span>
                      <strong class="text-[#ffffff] font-semibold">Habilidade consolidada:</strong> {stage.outcome}
                    </span>
                  </div>
                  <span class="text-[11px] font-mono text-[#fa7faa] uppercase tracking-wider shrink-0">Marco Validado</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script Interativo das Abas CEFR e Indicador da Montanha -->
<script is:inline>
  (function() {
    function initCefrTabs() {
      const tabBtns = document.querySelectorAll('.stage-tab-btn');
      const panes = document.querySelectorAll('.stage-pane');
      const mtIndicator = document.getElementById('mt-indicator');
      const mtIndicatorRing = document.getElementById('mt-indicator-ring');

      if (!tabBtns.length || !panes.length) return;

      tabBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const targetId = btn.getAttribute('data-stage-target');
          const targetCy = btn.getAttribute('data-stage-cy');

          // Reset all buttons
          tabBtns.forEach(b => {
            b.classList.remove('bg-[#c2ef4e]', 'text-[#1f1633]', 'font-bold', 'shadow-md', 'shadow-[#c2ef4e]/20', 'active-tab');
            b.classList.add('text-[#cfcfdb]', 'hover:text-[#ffffff]', 'hover:bg-[#3b2c60]');
          });

          // Activate clicked button
          btn.classList.add('bg-[#c2ef4e]', 'text-[#1f1633]', 'font-bold', 'shadow-md', 'shadow-[#c2ef4e]/20', 'active-tab');
          btn.classList.remove('text-[#cfcfdb]', 'hover:text-[#ffffff]', 'hover:bg-[#3b2c60]');

          // Hide all panes, show target
          panes.forEach(pane => {
            if (pane.id === targetId) {
              pane.classList.remove('hidden');
              pane.classList.add('block');
            } else {
              pane.classList.add('hidden');
              pane.classList.remove('block');
            }
          });

          // Animate mountain SVG indicator if present
          if (targetCy && mtIndicator && mtIndicatorRing) {
            mtIndicator.setAttribute('cy', targetCy);
            mtIndicatorRing.setAttribute('cy', targetCy);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCefrTabs);
    } else {
      initCefrTabs();
    }
  })();
</script>
