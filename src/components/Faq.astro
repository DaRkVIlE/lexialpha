---
// src/components/Faq.astro — Seção 7: Perguntas Frequentes (03.6)
// Dúvidas Frequentes da Turma Alpha · Respostas Diretas e Transparentes
---

<section id="faq" class="py-24 sm:py-28 px-4 sm:px-8 relative border-t border-[#2e224d] overflow-hidden">
  <div class="max-w-4xl mx-auto relative z-10 w-full">
    <!-- Header -->
    <div class="mb-14 max-w-2xl" data-anim="fade-up">
      <p class="text-xs font-sans font-bold text-[#c2ef4e] uppercase tracking-[0.25em] mb-3">Tire Suas Dúvidas</p>
      <h2 class="font-sans font-extrabold text-3xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05] text-[#ffffff]">
        Perguntas Frequentes.
      </h2>
      <p class="text-base sm:text-lg text-[#cfcfdb] leading-relaxed mt-4">
        Respostas transparentes sobre a metodologia, as 3 sessões semanais e o formato da Turma Alpha.
      </p>
    </div>

    <!-- Accordion List Linear -->
    <div class="space-y-3" data-anim="fade-up">
      {[
        {
          category: 'Iniciantes',
          q: 'Eu começo do absoluto zero, o método serve para mim?',
          a: 'Sim! O Método SPARK começa exatamente como aprendemos nossa língua materna: por imersão contextual e blocos sonoros de sobrevivência (chunks). Gabriel te acompanha individualmente desde a primeira palavra, eliminando qualquer medo de errar.'
        },
        {
          category: 'Neurociência',
          q: 'Por que as aulas são divididas em 3 encontros por semana?',
          a: 'A neurociência comprova que a mielinização neural ocorre por repetição espaçada. Aulas longas de 1 hora inteira geram exaustão mental e 80% do conteúdo é esquecido em 48 horas. Três sessões curtas na semana (duas de 15 min de agilidade + uma de 30 min de Boss Raid) mantêm o inglês ativo o tempo todo sem sobrecarregar sua rotina.'
        },
        {
          category: 'Garantia Pix',
          q: 'Como funciona a garantia incondicional de 30 dias?',
          a: 'Se em 30 dias você praticar e sentir que o método não destravou sua fala, basta me mandar uma mensagem no WhatsApp que devolvo 100% do valor pago via Pix. Sem pegadinhas, sem burocracia e sem ressentimento.'
        },
        {
          category: 'Tecnologia',
          q: 'Como funciona o LibreChat e o Portal do Aluno?',
          a: 'No LibreChat você tem seu companion pessoal de IA para treinar 15 minutos diários de conversa sem vergonha, recebendo Spaced Recasting (a IA responde modelando a frase correta sem caneta vermelha). No Portal do Aluno você acessa sua trilha semanal de tarefas, gravações das suas aulas com Gabe e materiais guiados.'
        },
        {
          category: 'Investimento',
          q: 'Como funciona o valor de R$ 197/mês da Turma Alpha?',
          a: 'O valor de R$ 197/mês é exclusivo para os 15 alunos fundadores da Turma Alpha (preço regular futuro de R$ 297/mês). O pagamento é realizado diretamente via Pix manual para Gabriel no WhatsApp. Não há taxa de matrícula nem fidelidade de 1 ano: você estuda mês a mês pelo tempo que precisar.'
        }
      ].map((faq, index) => (
        <div class="faq-item rounded-2xl bg-[#271d40] border border-[#3b2c60] group transition-all duration-200">
          <button
            type="button"
            class="faq-trigger w-full text-left p-5 sm:p-6 flex items-start justify-between gap-4 cursor-pointer select-none"
            aria-expanded="false"
          >
            <div class="flex items-start gap-4">
              <span class="text-xs font-sans font-bold text-[#c2ef4e] mt-1 shrink-0 px-2 py-0.5 rounded bg-[#c2ef4e]/10 border border-[#c2ef4e]/30">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <span class="text-xs font-sans mb-1.5 inline-block text-[#fa7faa] px-2 py-0.5 rounded bg-[#fa7faa]/10 border border-[#fa7faa]/20 font-semibold">{faq.category}</span>
                <span class="text-base sm:text-lg font-bold text-[#ffffff] group-hover:text-[#c2ef4e] transition-colors leading-snug block">
                  {faq.q}
                </span>
              </div>
            </div>

            <div class="w-7 h-7 rounded-lg bg-[#1f1633] border border-[#3b2c60] flex items-center justify-center text-[#cfcfdb] group-hover:text-[#c2ef4e] group-hover:border-[#c2ef4e]/40 shrink-0 mt-1">
              <svg class="faq-icon w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
              </svg>
            </div>
          </button>

          <!-- Painel colapsável -->
          <div class="faq-content grid grid-rows-[0fr] transition-all duration-300 ease-out">
            <div class="overflow-hidden">
              <div class="px-5 sm:px-6 pb-6 text-[#cfcfdb] text-xs sm:text-sm leading-relaxed border-t border-[#3b2c60]/60 pt-4">
                {faq.a}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function initModernFaq() {
    function setup() {
      var triggers = document.querySelectorAll('.faq-trigger');
      triggers.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.closest('.faq-item');
          var content = item.querySelector('.faq-content');
          var icon = item.querySelector('.faq-icon');
          var isExpanded = btn.getAttribute('aria-expanded') === 'true';

          // Close other faqs
          triggers.forEach(function (otherBtn) {
            if (otherBtn !== btn) {
              var otherItem = otherBtn.closest('.faq-item');
              var otherContent = otherItem.querySelector('.faq-content');
              var otherIcon = otherItem.querySelector('.faq-icon');
              otherBtn.setAttribute('aria-expanded', 'false');
              if (otherContent) otherContent.style.gridTemplateRows = '0fr';
              if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
              otherItem.classList.remove('border-[#c2ef4e]/40');
            }
          });

          // Toggle current
          if (isExpanded) {
            btn.setAttribute('aria-expanded', 'false');
            content.style.gridTemplateRows = '0fr';
            if (icon) icon.style.transform = 'rotate(0deg)';
            item.classList.remove('border-[#c2ef4e]/40');
          } else {
            btn.setAttribute('aria-expanded', 'true');
            content.style.gridTemplateRows = '1fr';
            if (icon) icon.style.transform = 'rotate(45deg)';
            item.classList.add('border-[#c2ef4e]/40');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
