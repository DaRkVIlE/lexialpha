            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">C</span>
