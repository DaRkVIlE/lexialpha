---
// QuizSection.astro — Triagem de Nivelamento CEFR (A1-C1)
// Instrumento baseado em CEFR / Cambridge Quick Placement Test
// 8 questões progressivas A1→B2 com feedback por questão e resultado rico
// Padrão visual: glass-panel Datamind/Crysiam — zero emojis — SVG icons — mobile-first
---

<section id="quiz" class="relative py-24 px-4 sm:px-6 lg:px-8 bg-[#0f0f0f] border-t border-[#242424] text-[#fafafa] overflow-hidden">
  <!-- Glow de fundo sutil -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[300px] bg-[#3ecf8e]/8 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-2xl mx-auto relative z-10">
    <!-- Cabeçalho -->
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-5">
        <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-xs font-semibold text-[#3ecf8e] font-mono tracking-wide">Triagem Gratuita &bull; Baseada no CEFR</span>
      </div>
      <h2 class="font-editorial text-5xl sm:text-6xl md:text-7xl font-light tracking-tight leading-[1.02] text-[#fafafa] mb-4">
        Qual é o seu nível real<br class="hidden sm:block" />
        <span class="font-editorial italic text-gradient-emerald">de inglês hoje?</span>
      </h2>
      <p class="text-[#898989] text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
        8 perguntas rápidas para identificar seu ponto de partida real. Sem achismo. Sem teoria. Resultado imediato.
      </p>
    </div>

    <!-- Card Principal do Quiz -->
    <div id="quiz-card" class="glass-panel rounded-3xl border border-white/[0.08] p-6 sm:p-10 shadow-2xl relative overflow-hidden">
      <!-- Barra de progresso -->
      <div class="mb-7">
        <div class="flex items-center justify-between mb-2">
          <span id="step-label" class="text-xs font-mono font-semibold text-[#898989] uppercase tracking-wider">Questão 1 de 8</span>
          <span id="score-label" class="text-xs font-mono font-semibold text-[#898989]">0 acertos</span>
        </div>
        <div class="w-full bg-[#1a1a1a] h-1 rounded-full overflow-hidden border border-white/5">
          <div id="progress-bar" class="h-full bg-gradient-to-r from-[#3ecf8e] to-[#22c55e] rounded-full transition-all duration-500" style="width: 12.5%"></div>
        </div>
      </div>

      <!-- Área das Questões -->
      <div id="questions-area">
        <!-- Questão 1 (A1 — Verbo To Be) -->
        <div data-q="0" class="quiz-question">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#1a1a1a] border border-[#2a2a2a] mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#71717a]"></span>
            <span class="text-[10px] font-mono text-[#71717a] uppercase tracking-wider">Nível A1</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-[#fafafa] mb-6 leading-snug">
            Choose the correct option:<br>
            <span class="text-[#3ecf8e]">"I ___ hungry. Can we eat something?"</span>
          </h3>
          <div class="space-y-2.5">
            <button data-correct="true" class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">A</span>
              <span class="text-[#d4d4d8]">am</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">B</span>
              <span class="text-[#d4d4d8]">is</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">C</span>
              <span class="text-[#d4d4d8]">are</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">D</span>
              <span class="text-[#d4d4d8]">be</span>
            </button>
          </div>
        </div>

        <!-- Questão 2 (A1 — Compreensão básica) -->
        <div data-q="1" class="quiz-question hidden">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#1a1a1a] border border-[#2a2a2a] mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#71717a]"></span>
            <span class="text-[10px] font-mono text-[#71717a] uppercase tracking-wider">Nível A1</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-[#fafafa] mb-6 leading-snug">
            What does this mean?<br>
            <span class="text-[#3ecf8e]">"What time is it?"</span>
          </h3>
          <div class="space-y-2.5">
            <button data-correct="true" class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">A</span>
              <span class="text-[#d4d4d8]">Que horas são?</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">B</span>
              <span class="text-[#d4d4d8]">Onde fica o relógio?</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">C</span>
              <span class="text-[#d4d4d8]">Quanto tempo você tem?</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">D</span>
              <span class="text-[#d4d4d8]">Qual é o seu horário?</span>
            </button>
          </div>
        </div>

        <!-- Questão 3 (A2 — Presente simples / terceira pessoa) -->
        <div data-q="2" class="quiz-question hidden">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#1a1a1a] border border-[#2a2a2a] mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#a1a1aa]"></span>
            <span class="text-[10px] font-mono text-[#a1a1aa] uppercase tracking-wider">Nível A2</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-[#fafafa] mb-6 leading-snug">
            Complete the sentence:<br>
            <span class="text-[#3ecf8e]">"She ___ to the gym every morning before work."</span>
          </h3>
          <div class="space-y-2.5">
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">A</span>
              <span class="text-[#d4d4d8]">go</span>
            </button>
            <button data-correct="true" class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">B</span>
              <span class="text-[#d4d4d8]">goes</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">C</span>
              <span class="text-[#d4d4d8]">is going</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">D</span>
              <span class="text-[#d4d4d8]">went</span>
            </button>
          </div>
        </div>

        <!-- Questão 4 (A2 — Colocação verbal: make/do/take) -->
        <div data-q="3" class="quiz-question hidden">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#1a1a1a] border border-[#2a2a2a] mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#a1a1aa]"></span>
            <span class="text-[10px] font-mono text-[#a1a1aa] uppercase tracking-wider">Nível A2</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-[#fafafa] mb-6 leading-snug">
            Pick the right verb:<br>
            <span class="text-[#3ecf8e]">"I need to ___ an appointment with the doctor."</span>
          </h3>
          <div class="space-y-2.5">
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">A</span>
              <span class="text-[#d4d4d8]">do</span>
            </button>
            <button data-correct="true" class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">B</span>
              <span class="text-[#d4d4d8]">make</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">C</span>
              <span class="text-[#d4d4d8]">take</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">D</span>
              <span class="text-[#d4d4d8]">get</span>
            </button>
          </div>
        </div>

        <!-- Questão 5 (B1 — Expressão idiomática comum) -->
        <div data-q="4" class="quiz-question hidden">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#1a1a1a] border border-[#2a2a2a] mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e]"></span>
            <span class="text-[10px] font-mono text-[#3ecf8e] uppercase tracking-wider">Nível B1</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-[#fafafa] mb-6 leading-snug">
            What does this expression mean?<br>
            <span class="text-[#3ecf8e]">"Sorry, I'm running late."</span>
          </h3>
          <div class="space-y-2.5">
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">A</span>
              <span class="text-[#d4d4d8]">Estou correndo para chegar</span>
            </button>
            <button data-correct="true" class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">B</span>
              <span class="text-[#d4d4d8]">Estou atrasado</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">C</span>
              <span class="text-[#d4d4d8]">Saí mais cedo do que o planejado</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">D</span>
              <span class="text-[#d4d4d8]">Perdi o horário do treino</span>
            </button>
          </div>
        </div>

        <!-- Questão 6 (B1 — Past Perfect) -->
        <div data-q="5" class="quiz-question hidden">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#1a1a1a] border border-[#2a2a2a] mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e]"></span>
            <span class="text-[10px] font-mono text-[#3ecf8e] uppercase tracking-wider">Nível B1</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-[#fafafa] mb-6 leading-snug">
            Choose the correct form:<br>
            <span class="text-[#3ecf8e]">"By the time I arrived, she ___ already left."</span>
          </h3>
          <div class="space-y-2.5">
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">A</span>
              <span class="text-[#d4d4d8]">has</span>
            </button>
            <button data-correct="true" class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">B</span>
              <span class="text-[#d4d4d8]">had</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">C</span>
              <span class="text-[#d4d4d8]">have</span>
            </button>
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
              <span class="w-7 h-7 rounded-lg bg-[#1f1f1f] border border-[#2e2e2e] text-[#898989] text-xs font-bold flex items-center justify-center shrink-0 transition-all group-hover:border-[#3ecf8e]/50 group-hover:text-[#3ecf8e] font-mono">D</span>
              <span class="text-[#d4d4d8]">was</span>
            </button>
          </div>
        </div>

        <!-- Questão 7 (B2 — Idiom de negócios) -->
        <div data-q="6" class="quiz-question hidden">
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#1a1a1a] border border-[#2a2a2a] mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#60a5fa]"></span>
            <span class="text-[10px] font-mono text-[#60a5fa] uppercase tracking-wider">Nível B2</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-[#fafafa] mb-6 leading-snug">
            What does this phrase mean?<br>
            <span class="text-[#3ecf8e]">"The deal fell through."</span>
          </h3>
          <div class="space-y-2.5">
            <button class="quiz-opt w-full text-left p-4 rounded-xl border border-[#242424] bg-[#141414] hover:border-[#3ecf8e]/50 hover:bg-[#171717] transition-all text-sm sm:text-base flex items-center gap-3 group cursor-pointer">
