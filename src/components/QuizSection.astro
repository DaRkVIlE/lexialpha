---
// QuizSection.astro — Diagnóstico de Nivelamento de Fala
// Design System: Supabase Dark (Gabe's-design-system.md)
// Redirecionamento 100% fluido para o WhatsApp com diagnóstico preenchido
---

<section id="quiz" class="relative py-24 px-4 sm:px-6 lg:px-8 bg-background border-t border-border text-foreground overflow-hidden">
  <div class="max-w-3xl mx-auto relative z-10">
    <!-- Cabeçalho -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold uppercase tracking-wider mb-4">
        <span>Diagnóstico Rápido</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground mb-3">
        Descubra seu nível de fala em 3 minutos
      </h2>
      <p class="text-base text-foreground-muted">
        3 perguntas simples para identificar onde está o seu travamento e qual o seu ponto de partida na Turma Alpha.
      </p>
    </div>

    <!-- Container do Quiz Interativo -->
    <div id="quiz-container" class="rounded-3xl border border-border bg-card p-6 sm:p-10 shadow-2xl relative overflow-hidden">
      <!-- Barra de Progresso -->
      <div class="w-full bg-[#1f1f1f] h-1.5 rounded-full mb-8 overflow-hidden">
        <div id="progress-bar" class="h-full bg-primary w-1/3 transition-all duration-300"></div>
      </div>

      <!-- Passo 1: O Travamento Emocional -->
      <div id="step-1" class="quiz-step">
        <span class="text-xs font-bold text-primary uppercase tracking-wider mb-2 block">Etapa 1 de 3 • O Travamento</span>
        <h3 class="text-xl sm:text-2xl font-bold text-foreground mb-6">
          O que acontece no seu cérebro quando um estrangeiro fala com você de surpresa?
        </h3>
        <div class="space-y-3">
          <button data-level="P1" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">A</span>
              <span class="text-foreground">Meu cérebro congela. Tento traduzir palavra por palavra do português antes de falar.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P2" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">B</span>
              <span class="text-foreground">Eu entendo quase tudo o que ouço, mas me faltam palavras simples na hora de responder.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P3" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">C</span>
              <span class="text-foreground">Eu consigo bater papo, mas falo sempre com as mesmas 20 palavras repetidas.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P4" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">D</span>
              <span class="text-foreground">Travo apenas em reuniões sérias de trabalho e conversas mais formais.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
        </div>
      </div>

      <!-- Passo 2: Cenário Real -->
      <div id="step-2" class="quiz-step hidden">
        <span class="text-xs font-bold text-primary uppercase tracking-wider mb-2 block">Etapa 2 de 3 • Cenário do Dia a Dia</span>
        <h3 class="text-xl sm:text-2xl font-bold text-foreground mb-2">
          Você entra num café no exterior e o barista pergunta:
        </h3>
        <p class="text-primary italic mb-6 text-sm font-semibold">"Hey there, what can I get started for you today?"</p>
        <div class="space-y-3">
          <button data-level="P1" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">A</span>
              <span class="text-foreground">"Coffee, please." (Aponto para o cardápio com receio de pronunciar errado)</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P2" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">B</span>
              <span class="text-foreground">"I want a coffee, and where is the restroom?" (Consigo pedir, mas fico tenso)</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P3" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">C</span>
              <span class="text-foreground">"Could I get an iced Americano to go, please? By the way, is the Wi-Fi open?"</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P4" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">D</span>
              <span class="text-foreground">Peço com naturalidade e ainda puxo um comentário leve sem pensar em português.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
        </div>
      </div>

      <!-- Passo 3: O Objetivo -->
      <div id="step-3" class="quiz-step hidden">
        <span class="text-xs font-bold text-primary uppercase tracking-wider mb-2 block">Etapa 3 de 3 • Seu Objetivo Principal</span>
        <h3 class="text-xl sm:text-2xl font-bold text-foreground mb-6">
          Qual destravamento mais transformaria a sua vida hoje?
        </h3>
        <div class="space-y-3">
          <button data-level="P1" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">A</span>
              <span class="text-foreground">Parar de sentir vergonha e conseguir falar frases simples sem gaguejar.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P2" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">B</span>
              <span class="text-foreground">Viajar pelo mundo sem depender de ninguém e sem passar aperto.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P3" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">C</span>
              <span class="text-foreground">Trabalhar com clientes internacionais ou empresas que exigem inglês.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
          <button data-level="P4" class="quiz-option w-full text-left p-4 rounded-xl border border-border bg-[#171717] hover:border-primary/50 hover:bg-[#1c1c1c] transition-all font-medium text-sm sm:text-base flex items-center justify-between group cursor-pointer">
            <span class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-md bg-[#242424] text-primary text-xs font-bold flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-black transition-colors">D</span>
              <span class="text-foreground">Participar de reuniões de trabalho com autoridade, sem travar nem hesitar.</span>
            </span>
            <span class="text-foreground-muted group-hover:text-primary text-sm font-bold">→</span>
          </button>
        </div>
      </div>

      <!-- Resultado do Quiz -->
      <div id="quiz-result" class="hidden text-center py-6">
        <div class="w-16 h-16 rounded-full bg-primary/15 border border-primary/30 text-primary flex items-center justify-center mx-auto mb-4 text-2xl shadow-lg">
          <svg class="w-8 h-8 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <span class="text-xs uppercase tracking-widest text-primary font-bold block mb-1">Diagnóstico Concluído</span>
        <h3 id="result-title" class="text-2xl sm:text-3xl font-extrabold text-foreground mb-2">Estágio 1: Descongelamento</h3>
        <p id="result-rank" class="text-xs font-bold text-foreground-muted mb-4 uppercase tracking-wider">Ponto de Partida</p>
        <p id="result-desc" class="text-sm text-foreground-muted max-w-lg mx-auto mb-8 leading-relaxed">
          Identificamos seu ponto de partida. Você vai destravar a fala espontânea com o professor Gabe e treinar diariamente na IA Lexi Alpha.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            id="result-whatsapp-btn"
            href="https://wa.me/5511967239791"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full text-base font-bold bg-primary hover:bg-primary-hover text-black transition-all shadow-xl shadow-primary/20 cursor-pointer"
          >
            <span id="cta-text">Enviar Diagnóstico para o Gabe no WhatsApp &rarr;</span>
          </a>
          <button
            id="reset-quiz-btn"
            type="button"
            class="w-full sm:w-auto px-6 py-4 rounded-full text-sm font-medium text-foreground-muted hover:text-foreground border border-border hover:border-[#363636] transition-colors cursor-pointer"
          >
            Refazer Teste
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import confetti from 'canvas-confetti';

  const steps = ['step-1', 'step-2', 'step-3'];
  let currentStep = 0;
  const answers: string[] = [];

  const resultsData: Record<string, { title: string; rank: string; desc: string }> = {
    P1: {
      title: "Estágio 1: Descongelamento e Início Seguro",
      rank: "Foco: Perder o medo e destravar a primeira fala",
      desc: "Seu cérebro trava ao tentar puxar palavras porque você ainda tenta traduzir do português. O acompanhamento com o Gabe e a prática diária de 15 min na IA Lexi Alpha vão eliminar esse medo em poucos dias."
    },
    P2: {
      title: "Estágio 2: Autonomia para Viagens e Cotidiano",
      rank: "Foco: Conseguir se virar no mundo real sem tradutor",
      desc: "Você já entende bastante, mas falta agilidade no reflexo oral. Com as sessões de conversação ao vivo com o Gabe e o treino de frases prontas na IA, você ganha autonomia real."
    },
    P3: {
      title: "Estágio 3: Fluência Social e Conversação Ampla",
      rank: "Foco: Bate-papo natural sem repetir sempre as mesmas palavras",
      desc: "Você consegue se comunicar, mas sente que seu vocabulário é limitado. A Turma Alpha vai expandir seu repertório com expressões naturais e simulações com o Gabe."
    },
    P4: {
      title: "Estágio 4: Confiança Profissional e de Trabalho",
      rank: "Foco: Segurança em reuniões e conversas internacionais",
      desc: "Você precisa de clareza e autoridade ao falar sobre negócios e carreira. As sessões focadas e o treino com a IA vão te preparar para reuniões reais sem hesitação."
    }
  };

  document.querySelectorAll('.quiz-option').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = (e.currentTarget as HTMLElement).dataset.level || 'P1';
      answers.push(target);
      currentStep++;

      const progressBar = document.getElementById('progress-bar');

      if (currentStep < steps.length) {
        steps.forEach((s, idx) => {
          const el = document.getElementById(s);
          if (el) el.classList.toggle('hidden', idx !== currentStep);
        });
        if (progressBar) progressBar.style.width = `${((currentStep + 1) / 3) * 100}%`;
      } else {
        // Exibir resultado
        steps.forEach(s => {
          const el = document.getElementById(s);
          if (el) el.classList.add('hidden');
        });
        const resultDiv = document.getElementById('quiz-result');
        if (resultDiv) resultDiv.classList.remove('hidden');
        if (progressBar) progressBar.style.width = '100%';

        // Calcular maioria
        const counts: Record<string, number> = {};
        answers.forEach(a => { counts[a] = (counts[a] || 0) + 1; });
        const topLevel = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b, 'P1');
        const r = resultsData[topLevel] || resultsData.P1;

        const titleEl = document.getElementById('result-title');
        const rankEl = document.getElementById('result-rank');
        const descEl = document.getElementById('result-desc');
        const whatsappBtn = document.getElementById('result-whatsapp-btn') as HTMLAnchorElement | null;

        if (titleEl) titleEl.textContent = r.title;
        if (rankEl) rankEl.textContent = r.rank;
        if (descEl) descEl.textContent = r.desc;

        // Configurar link do WhatsApp preenchido perfeitamente
        if (whatsappBtn) {
          const message = `Oi Gabe! Fiz o diagnóstico na página e meu resultado deu: ${r.title} (${r.rank}). Quero entender como participar da Turma Alpha por R$ 197/mês 🚀`;
          whatsappBtn.href = `https://wa.me/5511967239791?text=${encodeURIComponent(message)}`;
        }

        // Salvar localmente
        try {
          localStorage.setItem('lexi_quiz_result', JSON.stringify({ topLevel, ...r }));
        } catch {}

        // Confetes de celebração
        try {
          confetti({
            particleCount: 70,
            spread: 60,
            origin: { y: 0.6 },
            colors: ['#3ecf8e', '#00c573', '#10b981']
          });
        } catch { /* Fail-safe */ }
      }
    });
  });

  const resetBtn = document.getElementById('reset-quiz-btn');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      currentStep = 0;
      answers.length = 0;
      steps.forEach((s, idx) => {
        const el = document.getElementById(s);
        if (el) el.classList.toggle('hidden', idx !== 0);
      });
      const resultDiv = document.getElementById('quiz-result');
      if (resultDiv) resultDiv.classList.add('hidden');
      const progressBar = document.getElementById('progress-bar');
      if (progressBar) progressBar.style.width = '33%';
    });
  }
</script>
