<script is:inline>
(function() {
  var TOTAL = 8;

  var results = {
    A1: {
      badge: "bg-[#1a1a1a] border-[#3a3a3a] text-[#a1a1aa]",
      cefr: "A1 • Iniciante",
      title: "Ponto de Partida: Iniciante Absoluto",
      diag: "Você ainda está nos primeiros passos do inglês, e tudo bem. Esse é o melhor momento para construir uma base real. Com o Método Gabe você vai desenvolver os chunks de fala essenciais do zero, sem gramática artificial, a partir de situações reais do seu dia a dia.",
      method: "As sessões com o Gabe são totalmente adaptadas ao A1: vocabulário do cotidiano, pronúncia desde o início e frases prontas para usar imediatamente. A IA Lexi Alpha treina sua compreensão auditiva e oral 15 minutos por dia, respeitando o seu ritmo.",
      cta: "Quero começar do início com o Gabe"
    },
    A2: {
      badge: "bg-[#1a1a1a] border-[#3a3a3a] text-[#d4d4d8]",
      cefr: "A2 • Básico",
      title: "Você Já Entende Mais do que Pensa",
      diag: "Você tem uma base. Reconhece palavras, entende frases simples, mas trava na hora de responder em tempo real. Esse gap entre entender e produzir é exatamente o que o Método Gabe elimina nas primeiras semanas.",
      method: "As sessões ao vivo reduzem o filtro afetivo que bloqueia sua fala espontânea. A IA Lexi Alpha te desafia com conversas progressivas, calibradas para expandir seu vocabulário ativo dia após dia.",
      cta: "Quero destravar minha fala com o Gabe"
    },
    B1: {
      badge: "bg-[#3ecf8e]/10 border-[#3ecf8e]/30 text-[#3ecf8e]",
      cefr: "B1 • Intermediário",
      title: "Você Fala, Mas Ainda Trava em Contexto Real",
      diag: "Você consegue se comunicar em situações simples, mas perde confiança quando o ritmo da conversa acelera ou o vocabulário fica mais específico. Você ainda pensa em português antes de responder.",
      method: "O foco das sessões com Gabe é fluência de resposta: diminuir o tempo entre ouvir e falar. A IA Lexi Alpha simula conversas em diferentes contextos, expandindo seu vocabulário ativo com expressões naturais e chunks de B1 para B2.",
      cta: "Quero ir de B1 para fluência com o Gabe"
    },
    B2: {
      badge: "bg-[#60a5fa]/10 border-[#60a5fa]/30 text-[#60a5fa]",
      cefr: "B2 • Intermediário-Avançado",
      title: "Um Passo da Fluência Total",
      diag: "Você conversa bem e se vira na maioria das situações. O que falta é precisão léxica, naturalidade idiomática e confiança em contextos de alta pressão: reuniões, negociações, conversas formais.",
      method: "As sessões com Gabe focam em refinamento de discurso, vocabulário de alto nível e autoridade vocal em conversas exigentes. A IA calibra o seu registro e te desafia com simulações de B2 para C1.",
      cta: "Quero chegar à fluência total com o Gabe"
    },
    C1: {
      badge: "bg-[#a78bfa]/10 border-[#a78bfa]/30 text-[#a78bfa]",
      cefr: "C1 • Avançado",
      title: "Avançado: Refinamento e Autoridade",
      diag: "Sua fluência é real. O que diferencia o C1 do nativo é nuance, precisão lexical e autoridade de discurso. Você é exatamente o tipo de aluno que o Método Gabe leva ao próximo nível.",
      method: "As sessões exploram idioms sofisticados, estruturas complexas e simulações de alto impacto. A IA Lexi Alpha trabalha os detalhes que separam quem fala bem de quem fala com excelência.",
      cta: "Quero o refinamento de C1 com o Gabe"
    }
  };

  var correctAnswers = 0;
  var currentQ = 0;
  var answered = false;

  function getLevel(score) {
    if (score <= 1) return 'A1';
    if (score <= 3) return 'A2';
    if (score <= 5) return 'B1';
    if (score <= 7) return 'B2';
    return 'C1';
  }

  function updateProgress(q) {
    var pct = ((q) / TOTAL) * 100;
    var bar = document.getElementById('progress-bar');
    if (bar) bar.style.width = Math.max(pct, 12.5) + '%';
    var label = document.getElementById('step-label');
    if (label) label.textContent = 'Questão ' + (q + 1) + ' de ' + TOTAL;
    var scoreLabel = document.getElementById('score-label');
    if (scoreLabel) scoreLabel.textContent = correctAnswers + ' acerto' + (correctAnswers !== 1 ? 's' : '');
  }

  function showQuestion(idx) {
    document.querySelectorAll('.quiz-question').forEach(function(el) {
      el.classList.add('hidden');
    });
    var q = document.querySelector('[data-q="' + idx + '"]');
    if (q) q.classList.remove('hidden');
    var feedback = document.getElementById('feedback-inline');
    if (feedback) feedback.classList.add('hidden');
    var nextWrap = document.getElementById('next-btn-wrap');
    if (nextWrap) nextWrap.classList.add('hidden');
    document.querySelectorAll('.quiz-opt').forEach(function(btn) {
      btn.disabled = false;
      btn.classList.remove('opacity-50');
    });
    answered = false;
    updateProgress(idx);
  }

  function showResult() {
    var questionsArea = document.getElementById('questions-area');
    var resultDiv = document.getElementById('quiz-result');
    if (questionsArea) questionsArea.classList.add('hidden');
    if (resultDiv) resultDiv.classList.remove('hidden');

    var bar = document.getElementById('progress-bar');
    if (bar) bar.style.width = '100%';
    var scoreLabel = document.getElementById('score-label');
    if (scoreLabel) scoreLabel.textContent = correctAnswers + '/8 acertos';

    var level = getLevel(correctAnswers);
    var r = results[level];

    var badge = document.getElementById('result-level-badge');
    if (badge) badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full border mb-4 ' + r.badge;
    var cefrLabel = document.getElementById('result-cefr-label');
    if (cefrLabel) cefrLabel.textContent = r.cefr;
    var title = document.getElementById('result-title');
    if (title) title.textContent = r.title;
    var scoreDisplay = document.getElementById('result-score');
    if (scoreDisplay) scoreDisplay.textContent = correctAnswers + ' de 8 acertos';
    var diag = document.getElementById('result-diag');
    if (diag) diag.textContent = r.diag;
    var method = document.getElementById('result-method');
    if (method) method.textContent = r.method;
    var ctaText = document.getElementById('result-cta-text');
    if (ctaText) ctaText.textContent = r.cta;

    var waBtn = document.getElementById('result-wa-btn');
    if (waBtn) {
      var msg = 'Oi Gabe! Fiz a triagem na página e meu resultado foi: ' + r.cefr + ' (' + correctAnswers + '/8 acertos). ' + r.cta + '.';
      waBtn.href = 'https://wa.me/5511967239791?text=' + encodeURIComponent(msg);
    }

    try {
      localStorage.setItem('lexi_quiz', JSON.stringify({ level: level, score: correctAnswers, ts: Date.now() }));
    } catch(e) {}
  }

  function bindOptions() {
    document.querySelectorAll('.quiz-opt').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (answered) return;
        answered = true;
        var isCorrect = btn.dataset.correct === 'true';
        if (isCorrect) correctAnswers++;

        // Visual feedback no botão
        if (isCorrect) {
          btn.classList.add('border-[#3ecf8e]/60', 'bg-[#3ecf8e]/10');
        } else {
          btn.classList.add('border-red-500/50', 'bg-red-500/10');
          // Show correct
          var correctBtn = document.querySelector('[data-q="' + currentQ + '"] [data-correct="true"]');
          if (correctBtn) correctBtn.classList.add('border-[#3ecf8e]/40', 'bg-[#3ecf8e]/8');
        }

        // Disable all opts in this question
        document.querySelectorAll('[data-q="' + currentQ + '"] .quiz-opt').forEach(function(b) {
          b.disabled = true;
          if (!b.dataset.correct && b !== btn) b.classList.add('opacity-40');
        });

        // Feedback inline
        var feedback = document.getElementById('feedback-inline');
        if (feedback) {
          feedback.classList.remove('hidden');
          if (isCorrect) {
            feedback.className = 'mt-4 px-4 py-3 rounded-xl border text-sm font-medium flex items-start gap-2.5 border-[#3ecf8e]/30 bg-[#3ecf8e]/8 text-[#3ecf8e]';
            feedback.innerHTML = '<svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg><span>Correto!</span>';
          } else {
            feedback.className = 'mt-4 px-4 py-3 rounded-xl border text-sm font-medium flex items-start gap-2.5 border-red-500/30 bg-red-500/8 text-red-400';
            feedback.innerHTML = '<svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg><span>Não era essa. A resposta correta está destacada.</span>';
          }
        }

        // Show next button
        var nextWrap = document.getElementById('next-btn-wrap');
        var nextBtnText = document.getElementById('next-btn-text');
        if (nextWrap) nextWrap.classList.remove('hidden');
        if (nextBtnText) {
          nextBtnText.textContent = currentQ === TOTAL - 1 ? 'Ver Meu Resultado' : 'Próxima Questão';
        }
      });
    });
  }

  var nextBtn = document.getElementById('next-btn');
  if (nextBtn) {
    nextBtn.addEventListener('click', function() {
      currentQ++;
      if (currentQ >= TOTAL) {
        showResult();
      } else {
        showQuestion(currentQ);
      }
    });
  }

  var resetBtn = document.getElementById('quiz-reset');
  if (resetBtn) {
    resetBtn.addEventListener('click', function() {
      correctAnswers = 0;
      currentQ = 0;
      answered = false;
      var questionsArea = document.getElementById('questions-area');
      var resultDiv = document.getElementById('quiz-result');
      if (questionsArea) questionsArea.classList.remove('hidden');
      if (resultDiv) resultDiv.classList.add('hidden');
      // Reset all buttons
      document.querySelectorAll('.quiz-opt').forEach(function(btn) {
        btn.disabled = false;
        btn.classList.remove('opacity-40', 'opacity-50', 'border-[#3ecf8e]/60', 'bg-[#3ecf8e]/10', 'border-red-500/50', 'bg-red-500/10', 'border-[#3ecf8e]/40', 'bg-[#3ecf8e]/8');
      });
      showQuestion(0);
    });
  }

  // Initialize
  bindOptions();
  updateProgress(0);
})();
</script>
