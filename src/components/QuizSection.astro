            <span id="result-cefr-label" class="text-xs font-mono font-bold uppercase tracking-wider"></span>
          </div>
          <h3 id="result-title" class="text-2xl sm:text-3xl font-extrabold text-gradient-title mb-1"></h3>
          <p id="result-score" class="text-xs font-mono text-[#898989] mb-5"></p>
          <p id="result-diag" class="text-sm sm:text-base text-[#a1a1aa] max-w-lg mx-auto mb-4 leading-relaxed text-left"></p>
          <div id="result-method-box" class="w-full glass-panel rounded-2xl border border-[#3ecf8e]/20 p-5 mb-7 text-left">
            <h4 class="text-xs font-mono font-bold text-[#3ecf8e] uppercase tracking-wider mb-2">Como o Método Gabe atua no seu nível:</h4>
            <p id="result-method" class="text-sm text-[#d4d4d8] leading-relaxed"></p>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col gap-3">
          <a id="result-wa-btn"
            href="https://wa.me/5511967239791"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-full py-4 px-8 rounded-2xl bg-[#3ecf8e] text-[#0f0f0f] font-bold text-base hover:bg-[#34b27b] active:scale-95 transition-all shadow-xl shadow-[#3ecf8e]/20 group"
          >
            <span id="result-cta-text">Conversar com o Gabe no WhatsApp</span>
            <svg class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <button id="quiz-reset" class="w-full py-3 rounded-2xl border border-[#242424] text-[#898989] text-sm font-medium hover:text-[#fafafa] hover:border-[#363636] transition-colors">
            Refazer o teste
          </button>
        </div>
      </div>
    </div>

    <!-- Nota rodapé -->
    <p class="text-center text-[#71717a] text-xs mt-5 font-mono">
      Baseado no framework CEFR do Common European Framework of Reference for Languages.
    </p>
  </div>
