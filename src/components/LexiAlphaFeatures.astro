---
// src/components/LexiAlphaFeatures.astro — Split: Texto + Chat Mock Visual
// Sem cards pesados — lista com separadores + mock de interface à direita
---

<section id="aulas-ia" class="py-32 px-4 sm:px-8 relative border-t border-[#1a1a1a]">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- Lado Esquerdo: Texto -->
      <div data-anim="fade-up">
        <span class="text-xs font-mono text-[#3ecf8e] uppercase tracking-[0.2em]">Rotina Sem Fricção</span>
        <h2 class="font-editorial text-4xl sm:text-5xl font-light tracking-tight mt-4 mb-6 text-[#fafafa] leading-[1.05]">
          O equilíbrio perfeito entre<br />conexão humana e IA
        </h2>
        <p class="text-[#898989] leading-relaxed mb-10 text-base">
          Você não depende apenas de um professor uma vez por semana e nem fica sozinho com um aplicativo genérico. A combinação certa de acompanhamento individual com IA parametrizada exclusivamente para você.
        </p>

        <!-- Feature list com separadores -->
        <div class="space-y-0">
          {[
            {
              icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
              title: 'Encontros 1 a 1 com Gabriel Lima',
              desc: '2 encontros rápidos de alinhamento + 1 sessão estendida de conversação plena por semana. Zero grupos dividindo atenção.'
            },
            {
              icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
              title: 'Tutor Único no Portal Lexi Alpha',
              desc: 'Não é um chatbot genérico. É parametrizado com base nos seus objetivos, profissão, gostos e travas específicas de pronúncia.'
            },
            {
              icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
              title: 'Mínimo 15 min por dia',
              desc: 'O chão mínimo para criar consistência real. Pratique áudio e texto quando quiser, sem precisar agendar com antecedência.'
            },
            {
              icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
              title: 'Ambiente seguro para errar',
              desc: 'Você treina sem qualquer julgamento ou vergonha até o som sair perfeito. Sem notas. Sem comparação com outros alunos.'
            }
          ].map((feat) => (
            <div class="flex gap-4 border-t border-[#1a1a1a] py-5 group">
              <div class="w-9 h-9 rounded-xl bg-[#141414] border border-[#242424] flex items-center justify-center shrink-0 group-hover:border-[#3ecf8e]/30 transition-colors duration-300">
                <svg class="w-4 h-4 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={feat.icon} />
              </div>
              <div>
                <h4 class="font-semibold text-[#fafafa] text-sm mb-1">{feat.title}</h4>
                <p class="text-[#898989] text-sm leading-relaxed">{feat.desc}</p>
              </div>
            </div>
          ))}
          <div class="border-t border-[#1a1a1a]"></div>
        </div>
      </div>

      <!-- Lado Direito: Mock do Portal -->
      <div class="relative" data-anim="fade-up">
        <!-- Glow atrás do mock -->
        <div class="absolute -inset-8 bg-[#3ecf8e]/5 rounded-3xl blur-3xl pointer-events-none"></div>

        <div class="relative rounded-3xl bg-[#0a0a0a] border border-[#1e1e1e] overflow-hidden shadow-2xl">
          <!-- Titlebar do app -->
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-[#1a1a1a]">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-[#1e1e1e]"></div>
              <div class="w-3 h-3 rounded-full bg-[#1e1e1e]"></div>
              <div class="w-3 h-3 rounded-full bg-[#3ecf8e]/40"></div>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-[#3ecf8e] animate-pulse"></div>
              <span class="text-[11px] font-mono text-[#71717a]">Portal Lexi Alpha &bull; Online</span>
            </div>
            <div class="w-14"></div>
          </div>

          <!-- Chat area -->
          <div class="p-5 space-y-4 min-h-[320px]">
            <!-- Mensagem IA 1 -->
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/25 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div class="bg-[#141414] border border-[#242424] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
                <p class="text-xs text-[#d4d4d8] leading-relaxed">Hey! Ready to practice? Tell me about your weekend. What did you do?</p>
              </div>
            </div>

            <!-- Mensagem User 1 -->
            <div class="flex justify-end">
              <div class="bg-[#1a2820] border border-[#3ecf8e]/20 rounded-2xl rounded-tr-none px-4 py-3 max-w-[75%]">
                <p class="text-xs text-[#a7f3d0] leading-relaxed">I go to... I went to my friend house. We watched a movie together.</p>
              </div>
            </div>

            <!-- Mensagem IA 2 (correção natural) -->
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/25 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div class="bg-[#141414] border border-[#242424] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
                <p class="text-xs text-[#d4d4d8] leading-relaxed">Nice! <span class="text-[#3ecf8e]">"My friend's house"</span>: the apostrophe-s shows it's his house. Try the full sentence again.</p>
              </div>
            </div>

            <!-- Mensagem User 2 -->
            <div class="flex justify-end">
              <div class="bg-[#1a2820] border border-[#3ecf8e]/20 rounded-2xl rounded-tr-none px-4 py-3 max-w-[75%]">
                <p class="text-xs text-[#a7f3d0] leading-relaxed">I went to my friend's house. We watched a movie. It was really good.</p>
              </div>
            </div>
          </div>

          <!-- Input área -->
          <div class="px-5 pb-5">
            <div class="flex items-center gap-3 bg-[#141414] border border-[#242424] rounded-2xl px-4 py-3">
              <span class="text-[11px] text-[#71717a] font-mono flex-1">Diga algo em inglês...</span>
              <div class="w-7 h-7 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/25 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ready(fn) {
    if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn);
  }
  ready(function () {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap || !ST || reduced) return;
    gsap.from('#aulas-ia [data-anim="fade-up"]', {
      y: 50, opacity: 0, duration: 0.9, stagger: 0.15, ease: 'power3.out',
      scrollTrigger: { trigger: '#aulas-ia', start: 'top 70%' }
    });
  });
})();
</script>
