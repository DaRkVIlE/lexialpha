---
// src/components/LexiAlphaFeatures.astro — Copy humana sem watermarks de IA
---

<section id="aulas-ia" class="py-32 px-4 sm:px-8 relative border-t border-[#1a1a1a]">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Lado Esquerdo: Texto & Topicos -->
      <div data-anim="fade-up">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e] micro-pulse"></span>
          <span class="text-xs font-mono text-[#3ecf8e] uppercase tracking-[0.2em]">Rotina Sem Friccao</span>
        </div>
        <h2 class="font-sans font-extrabold text-3xl sm:text-4xl md:text-5xl tracking-tight mt-2 mb-6 text-[#fafafa] leading-[1.08]">
          Mentor humano e IA.<br />
          <span class="text-gradient-emerald">Os dois, no lugar certo.</span>
        </h2>
        <p class="text-[#898989] leading-relaxed mb-8 text-base">
          Uma sessao semanal nao e suficiente. Um app generico nao e suficiente. O SPARK combina os dois: pratica diaria autonoma com IA e mentoria ao vivo com o Gabe.
        </p>

        <!-- Feature list -->
        <div class="space-y-3.5">
          {[
            {
              badge: 'Mentoria 1 a 1 Individual',
              icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
              title: 'Encontros 1 a 1 com Gabriel Lima',
              desc: '2 encontros rapidos de alinhamento + 1 sessao estendida de conversacao plena por semana. Zero grupos dividindo atencao.'
            },
            {
              badge: 'Tutor Calibrado',
              icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
              title: 'Tutor Unico no PlayApp SPARK Alpha',
              desc: 'Calibrado para o seu nivel, profissao e objetivos especificos. A Lexi Alpha conhece suas travas e trabalha nelas, dia apos dia.'
            },
            {
              badge: 'Micro-dose Diaria',
              icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
              title: 'Minimo 15 min por dia',
              desc: 'O chao minimo para criar consistencia real. Pratique audio e texto quando quiser, sem precisar agendar com antecedencia.'
            },
            {
              badge: 'Zero Julgamento',
              icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
              title: 'Ambiente seguro para errar',
              desc: 'Voce treina sem qualquer julgamento ou vergonha ate o som sair perfeito. Sem notas. Sem comparacao com outros alunos.'
            }
          ].map((feat) => (
            <div class="topic-card p-4 rounded-2xl bg-[#121212] border border-[#242424] flex items-start gap-4">
              <div class="icon-box text-[#3ecf8e]">
                <svg class="w-4 h-4 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={feat.icon} />
              </div>
              <div class="space-y-1 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <h4 class="font-bold text-[#fafafa] text-sm tracking-tight">{feat.title}</h4>
                  <span class="topic-badge text-[#3ecf8e] border-[#3ecf8e]/20 bg-[#3ecf8e]/10 text-[10px]">{feat.badge}</span>
                </div>
                <p class="text-[#898989] text-xs sm:text-sm leading-relaxed">{feat.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Lado Direito: Mock do Portal -->
      <div class="relative" data-anim="fade-up">
        <div class="absolute -inset-8 bg-[#3ecf8e]/6 rounded-3xl blur-3xl pointer-events-none"></div>

        <div class="relative rounded-3xl bg-[#0a0a0a] border border-[#222222] overflow-hidden shadow-2xl">
          <!-- Titlebar -->
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-[#1a1a1a]">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-[#1e1e1e]"></div>
              <div class="w-3 h-3 rounded-full bg-[#1e1e1e]"></div>
              <div class="w-3 h-3 rounded-full bg-[#3ecf8e]/40"></div>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-[#3ecf8e] micro-pulse"></div>
              <span class="text-[11px] font-mono text-[#71717a]">SPARK Alpha &bull; Online</span>
            </div>
            <div class="w-14"></div>
          </div>

          <!-- Chat area -->
          <div class="p-5 space-y-4 min-h-[320px]">
            <!-- Mensagem IA 1 -->
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/25 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div class="bg-[#141414] border border-[#242424] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
                <p class="text-xs text-[#d4d4d8] leading-relaxed">Hey! Ready to practice? Tell me about your weekend. What did you do?</p>
              </div>
            </div>

            <!-- Mensagem User 1 -->
            <div class="flex justify-end">
              <div class="bg-[#1a2820] border border-[#3ecf8e]/20 rounded-2xl rounded-tr-none px-4 py-3 max-w-[75%]">
                <p class="text-xs text-[#a7f3d0] leading-relaxed">I go to... I went to my friend house. We watched a movie together.</p>
              </div>
            </div>

            <!-- Mensagem IA 2 (correcao natural) -->
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/25 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              </div>
              <div class="bg-[#141414] border border-[#242424] rounded-2xl rounded-tl-none px-4 py-3 max-w-[85%]">
                <p class="text-xs text-[#d4d4d8] leading-relaxed">Nice! <span class="text-[#3ecf8e]">"My friend's house"</span>: the apostrophe-s shows it's his house. Try the full sentence again.</p>
              </div>
            </div>

            <!-- Mensagem User 2 -->
            <div class="flex justify-end">
              <div class="bg-[#1a2820] border border-[#3ecf8e]/20 rounded-2xl rounded-tr-none px-4 py-3 max-w-[75%]">
                <p class="text-xs text-[#a7f3d0] leading-relaxed">I went to my friend's house. We watched a movie. It was really good.</p>
              </div>
            </div>
          </div>

          <!-- Input area -->
          <div class="px-5 pb-5">
            <div class="flex items-center gap-3 bg-[#141414] border border-[#242424] rounded-2xl px-4 py-3">
              <span class="text-[11px] text-[#71717a] font-mono flex-1">Sua vez. Sem pressa.</span>
              <div class="w-7 h-7 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/25 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ready(fn) {
    if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn);
  }
  ready(function () {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap || !ST || reduced) return;

    gsap.from('#aulas-ia [data-anim="fade-up"]', {
      y: 40,
      opacity: 0,
      duration: 0.85,
      stagger: 0.12,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#aulas-ia', start: 'top 75%' }
    });
  });
})();
</script>
