---
// src/components/LexiAlphaFeatures.astro — Bento Showcase: 4 Mockups CSS do ecossistema
// Grid assimétrico: 1 card grande (lg:col-span-2) + 3 cards menores
---

<section id="aulas-ia" class="py-32 px-4 sm:px-8 relative border-t border-[#1a1a1a]">
  <div class="max-w-6xl mx-auto">

    <!-- Section Header -->
    <div class="mb-16" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e] micro-pulse"></span>
        <span class="text-xs font-mono text-[#3ecf8e] uppercase tracking-[0.2em]">O Ecossistema</span>
      </div>
      <h2 class="font-sans font-extrabold text-4xl sm:text-5xl md:text-6xl tracking-tight text-[#fafafa] leading-[1.05] max-w-2xl">
        Mentor humano e IA.<br />
        <span class="text-gradient-emerald">Os dois, no lugar certo.</span>
      </h2>
      <p class="text-[#898989] text-base mt-4 max-w-xl leading-relaxed">
        Uma sessão semanal não basta. Um app genérico não basta. O SPARK combina os dois: prática diária autônoma com IA e mentoria ao vivo com o Gabe.
      </p>
    </div>

    <!-- Bento Grid -->
    <div id="bento-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

      <!-- Card 1 (lg:col-span-2): Lexi Alpha Chat com feedback XP -->
      <div class="aether-card p-0 overflow-hidden lg:col-span-2" data-anim="fade-up">
        <!-- Titlebar -->
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-[#1a1a1a]">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-[#1e1e1e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#1e1e1e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#3ecf8e]/40"></div>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-[#3ecf8e] micro-pulse"></div>
            <span class="text-[11px] font-mono text-[#71717a]">Lexi Alpha · Sessão ao vivo</span>
          </div>
          <!-- XP badge -->
          <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#f59e0b]/15 border border-[#f59e0b]/30">
            <span class="text-[10px] font-mono text-[#f59e0b]">⭐ +120 XP</span>
          </div>
        </div>

        <!-- Chat content -->
        <div class="p-6 space-y-4 min-h-[280px]">
          <!-- IA -->
          <div class="flex items-start gap-3">
            <div class="w-7 h-7 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/25 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <div class="bg-[#141414] border border-[#242424] rounded-2xl rounded-tl-none px-4 py-3 max-w-[82%]">
              <p class="text-xs text-[#d4d4d8] leading-relaxed">Hey! Ready to practice? Tell me about your weekend. What did you do?</p>
            </div>
          </div>

          <!-- User (errado) -->
          <div class="flex justify-end">
            <div class="bg-[#1a2820] border border-[#3ecf8e]/20 rounded-2xl rounded-tr-none px-4 py-3 max-w-[72%]">
              <p class="text-xs text-[#a7f3d0] leading-relaxed">I go to... I went to my friend house. We watched a movie together.</p>
            </div>
          </div>

          <!-- IA: correção natural -->
          <div class="flex items-start gap-3">
            <div class="w-7 h-7 rounded-full bg-[#3ecf8e]/15 border border-[#3ecf8e]/25 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-[#3ecf8e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <div class="bg-[#141414] border border-[#242424] rounded-2xl rounded-tl-none px-4 py-3 max-w-[82%]">
              <p class="text-xs text-[#d4d4d8] leading-relaxed">Nice! <span class="text-[#3ecf8e] font-semibold">"My friend's house"</span> — the apostrophe-s shows possession. Try the full sentence again! <span class="typing-cursor text-[#3ecf8e]">|</span></p>
            </div>
          </div>

          <!-- User (corrigido) -->
          <div class="flex justify-end">
            <div class="bg-[#1a2820] border border-[#3ecf8e]/20 rounded-2xl rounded-tr-none px-4 py-3 max-w-[72%]">
              <p class="text-xs text-[#a7f3d0] leading-relaxed">I went to my friend's house. We watched a movie. It was really good!</p>
            </div>
          </div>
        </div>

        <!-- Bottom: XP earned -->
        <div class="px-6 pb-5 pt-2 border-t border-[#1a1a1a] flex items-center justify-between">
          <div class="text-[11px] font-mono text-[#71717a]">🎯 Chunk dominado: "my friend's house"</div>
          <div class="flex items-center gap-1 text-[11px] font-mono text-[#f59e0b]">⭐ +80 XP · chunk dominado</div>
        </div>
      </div>

      <!-- Card 2: Curva FSRS Mini SVG -->
      <div class="aether-card p-6 flex flex-col" data-anim="fade-up">
        <!-- Mini SVG FSRS -->
        <div class="mb-4 h-28 relative">
          <svg viewBox="0 0 160 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <!-- BG grid -->
            <line x1="0" y1="20" x2="160" y2="20" stroke="#1e1e1e" stroke-width="1"/>
            <line x1="0" y1="50" x2="160" y2="50" stroke="#1e1e1e" stroke-width="1"/>
            <!-- Retention curve -->
            <path d="M 0 15 C 20 15, 30 30, 40 48 C 42 48, 42 16, 44 16 C 60 16, 68 32, 80 50 C 82 50, 82 15, 84 15 C 108 15, 120 30, 160 42"
                  stroke="#3ecf8e" stroke-width="2" fill="none"/>
            <!-- Review spikes -->
            <line x1="40" y1="48" x2="40" y2="16" stroke="#3ecf8e" stroke-width="1" stroke-dasharray="2 2" opacity="0.5"/>
            <line x1="80" y1="50" x2="80" y2="15" stroke="#3ecf8e" stroke-width="1" stroke-dasharray="2 2" opacity="0.5"/>
            <!-- Dots at review points -->
            <circle cx="40" cy="16" r="2.5" fill="#3ecf8e"/>
            <circle cx="80" cy="15" r="2.5" fill="#3ecf8e"/>
            <circle cx="160" cy="42" r="2.5" fill="#3ecf8e"/>
            <!-- Labels -->
            <text x="2" y="12" fill="#3ecf8e" font-size="6" font-family="monospace">92%</text>
            <text x="2" y="78" fill="#71717a" font-size="6" font-family="monospace">0%</text>
          </svg>
        </div>

        <div class="text-xs font-mono text-[#3ecf8e] uppercase tracking-[0.15em] mb-1">🧠 FSRS Ativo</div>
        <div class="text-sm font-bold text-[#fafafa] mb-1">Revisão em 8 dias</div>
        <div class="text-xs text-[#898989] mb-4">47 cards na fila · 92% retenção</div>

        <!-- Mini progress -->
        <div class="xp-bar-track mb-1">
          <div class="xp-bar-fill" style="width: 68%;"></div>
        </div>
        <div class="text-[10px] font-mono text-[#71717a]">68% do deck consolidado</div>
      </div>

      <!-- Card 3: Boss Challenge -->
      <div class="aether-card p-6 flex flex-col" data-anim="fade-up" style="background: linear-gradient(145deg, #120d1a 0%, #111111 100%); border-color: rgba(192,132,252,0.15);">
        <div class="absolute -top-10 -right-10 w-32 h-32 bg-[#c084fc]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="mb-4 flex items-center justify-between">
          <span class="text-[10px] font-mono text-[#c084fc] uppercase tracking-[0.15em]">⚔️ Boss Challenge</span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#c084fc]/15 border border-[#c084fc]/30 text-[10px] font-mono text-[#c084fc]">Desbloqueado</span>
        </div>

        <!-- Boss card -->
        <div class="rounded-2xl bg-[#0a0a0a] border border-[#c084fc]/20 p-4 mb-4 relative overflow-hidden">
          <div class="text-2xl mb-2">👹</div>
          <div class="text-xs font-bold text-[#fafafa] mb-1">Job Interview Sim</div>
          <div class="text-[11px] text-[#898989] mb-3 leading-relaxed">Senior Dev · Remote · $120k</div>

          <!-- Boss HP bar -->
          <div class="mb-1">
            <div class="flex items-center justify-between mb-0.5">
              <span class="text-[10px] font-mono text-[#f87171]">❤️ Boss HP</span>
              <span class="text-[10px] font-mono text-[#898989]">72%</span>
            </div>
            <div class="xp-bar-track">
              <div class="h-full rounded-full" style="width: 72%; background: linear-gradient(90deg, #c084fc, #818cf8);"></div>
            </div>
          </div>
        </div>

        <div class="text-[11px] text-[#898989] leading-relaxed">
          Derrote o Boss completando a simulação de entrevista com <span class="text-[#c084fc]">3 respostas sem trava</span>.
        </div>
      </div>

      <!-- Card 4: Habit Streak Calendar -->
      <div class="aether-card p-6 flex flex-col" data-anim="fade-up">
        <div class="mb-4 flex items-center justify-between">
          <span class="text-[10px] font-mono text-[#f59e0b] uppercase tracking-[0.15em]">🔥 Streak</span>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#f59e0b]/15 border border-[#f59e0b]/30 text-[11px] font-mono font-bold text-[#f59e0b]">14 dias</span>
        </div>

        <!-- Calendar grid: 3 weeks × 7 days = 21 slots, last 14 completed -->
        <div class="grid gap-1.5 mb-4" style="grid-template-columns: repeat(7, 1fr);">
          {/* Week labels */}
          {['D','S','T','Q','Q','S','S'].map((d) => (
            <div class="text-center text-[8px] font-mono text-[#3d3d3d]">{d}</div>
          ))}
          {/* 3 weeks of days */}
          {Array.from({length: 21}, (_, i) => {
            const done = i >= 7; // last 14 days done
            const today = i === 20;
            return (
              <div
                class="rounded-md aspect-square flex items-center justify-center text-[8px] font-mono transition-colors"
                style={
                  today
                    ? 'background: #3ecf8e; color: #0f0f0f; font-weight: 700; box-shadow: 0 0 10px rgba(62,207,142,0.4);'
                    : done
                    ? 'background: rgba(62,207,142,0.2); border: 1px solid rgba(62,207,142,0.3); color: #3ecf8e;'
                    : 'background: #1a1a1a; border: 1px solid #242424; color: #3d3d3d;'
                }
              >
                {today ? '✓' : done ? '✓' : '·'}
              </div>
            );
          })}
        </div>

        <div class="text-xs font-bold text-[#fafafa] mb-0.5">🔥 14 dias consecutivos</div>
        <div class="text-[11px] text-[#898989]">Record pessoal · Meta: 21 dias</div>
        <div class="mt-3 xp-bar-track">
          <div class="xp-bar-fill" style="width: 66%;"></div>
        </div>
        <div class="text-[10px] font-mono text-[#71717a] mt-1">14 / 21 dias · 66%</div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function ready(fn) {
    if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn);
  }
  ready(function () {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger;
    if (!gsap || !ST || reduced) return;

    gsap.from('#bento-grid .aether-card', {
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#aulas-ia', start: 'top 75%' }
    });
  });
})();
</script>
