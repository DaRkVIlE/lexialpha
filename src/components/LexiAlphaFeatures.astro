---
// src/components/LexiAlphaFeatures.astro — O Ecossistema Integrado LexiQuest
// Organograma Arquitetural: LibreChat IA 24/7 ↔ Gabriel Lima 3x/sem ↔ Portal do Aluno (Moodle Hub)
---

<section id="ecossistema" class="py-24 sm:py-28 px-4 sm:px-8 relative border-t border-[#2e224d] overflow-hidden">
  <!-- Glow atmosférico -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-[#6a5fc1]/10 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10 w-full">

    <!-- Section Header -->
    <div class="text-center mb-16 max-w-3xl mx-auto" data-anim="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e] micro-pulse"></span>
        <span class="text-xs font-sans font-semibold text-[#c2ef4e] uppercase tracking-[0.2em]">O Ecossistema Completo</span>
      </div>
      <h2 class="font-sans font-extrabold text-3xl sm:text-5xl md:text-6xl tracking-tight text-[#ffffff] leading-[1.05]">
        Tutor IA e Mentor Humano.<br />
        <span class="text-gradient-lime">A engrenagem que não te deixa parar.</span>
      </h2>
      <p class="text-[#cfcfdb] text-base sm:text-lg mt-4 leading-relaxed">
        Nem app solitário de preencher lacunas, nem curso tradicional com 1 hora semanal que se perde. O ecossistema LexiQuest sincroniza três forças em um fluxo contínuo.
      </p>
    </div>

    <!-- Organograma Arquitetural Visual em SVG (Triângulo de Integração do Ecossistema) -->
    <div class="mb-14 p-6 sm:p-10 rounded-3xl bg-[#271d40]/60 border border-[#3b2c60] shadow-2xl relative" data-anim="fade-up">
      <div class="text-center mb-8">
        <span class="text-xs font-sans text-[#c2ef4e] uppercase tracking-widest font-semibold">Diagrama de Fluxo Comunicativo</span>
      </div>

      <!-- Diagrama SVG Responsivo -->
      <div class="max-w-3xl mx-auto">
        <svg viewBox="0 0 800 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto select-none" aria-hidden="true">
          <defs>
            <linearGradient id="eco-grad1" x1="400" y1="50" x2="160" y2="280" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#c2ef4e" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#6a5fc1" stop-opacity="0.8"/>
            </linearGradient>
            <linearGradient id="eco-grad2" x1="400" y1="50" x2="640" y2="280" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#c2ef4e" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#fa7faa" stop-opacity="0.8"/>
            </linearGradient>
            <linearGradient id="eco-grad3" x1="160" y1="280" x2="640" y2="280" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#6a5fc1" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#fa7faa" stop-opacity="0.8"/>
            </linearGradient>
          </defs>

          <!-- Linhas de Conexão Triangulares -->
          <line x1="400" y1="80" x2="180" y2="260" stroke="url(#eco-grad1)" stroke-width="2" stroke-dasharray="6 4"/>
          <line x1="400" y1="80" x2="620" y2="260" stroke="url(#eco-grad2)" stroke-width="2" stroke-dasharray="6 4"/>
          <line x1="220" y1="270" x2="580" y2="270" stroke="url(#eco-grad3)" stroke-width="2" stroke-dasharray="6 4"/>

          <!-- Nó Central: Método SPARK Core -->
          <circle cx="400" cy="200" r="44" fill="#1f1633" stroke="#c2ef4e" stroke-width="2"/>
          <circle cx="400" cy="200" r="54" fill="none" stroke="#c2ef4e" stroke-opacity="0.2" stroke-width="1.5"/>
          <text x="400" y="196" text-anchor="middle" font-size="14" font-family="'Rubik', sans-serif" font-weight="800" fill="#ffffff">SPARK</text>
          <text x="400" y="214" text-anchor="middle" font-size="9" font-family="'Source Code Pro', monospace" fill="#c2ef4e" font-weight="600">CORE</text>

          <!-- Nó Superior: Gabriel Lima (Mentor de Precisão) -->
          <g transform="translate(290, 20)">
            <rect x="0" y="0" width="220" height="74" rx="16" fill="#1f1633" stroke="#c2ef4e" stroke-width="1.5"/>
            <circle cx="36" cy="37" r="18" fill="#c2ef4e" fill-opacity="0.15"/>
            <path d="M30 37 L34 41 L42 33" stroke="#c2ef4e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <text x="66" y="32" font-size="13" font-family="'Rubik', sans-serif" font-weight="700" fill="#ffffff">Gabriel Lima</text>
            <text x="66" y="48" font-size="10" font-family="'Source Code Pro', monospace" fill="#c2ef4e">3x Sessões Individuais / Sem</text>
          </g>

          <!-- Nó Esquerdo: Tutor IA no LibreChat -->
          <g transform="translate(40, 230)">
            <rect x="0" y="0" width="230" height="74" rx="16" fill="#1f1633" stroke="#6a5fc1" stroke-width="1.5"/>
            <circle cx="36" cy="37" r="18" fill="#6a5fc1" fill-opacity="0.2"/>
            <circle cx="36" cy="37" r="5" fill="#6a5fc1"/>
            <text x="66" y="32" font-size="13" font-family="'Rubik', sans-serif" font-weight="700" fill="#ffffff">Tutor IA 24/7</text>
            <text x="66" y="48" font-size="10" font-family="'Source Code Pro', monospace" fill="#cfcfdb">15 min/dia · Spaced Recasting</text>
          </g>

          <!-- Nó Direito: Portal do Aluno (Moodle Hub) -->
          <g transform="translate(530, 230)">
            <rect x="0" y="0" width="230" height="74" rx="16" fill="#1f1633" stroke="#fa7faa" stroke-width="1.5"/>
            <circle cx="36" cy="37" r="18" fill="#fa7faa" fill-opacity="0.2"/>
            <path d="M30 33 H42 M30 37 H42 M30 41 H38" stroke="#fa7faa" stroke-width="2" stroke-linecap="round"/>
            <text x="66" y="32" font-size="13" font-family="'Rubik', sans-serif" font-weight="700" fill="#ffffff">Portal do Aluno</text>
            <text x="66" y="48" font-size="10" font-family="'Source Code Pro', monospace" fill="#fa7faa">Missões, Áudios & Mapa CEFR</text>
          </g>
        </svg>
      </div>
    </div>

    <!-- 3 Cartões Detalhados do Ecossistema -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- Pilar 1: Prática com IA no LibreChat -->
      <div class="aether-card p-7 sm:p-8 rounded-3xl bg-[#271d40] border border-[#3b2c60] flex flex-col justify-between" data-anim="fade-up">
        <div>
          <div class="flex items-center justify-between mb-5">
            <span class="text-xs font-sans uppercase tracking-wider text-[#6a5fc1] bg-[#6a5fc1]/10 border border-[#6a5fc1]/20 px-2.5 py-1 rounded-md font-semibold">Microdose Diária</span>
            <span class="text-xs font-sans text-[#c2ef4e]">24/7 Disponível</span>
          </div>

          <h3 class="text-xl font-bold text-[#ffffff] mb-3">Tutor IA no LibreChat</h3>
          <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed mb-6">
            O ambiente seguro para errar quantas vezes forem necessárias. Você pratica 15 minutos por dia sem medo de julgamento social, modelando pronúncia e estruturas sob a técnica de <em>Spaced Recasting</em>.
          </p>

          <div class="space-y-2 text-xs font-sans text-[#cfcfdb] pt-4 border-t border-[#3b2c60]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e]"></span>
              <span>Zero inibição ou vergonha</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e]"></span>
              <span>Simulação de rotinas e viagens</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Pilar 2: Mentoria Individual com Gabe -->
      <div class="aether-card p-7 sm:p-8 rounded-3xl bg-[#271d40] border border-[#c2ef4e]/30 flex flex-col justify-between shadow-xl" data-anim="fade-up">
        <div>
          <div class="flex items-center justify-between mb-5">
            <span class="text-xs font-sans uppercase tracking-wider text-[#c2ef4e] bg-[#c2ef4e]/10 border border-[#c2ef4e]/30 px-2.5 py-1 rounded-md font-bold">Aceleração Real</span>
            <span class="text-xs font-sans text-[#fa7faa]">3x por Semana</span>
          </div>

          <h3 class="text-xl font-bold text-[#ffffff] mb-3">Mentoria com Gabriel Lima</h3>
          <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed mb-6">
            O olhar humano cirúrgico. Duas sessões semanais de 15 minutos para agilidade motora imediata, mais uma sessão de 30 minutos de <em>Boss Raid</em> para improviso sob pressão e autoridade executiva.
          </p>

          <div class="space-y-2 text-xs font-sans text-[#cfcfdb] pt-4 border-t border-[#3b2c60]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e]"></span>
              <span>2x 15 min: Destravamento rápido</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#fa7faa]"></span>
              <span>1x 30 min: Boss Raid & Negociações</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Pilar 3: Portal do Aluno Moodle -->
      <div class="aether-card p-7 sm:p-8 rounded-3xl bg-[#271d40] border border-[#3b2c60] flex flex-col justify-between" data-anim="fade-up">
        <div>
          <div class="flex items-center justify-between mb-5">
            <span class="text-xs font-sans uppercase tracking-wider text-[#fa7faa] bg-[#fa7faa]/10 border border-[#fa7faa]/20 px-2.5 py-1 rounded-md font-semibold">Torre de Controle</span>
            <span class="text-xs font-sans text-[#cfcfdb]">Ativo na Turma Alpha</span>
          </div>

          <h3 class="text-xl font-bold text-[#ffffff] mb-3">Portal do Aluno (Moodle Hub)</h3>
          <p class="text-xs sm:text-sm text-[#cfcfdb] leading-relaxed mb-6">
            Sua base de operações. Acesso direto a todas as gravações das suas sessões individuais com Gabe, trilhas de áudios nativos, missões semanais e o painel de evolução na escala CEFR.
          </p>

          <div class="space-y-2 text-xs font-sans text-[#cfcfdb] pt-4 border-t border-[#3b2c60]">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e]"></span>
              <span>Gravações de todas as suas sessões</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e]"></span>
              <span>Biblioteca de áudios e missões</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
