    /* ============================================================
       DESIGN SYSTEM: SEMANTIC TOKENS & CRAFT OVERRIDES
       ============================================================ */
    :root {
      --brand-green: #58f27f;
      --brand-green-muted: rgba(88, 242, 127, 0.15);
      --brand-green-border: rgba(88, 242, 127, 0.35);
      --surface-dark: #121212;
      --surface-elevated: #161616;
      --border-subtle: #1c1c1c;
      --border-medium: #262626;
      --text-muted: #8d9399;
    }

    html {
      scroll-behavior: smooth;
      background-color: var(--black, #0d0d0d);
      color: var(--white, #ffffff);
    }
    body {
      background-color: var(--black, #0d0d0d);
      color: var(--white, #ffffff);
      margin: 0;
      overflow-x: hidden;
      font-family: var(--_typography---font-family--primary-font, 'Inter', sans-serif);
      -webkit-font-smoothing: antialiased;
    }

    /* Utilitários semânticos */
    .text-lime {
      color: var(--brand-green) !important;
    }
    .text-muted {
      color: var(--text-muted) !important;
    }

    /* ============================================================
       AETHER HARDWARE-ACCELERATED ANIMATIONS & MICRO-INTERACTIONS
       ============================================================ */
    @keyframes aetherMarquee {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-100%, 0, 0);
      }
    }
    .partner-wrap {
      animation: aetherMarquee 35s linear infinite;
      will-change: transform;
    }
    .partner-right:hover .partner-wrap {
      animation-play-state: paused;
    }

    /* Button hover micro-interaction: rotation of dots icon */
    .btn-01-link .btn-icon {
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-01-link:hover .btn-icon {
      transform: rotate(180deg);
    }

    /* Service cards & State cards interactive hover lift */
    .service-card, .state-card {
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.35s ease;
    }
    .service-card:hover, .state-card:hover {
      transform: translateY(-4px);
      border-color: rgba(88, 242, 127, 0.35);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 24px rgba(88, 242, 127, 0.08);
    }

    @media (prefers-reduced-motion: reduce) {
      .partner-wrap {
        animation: none !important;
      }
      .service-card:hover, .state-card:hover {
        transform: none !important;
      }
    }

    /* ============================================================
       SIMULADOR DA CAFETERIA (ESTILIZAÇÃO AETHER & CRAFT FLOOR)
       Sem emojis, sem bordas esquerdas de 3px, design puro
       ============================================================ */
    .sim-tab-btn {
      padding: 10px 22px;
      border-radius: 99px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid var(--border-medium);
      background: var(--surface-dark);
      color: var(--text-muted);
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      outline: none;
    }
    .sim-tab-btn:hover {
      border-color: #383838;
      color: #ffffff;
    }
    .sim-tab-btn.active-trad {
      background: rgba(248, 113, 113, 0.1) !important;
      border-color: rgba(248, 113, 113, 0.4) !important;
      color: #fca5a5 !important;
    }
    .sim-tab-btn.active-lexi {
      background: var(--brand-green-muted) !important;
      border-color: var(--brand-green-border) !important;
      color: var(--brand-green) !important;
    }

    .sim-chat-box {
      background-color: var(--surface-dark);
      border: 1px solid var(--stroke-colour, #171717);
      border-radius: 20px;
      padding: 32px;
      max-width: 820px;
      margin: 0 auto;
    }
    .chat-bubble {
      padding: 18px 22px;
      border-radius: 14px;
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 14px;
      transition: all 0.2s ease;
