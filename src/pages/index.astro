      transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
    }
    .quiz-input-field:focus {
      border-color: var(--brand-green) !important;
      box-shadow: 0 0 0 3px rgba(88, 242, 127, 0.15) !important;
    }
  </style>
</head>
