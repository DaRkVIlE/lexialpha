    .chat-bubble-user {
      background: var(--surface-elevated);
      border: 1px solid var(--border-medium);
      color: #ffffff;
    }
    .chat-bubble-trad {
      background: rgba(248, 113, 113, 0.05);
      border: 1px solid rgba(248, 113, 113, 0.2);
      color: #fca5a5;
