      marqueeTimeline.progress(directionSetting === 1 ? 1 : 0);

      marqueeTimeline.timeScale(baseTimeScale);

      marqueeTimelines.push({
        root: marqueeRoot,

        timeline: marqueeTimeline,

        directionSetting,

        baseTimeScale,

        scrollReactive,

        invertOnScrollUp,

        scrollReturnTween: null,
