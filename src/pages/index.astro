---
// index.astro — LexiQuest Landing Page
// Design System: Supabase Dark
// Story: Turma Alpha Launch — SPARK Alpha + Lexi Alpha
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Solution from '../components/Solution.astro';
import MontanhaB2 from '../components/MontanhaB2.astro';
import LexiAlphaFeatures from '../components/LexiAlphaFeatures.astro';
import SocialProof from '../components/SocialProof.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>LexiQuest • Destravar sua fala em inglês com o método SPARK</title>
    <meta
      name="description"
      content="Mentoria individual ao vivo com Gabriel Lima e prática diária com o PlayApp SPARK Alpha. Método real para adultos que estudam há anos mas ainda travam ao falar. 10 vagas por R$ 197/mês."
    />

    <!-- Google Fonts: Inter (Interface & Headings) & Source Code Pro (Labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Source+Code+Pro:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content="LexiQuest • Destravar sua fala em inglês com o método SPARK" />
    <meta
      property="og:description"
      content="Mentoria individual ao vivo com Gabriel Lima + PlayApp SPARK Alpha para prática diária. 10 vagas por R$ 197/mês."
    />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#0f0f0f] text-[#fafafa] selection:bg-[#3ecf8e] selection:text-[#0f0f0f]">
    <!-- Barra Superior Fixa (Datamind Glass Style) -->
    <header class="fixed top-0 inset-x-0 z-50 glass-panel border-b border-white/[0.08] px-4 sm:px-8 py-3.5 flex items-center justify-between">
      <a href="#" class="flex items-center gap-2 hover:opacity-95 transition-opacity" aria-label="LexiQuest Home">
        <Logo size="sm" showBadge={true} />
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm text-[#898989] font-medium">
        <a href="#metodo" class="hover:text-[#3ecf8e] transition-colors">Como Funciona</a>
        <a href="#estagios" class="hover:text-[#3ecf8e] transition-colors">Estágios da Fala</a>
        <a href="#aulas-ia" class="hover:text-[#3ecf8e] transition-colors">Rotina e IA</a>
        <a href="#pricing" class="hover:text-[#3ecf8e] transition-colors">Turma Alpha</a>
        <a href="#faq" class="hover:text-[#3ecf8e] transition-colors">Dúvidas</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="#pricing"
          class="px-5 py-2 rounded-full bg-[#3ecf8e] text-[#0f0f0f] text-xs sm:text-sm font-bold transition-all hover:bg-[#34b27b] active:scale-95 shadow-sm"
        >
          Conhecer Turma Alpha
        </a>
      </div>
    </header>

    <main class="flex-1 pb-20 sm:pb-0">
      <Hero />
      <Problem />
      <Solution />
      <MontanhaB2 />
      <LexiAlphaFeatures />
      <SocialProof />
      <Pricing />
      <Faq />

      <!-- PlayApp SPARK Alpha Bridge -->
      <section id="playapp" class="py-24 px-4 sm:px-8 relative border-t border-[#1a1a1a] overflow-hidden">
        <div class="absolute inset-0 dot-grid-bg opacity-60 pointer-events-none"></div>
        <div class="max-w-4xl mx-auto text-center relative z-10">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-glow mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-[#3ecf8e] micro-pulse"></span>
            <span class="text-xs font-mono text-[#3ecf8e] uppercase tracking-[0.2em]">SPARK Alpha · Playbook 7 Dias</span>
          </div>
          <h2 class="font-sans font-extrabold text-3xl sm:text-4xl md:text-5xl tracking-tight leading-[1.08] mb-5 text-[#fafafa]">
            Quer testar o método antes<br /><span class="text-gradient-emerald">de qualquer compromisso?</span>
          </h2>
          <p class="text-[#898989] text-base sm:text-lg mb-10 max-w-xl mx-auto leading-relaxed">
            O PlayApp SPARK Alpha guia seus primeiros 7 dias de prática diária. Missões curtas, chunks reais, sem instalação e sem custo.
          </p>
          <a
            href="/playapp"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl border border-[#3ecf8e]/40 text-[#3ecf8e] font-bold text-sm hover:bg-[#3ecf8e]/10 active:scale-95 transition-all group"
          >
            <span>Acessar o PlayApp SPARK Alpha</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </section>

      <FinalCTA />
    </main>

    <Footer />

    <!-- GSAP — expose globally for component is:inline scripts -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Expose globally so is:inline scripts can access them
      (window as any).gsap = gsap;
      (window as any).ScrollTrigger = ScrollTrigger;

      // Global [data-anim] fallback — components handle their own, this catches any missed ones
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        ScrollTrigger.batch('[data-anim="fade-up"]:not([data-animated])', {
          onEnter: (els) => {
            gsap.to(els, {
              opacity: 1,
              y: 0,
              duration: 0.85,
              stagger: 0.1,
              ease: 'power3.out',
              onStart: () => els.forEach((el: Element) => el.setAttribute('data-animated', '1'))
            });
          },
          start: 'top 82%',
        });
      }
    </script>
  </body>
</html>
