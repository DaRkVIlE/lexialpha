       FEATURE TABS: ESTÁGIOS DE FALA (AETHER NATIVO)
       ============================================================ */
    .stage-tab-item {
      padding: 10px 20px;
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      background-color: var(--surface-dark);
      color: var(--text-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    .stage-tab-item:hover {
      border-color: var(--border-medium);
      color: #ffffff;
    }
    .stage-tab-item.active {
      border-color: var(--brand-green-border);
      background-color: var(--brand-green-muted);
      color: var(--brand-green);
    }

    .stage-card-wrapper {
      border: 1px solid var(--stroke-colour, #171717);
      border-radius: 20px;
      background-color: var(--surface-dark);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: stretch;
      margin-top: 36px;
    }
    @media (max-width: 991px) {
      .stage-card-wrapper {
        grid-template-columns: 1fr;
      }
    }
    .stage-card-content {
      padding: 48px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .stage-card-media {
      position: relative;
      background: #080808;
      overflow: hidden;
      min-height: 320px;
    }
    .stage-card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: opacity 0.3s ease;
    }

    /* ============================================================
       QUIZ STYLES (IMPECCABLE PRECISION & ZERO ESBRANQUIÇADO)
