  <style>
    :root {
      --color-brand-cyan: #58f27f;
      --color-brand-glow: rgba(88, 242, 127, 0.15);
      --font-mono: 'IBM Plex Mono', monospace;
      --font-sans: 'IBM Plex Sans', -apple-system, sans-serif;
    }
    
    html {
      scroll-behavior: smooth;
      background-color: #0b0d0e;
      color: #e5e9ec;
    }
    
    /* Glowing accents */
    .text-glow {
      text-shadow: 0 0 16px rgba(88, 242, 127, 0.4);
    }
    
    .header_stats-dot, .cta_badge-dot, .footer_nav-card-dot, .header_card-dot {
      background-color: #58f27f !important;
      box-shadow: 0 0 8px #58f27f;
      animation: pulse-dot 2s infinite ease-in-out;
    }
    
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* Motion Design & Interactions */
    .button {
      position: relative;
      overflow: hidden;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }
    
    .button:hover {
      transform: translateY(-2px) scale(1.01);
      box-shadow: 0 8px 24px rgba(88, 242, 127, 0.25);
    }
    
    .button .button_circle {
      position: absolute;
      left: 0;
      top: 0;
      width: 120%;
      height: 200%;
      border-radius: 100vw;
      transform: translate(0, 100%);
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      z-index: 1;
    }
    
    .button:hover .button_circle {
      transform: translate(0, -15%);
    }
    
    .button .button_text {
      position: relative;
      z-index: 2;
      transition: color 0.3s ease;
    }
    
    .button.is-primary:hover .button_text {
      color: #0b0d0e;
    }

    /* Micro-interactions on Cards */
    .modalities_card-block, .how_it_works_item, .plans_card, .blog_featured-card, .story_card {
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.35s ease;
    }
    
    .modalities_card-block:hover, .how_it_works_item:hover, .blog_featured-card:hover {
      transform: translateY(-4px);
      border-color: rgba(88, 242, 127, 0.5) !important;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    }
    
    .plans_card:hover {
      transform: translateY(-6px);
    }

    /* Waveform Animation */
    @keyframes wave-bounce {
      0%, 100% { height: 6px; opacity: 0.35; }
      50% { height: 32px; opacity: 1; }
    }
    
    .wave-bar {
      width: 4px;
      border-radius: 2px;
      background: linear-gradient(to top, #10b981, #58f27f);
      animation: wave-bounce 1.2s infinite ease-in-out;
    }

    /* SPARK Kinetic Loop Stroke */
    @keyframes dash-pulse {
      to {
        stroke-dashoffset: -240;
      }
    }
    
    .spark-loop-path {
      stroke-dasharray: 8 6;
      animation: dash-pulse 12s linear infinite;
    }

    /* Energy Rail Node */
    .portal-rail-node {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #0f1315;
      border: 2px solid #58f27f;
      box-shadow: 0 0 12px rgba(88, 242, 127, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      position: relative;
      z-index: 2;
    }
    
    .portal-rail-node::after {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #58f27f;
    }

    /* Ebbinghaus Graph */
    .ebbinghaus-point {
      transition: transform 0.25s ease, filter 0.25s ease;
      cursor: pointer;
    }
    .ebbinghaus-point:hover {
      transform: scale(1.35);
      filter: drop-shadow(0 0 10px #58f27f);
    }
    
    /* Quiz Styling */
    .quiz-card {
      background: var(--_globals---colors--color-500);
      border: 1px solid var(--_globals---colors--color-600);
      border-radius: 8px;
      padding: 32px;
      margin-top: 24px;
    }
    
    .quiz-option-btn {
      width: 100%;
      text-align: left;
      padding: 16px 20px;
      border: 1px solid var(--_globals---colors--color-600);
      border-radius: 6px;
      background: rgba(255,255,255,0.02);
      color: var(--_globals---colors--color-100);
      font-family: var(--font-sans);
      font-size: 15px;
      margin-bottom: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 14px;
      transition: all 0.2s ease;
    }
    
    .quiz-option-btn:hover {
      border-color: #58f27f;
      background: rgba(88, 242, 127, 0.05);
      transform: translateX(4px);
    }
    
    .quiz-option-letter {
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      background: rgba(255,255,255,0.06);
      font-family: var(--font-mono);
      font-weight: 600;
      color: #58f27f;
      font-size: 13px;
      flex-shrink: 0;
    }
    
    .quiz-input {
      width: 100%;
      background: #0f1315;
      border: 1px solid var(--_globals---colors--color-600);
      color: #fff;
      font-family: var(--font-mono);
      font-size: 15px;
      padding: 14px 18px;
      border-radius: 6px;
      margin-top: 8px;
      margin-bottom: 20px;
      outline: none;
      transition: border-color 0.2s;
    }
    
    .quiz-input:focus {
      border-color: #58f27f;
      box-shadow: 0 0 10px rgba(88, 242, 127, 0.2);
    }
    
    /* FAQ Accordion Details */
    .faq-accordion-item {
      border: 1px solid var(--_globals---colors--color-600);
      border-radius: 6px;
      background: var(--_globals---colors--color-500);
      margin-bottom: 12px;
      overflow: hidden;
      transition: border-color 0.2s;
    }
    
    .faq-accordion-item:hover {
      border-color: rgba(88, 242, 127, 0.4);
    }
    
    .faq-accordion-summary {
      padding: 22px 24px;
      font-family: var(--font-sans);
      font-size: 17px;
      font-weight: 500;
      color: var(--_globals---colors--color-100);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      user-select: none;
      list-style: none;
    }
    
    .faq-accordion-summary::-webkit-details-marker {
      display: none;
    }
    
    .faq-accordion-icon {
      font-family: var(--font-mono);
      font-size: 18px;
      color: #58f27f;
      transition: transform 0.3s ease;
    }
    
    details[open] .faq-accordion-icon {
      transform: rotate(45deg);
    }
    
    .faq-accordion-content {
      padding: 0 24px 22px 24px;
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.65;
      color: var(--_globals---colors--color-300);
      border-top: 1px solid rgba(255,255,255,0.05);
      padding-top: 16px;
    }
  </style>
</head>
