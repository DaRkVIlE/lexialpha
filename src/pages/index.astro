---
// index.astro — LexiQuest Landing Page
// Design System: Deep Purple + Neon Lime (Sentry Purple Identity)
// Story: Turma Alpha Launch — 15 Vagas Fundadoras · Método SPARK
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import QuizNivelamento from '../components/QuizNivelamento.astro';
import Solution from '../components/Solution.astro';
import EstagiosFala from '../components/EstagiosFala.astro';
import MontanhaB2 from '../components/MontanhaB2.astro';
import LexiAlphaFeatures from '../components/LexiAlphaFeatures.astro';
import SocialProof from '../components/SocialProof.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>LexiQuest · Pare de Traduzir na Sua Cabeça · Destrave Sua Fala em 30 Dias</title>
    <meta
      name="description"
      content="15 minutos diários de prática com IA sem julgamento + 3 sessões individuais por semana com o professor Gabriel. 15 vagas Alpha por R$ 197/mês."
    />

    <!-- Google Fonts: Rubik + Inter + Source Code Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Rubik:wght@400;500;600;700;800;900&family=Source+Code+Pro:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content="LexiQuest · Pare de Traduzir na Sua Cabeça · Destrave Sua Fala em 30 Dias" />
    <meta
      property="og:description"
      content="15 minutos diários de prática com IA sem julgamento + 3 sessões individuais por semana com o professor Gabriel. 15 vagas Alpha."
    />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#1f1633] text-[#ffffff] selection:bg-[#c2ef4e] selection:text-[#1f1633]">
    <!-- Barra Superior Fixa (Aether Glass Style + Streak HUD) -->
    <header class="fixed top-0 inset-x-0 z-50 glass-panel border-b border-[#3b2c60] px-4 sm:px-8 py-3.5 flex items-center justify-between">
      <a href="#" class="flex items-center gap-2 hover:opacity-95 transition-opacity" aria-label="LexiQuest Home">
        <Logo size="sm" showBadge={true} />
      </a>

      <nav class="hidden md:flex items-center gap-6 lg:gap-7 text-xs lg:text-sm text-[#cfcfdb] font-medium">
        <a href="#metodo" class="hover:text-[#c2ef4e] transition-colors">Como Funciona</a>
        <a href="#quiz" class="hover:text-[#c2ef4e] transition-colors flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e] micro-pulse"></span>
          <span>Teste 2 Min</span>
        </a>
        <a href="#estagios" class="hover:text-[#c2ef4e] transition-colors">Estágios da Fala</a>
        <a href="#montanha-cefr" class="hover:text-[#c2ef4e] transition-colors">Escala CEFR</a>
        <a href="#ecossistema" class="hover:text-[#c2ef4e] transition-colors">Ecossistema</a>
        <a href="#pricing" class="hover:text-[#c2ef4e] transition-colors">Turma Alpha (15 Vagas)</a>
        <a href="#faq" class="hover:text-[#c2ef4e] transition-colors">Dúvidas</a>
      </nav>

      <div class="flex items-center gap-3">
        <!-- Mini Streak HUD -->
        <div class="hidden lg:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#271d40] border border-[#3b2c60] text-xs font-mono text-[#cfcfdb] shadow-inner" aria-hidden="true">
          <span class="w-2 h-2 rounded-full bg-[#fa7faa] micro-pulse"></span>
          <span>Streak: <strong class="text-[#ffffff]">14 dias</strong></span>
        </div>

        <a
          href="#quiz"
          class="px-4 sm:px-5 py-2 rounded-full bg-[#c2ef4e] text-[#1f1633] text-xs sm:text-sm font-sans font-extrabold transition-all hover:bg-[#b0dc41] active:scale-95 shadow-sm shadow-[#c2ef4e]/20"
        >
          Fazer o Teste (Grátis)
        </a>
      </div>
    </header>

    <main class="flex-1 pb-20 sm:pb-0">
      <Hero />
      <Problem />
      <QuizNivelamento />
      <Solution />
      <EstagiosFala />
      <MontanhaB2 />
      <LexiAlphaFeatures />
      <SocialProof />
      <Pricing />
      <Faq />
      <FinalCTA />
    </main>

    <Footer />

    <!-- GSAP — expose globally for component is:inline scripts -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      (window as any).gsap = gsap;
      (window as any).ScrollTrigger = ScrollTrigger;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        ScrollTrigger.batch('[data-anim="fade-up"]:not([data-animated])', {
          onEnter: (els) => {
            gsap.to(els, {
              opacity: 1,
              y: 0,
              duration: 0.85,
              stagger: 0.1,
              ease: 'power3.out',
              onStart: () => els.forEach((el: Element) => el.setAttribute('data-animated', '1'))
            });
          },
          start: 'top 85%',
        });

        ScrollTrigger.batch('[data-anim="scale-in"]:not([data-animated])', {
          onEnter: (els) => {
            gsap.to(els, {
              opacity: 1,
              scale: 1,
              duration: 0.85,
              stagger: 0.1,
              ease: 'power3.out',
              onStart: () => els.forEach((el: Element) => el.setAttribute('data-animated', '1'))
            });
          },
          start: 'top 85%',
        });

        ScrollTrigger.batch('[data-anim="fade-in"]:not([data-animated])', {
          onEnter: (els) => {
            gsap.to(els, {
              opacity: 1,
              duration: 0.85,
              stagger: 0.1,
              ease: 'power2.out',
              onStart: () => els.forEach((el: Element) => el.setAttribute('data-animated', '1'))
            });
          },
          start: 'top 85%',
        });
      }

      // Safety fallback: ensure nothing stays hidden under any circumstances
      setTimeout(() => {
        document.querySelectorAll('[data-anim]:not([data-animated])').forEach((el) => {
          (el as HTMLElement).style.opacity = '1';
          (el as HTMLElement).style.transform = 'none';
        });
      }, 1500);
    </script>
  </body>
</html>
