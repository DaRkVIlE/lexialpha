---
// index.astro — LexiQuest Landing Page
// Design System: Deep Purple + Neon Lime (Sentry Purple Identity)
// Story: Turma Alpha Launch — 15 Vagas Fundadoras · Método SPARK
// Arquitetura Enxuta em 7 Blocos (Baseada na Auditoria UX/UI)
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import QuizNivelamento from '../components/QuizNivelamento.astro';
import Solution from '../components/Solution.astro';
import AboutGabriel from '../components/AboutGabriel.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCTA from '../components/FinalCTA.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>LexiQuest · Pare de Traduzir na Sua Cabeça · Destrave Sua Fala em 30 Dias</title>
    <meta
      name="description"
      content="15 minutos diários de prática com IA sem julgamento + 3 sessões individuais por semana com o professor Gabriel. 15 vagas Alpha por R$ 197/mês."
    />

    <!-- Google Fonts: Rubik + Inter + Source Code Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Rubik:wght@400;500;600;700;800;900&family=Source+Code+Pro:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph & WhatsApp Preview -->
    <meta property="og:title" content="LexiQuest · Pare de Traduzir na Sua Cabeça · Destrave Sua Fala em 30 Dias" />
    <meta
      property="og:description"
      content="15 minutos diários de prática com IA sem julgamento + 3 sessões individuais por semana com o professor Gabriel. 15 vagas Alpha por R$ 197/mês."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://landing-pi-jade-44.vercel.app" />
    <meta property="og:image" content="https://landing-pi-jade-44.vercel.app/assets/og-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LexiQuest Alpha · Pare de Traduzir na Sua Cabeça" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://landing-pi-jade-44.vercel.app/assets/og-card.png" />
  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#1f1633] text-[#ffffff] selection:bg-[#c2ef4e] selection:text-[#1f1633]">
    <!-- Barra Superior Fixa (Header Simplificado em Linha Única) -->
    <header class="fixed top-0 inset-x-0 z-50 glass-panel border-b border-[#3b2c60] px-4 sm:px-8 py-3.5 flex items-center justify-between">
      <a href="#" class="flex items-center gap-2 hover:opacity-95 transition-opacity" aria-label="LexiQuest Home">
        <Logo size="sm" showBadge={true} />
      </a>

      <!-- 4 Links Essenciais (Sem Quebra de Linha) -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-xs lg:text-sm text-[#cfcfdb] font-medium">
        <a href="#metodo" class="hover:text-[#c2ef4e] transition-colors">Como Funciona</a>
        <a href="#quiz" class="hover:text-[#c2ef4e] transition-colors flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#c2ef4e] micro-pulse"></span>
          <span>Teste 2 Min</span>
        </a>
        <a href="#sobre" class="hover:text-[#c2ef4e] transition-colors">O Professor</a>
        <a href="#pricing" class="hover:text-[#c2ef4e] transition-colors">Turma Alpha</a>
        <a href="#faq" class="hover:text-[#c2ef4e] transition-colors">Dúvidas</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="#quiz"
          class="px-4 sm:px-5 py-2 rounded-full bg-[#c2ef4e] text-[#1f1633] text-xs sm:text-sm font-sans font-extrabold transition-all hover:bg-[#b0dc41] active:scale-95 shadow-sm shadow-[#c2ef4e]/20"
        >
          Fazer o Teste (Grátis)
        </a>
      </div>
    </header>

    <main class="flex-1 pb-16 sm:pb-0">
      <!-- Bloco 1: Hero com Proposta de Valor e Apresentação do Mentor -->
      <Hero />

      <!-- Bloco 2: A Dor do Lag dos 3 Segundos -->
      <Problem />

      <!-- Bloco 3: O Quiz Gamificado (Diagnóstico & Ponte WhatsApp) -->
      <QuizNivelamento />

      <!-- Bloco 4: O Método SPARK na Prática (15 min IA + 3x Gabe + Portal) -->
      <Solution />

      <!-- Bloco 5: Quem é o Professor Gabriel Lima (5 Anos de Ensino, All Net & Retorno) -->
      <AboutGabriel />

      <!-- Bloco 6: A Oferta Exclusiva da Turma Alpha (15 Vagas · R$ 197/mês) -->
      <Pricing />

      <!-- Bloco 7: FAQ Acessível & Remoção de Objeções -->
      <Faq />

      <!-- Chamada Final de Conversão -->
      <FinalCTA />
    </main>

    <!-- Barra Sticky para Mobile -->
    <StickyMobileCTA />

    <Footer />

    <!-- GSAP — expose globally for component is:inline scripts -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      (window as any).gsap = gsap;
      (window as any).ScrollTrigger = ScrollTrigger;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        ScrollTrigger.batch('[data-anim="fade-up"]:not([data-animated])', {
          onEnter: (els) => {
            gsap.to(els, {
              opacity: 1,
              y: 0,
              duration: 0.85,
              stagger: 0.1,
              ease: 'power3.out',
              onStart: () => els.forEach((el: Element) => el.setAttribute('data-animated', '1'))
            });
          },
          start: 'top 85%',
        });

        ScrollTrigger.batch('[data-anim="scale-in"]:not([data-animated])', {
          onEnter: (els) => {
            gsap.to(els, {
              opacity: 1,
              scale: 1,
              duration: 0.85,
              stagger: 0.1,
              ease: 'power3.out',
              onStart: () => els.forEach((el: Element) => el.setAttribute('data-animated', '1'))
            });
          },
          start: 'top 85%',
        });

        ScrollTrigger.batch('[data-anim="fade-in"]:not([data-animated])', {
          onEnter: (els) => {
            gsap.to(els, {
              opacity: 1,
              duration: 0.85,
              stagger: 0.1,
              ease: 'power2.out',
              onStart: () => els.forEach((el: Element) => el.setAttribute('data-animated', '1'))
            });
          },
          start: 'top 85%',
        });
      }

      // Safety fallback: ensure nothing stays hidden under any circumstances
      setTimeout(() => {
        document.querySelectorAll('[data-anim]:not([data-animated])').forEach((el) => {
          (el as HTMLElement).style.opacity = '1';
          (el as HTMLElement).style.transform = 'none';
        });
      }, 1500);
    </script>
  </body>
</html>
